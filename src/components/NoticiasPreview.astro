---
import { Image } from 'astro:assets';
import SectionTag from "./UI/SectionTag.astro";
import { ROUTES } from "src/data/routes";
import NoticiaCard from "./NoticiaCard.astro";
import { getCollection } from "astro:content";

const todasLasNoticias = await getCollection("noticias");
const noticiasOrdenadas = todasLasNoticias.sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);


// Obtener las 3 más recientes
const ultimasNoticias = noticiasOrdenadas.slice(0, 3);
---

<section class="py-24 bg-slate-50 relative overflow-hidden">
    
    

    <div class="max-w-7xl mx-auto px-4 relative z-10 grid lg:grid-cols-12 gap-8">
        
        <!-- Header content - left column on lg, centered on mobile/tablet -->
        <div class="text-center mb-16 lg:mb-0 lg:text-left lg:col-span-4 lg:items-start lg:flex lg:flex-col">
            
            <div class="flex justify-center mb-6 lg:justify-start">
                <SectionTag text="Mantente Informado">
                    <svg slot="icon" class="w-4 h-4 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                </SectionTag>
            </div>

            <h2 class="text-3xl md:text-5xl font-black text-slate-900 mb-6 tracking-tight uppercase tracking-tighter relative inline-block">
                Actualidad <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-500 to-blue-600">ADADET</span>
                <span class="absolute -bottom-2 left-0 w-16 h-1.5 bg-cyan-500 mt-4"></span>
            </h2>

            <p class="text-slate-600 max-w-2xl mx-auto text-lg leading-relaxed lg:mx-0 lg:max-w-none">
                Resultados, comunicados oficiales y todo lo que acontece en los deportes acuáticos del Táchira.
            </p>

            <div class="mt-10 lg:mt-8">
                <a 
                    href="/noticias" 
                    class="group inline-flex items-center justify-center gap-2 px-8 py-4 bg-white border border-slate-200 text-slate-700 font-bold rounded-full hover:bg-slate-900 hover:text-white hover:border-slate-900 transition-all duration-300 shadow-lg shadow-slate-200/50 hover:shadow-xl hover:shadow-slate-900/20"
                >
                    Visitar Sala de Prensa
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                    </svg>
                </a>
            </div>
        </div>

        <!-- News cards - right column on lg -->
        <div class="lg:col-span-8">
            <div class="grid md:grid-cols-3 gap-8">
                {ultimasNoticias.map((news, index) => {
                    return (<NoticiaCard news={news} key={index} />)
                })}
            </div>
        </div>

    </div>
</section>