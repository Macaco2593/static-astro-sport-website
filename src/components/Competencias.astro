                {/* Card Header with gradient */}
                <div class="relative h-32 bg-gradient-to-br from-blue-600 via-cyan-600 to-blue-700 overflow-hidden">
                  {/* Animated wave pattern */}
                  <div class="absolute inset-0 opacity-20">
                    <svg class="absolute bottom-0 w-full h-20" viewBox="0 0 1200 120" preserveAspectRatio="none">
                      <path d="M0,0 C150,100 350,0 600,50 C850,100 1050,0 1200,50 L1200,120 L0,120 Z" fill="white" class="animate-wave"></path>
                    </svg>
                  </div>
                  
                  {/* Swimming icon */}
                  <div class="absolute top-4 right-4 w-12 h-12 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M2 17s1.5-2 3.5-2 3.5 2 5.5 2 3.5-2 5.5-2 3.5 2 3.5 2m-17 2s1.5-2 3.5-2 3.5 2 5.5 2 3.5-2 5.5-2 3.5 2 3.5 2M7 7a2 2 0 100-4 2 2 0 000 4zm13 3l-4-1 1-3-2.5.5L13 9l-1.5-2L9 7.5 10 10l-4 1 1 3h12l1-4z"/>
                    </svg>
                  </div>

                  {/* Results count badge */}
                  <div class="absolute bottom-4 left-4">
                    <div class="inline-flex items-center gap-2 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full text-sm font-semibold text-blue-700">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"></path>
                        <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"></path>
                      </svg>
