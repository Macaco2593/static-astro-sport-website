                {/* Hover overlay effect */}
                <div class="absolute inset-0 bg-gradient-to-t from-blue-600/0 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
              </a>
            ))}
          </div>
        </section>
