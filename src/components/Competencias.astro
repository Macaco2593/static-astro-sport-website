---
// CompetenciasSection.astro
import { ListaCompetencias } from '../data/listaCompetencias'; // Ajusta el path
import { ROUTES } from '../data/routes';

// Función para extraer el slug
const getSlug = (linkCompleto: string) => {
  return linkCompleto.replace('/competencias_pdf/', '');
};

// Función para formatear fecha
const formatDate = (fecha: string) => {
  const [day, month, year] = fecha.split('/');
  const months = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
  return `${day} ${months[parseInt(month) - 1]}`;
};

// Agrupar competencias por tipo
const competenciasEstadales = ListaCompetencias.filter((c) => c.tipo === 'estadal');
const competenciasRegionales = ListaCompetencias.filter((c) => c.tipo === 'regional');
const competenciasNacionales = ListaCompetencias.filter((c) => c.tipo === 'nacional');
---

<section class="relative py-10 md:py-16 bg-[#f2f2f5] overflow-hidden">
  <!-- Background decorative elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-20 -left-20 w-72 h-72 bg-blue-300/20 rounded-full blur-3xl animate-blob"></div>
    <div class="absolute top-40 -right-20 w-96 h-96 bg-cyan-300/20 rounded-full blur-3xl animate-blob animation-delay-2000"></div>
    <div class="absolute -bottom-20 left-1/2 w-80 h-80 bg-blue-400/20 rounded-full blur-3xl animate-blob animation-delay-4000"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16 animate-fade-in-down">
      <div class="inline-flex items-center gap-2 bg-blue-100 text-blue-700 px-4 py-2 rounded-full text-sm font-semibold mb-4">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"></path>
          <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"></path>
        </svg>
        Competencias
      </div>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-4">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-600">Competencias</span>
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto">
        Consulta toda la información, documentación y resultados de nuestros eventos
      </p>
    </div>

    <!-- Competitions by type -->
    <div class="space-y-12 md:space-y-16">
      {competenciasEstadales.length > 0 && (
        <section>
          <div class="flex items-center gap-3 mb-6">
            <div class="h-1 w-12 bg-gradient-to-r from-cyan-600 to-blue-600 rounded-full"></div>
            <h3 class="text-2xl md:text-3xl font-bold text-gray-900">Competencias Estadales</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            {competenciasEstadales.map((competencia, index) => (
              <a 
                href={ROUTES.RESULTADOS_SLUG(getSlug(competencia.linkDeLaCompetencia))}
                class="group relative bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 overflow-hidden border border-gray-100 hover:border-blue-300 animate-fade-in-up"
                style={`animation-delay: ${index * 150}ms`}
