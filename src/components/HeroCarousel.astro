---
import { ROUTES } from '../data/routes.ts';
import { DOCUMENTOS_SLUG } from '../data/documentos.ts';
import { Image } from 'astro:assets';
import WaveDivider from './UI/WaveDivider.astro';
import adadetLogo from 'src/assets/adadet-logo2.png';
import pool from 'src/assets/heroCarousel/pool.jpg';
import poolCompetition from 'src/assets/heroCarousel/pool-competition.jpg';
import podio from 'src/assets/heroCarousel/podio.jpg';

const slides = [
  {
    id: 1,
    image: pool,
    title: "ADADET 2026",
    subtitle: "100% Pasión Acuática",
    ctaText: "Normativa de Fichaje",
    ctaLink: ROUTES.documento(DOCUMENTOS_SLUG.NORMATIVA_FICHAJE_2026),
    gradient: "from-blue-900/90 to-adadet-main/80",
    logo: adadetLogo
  },
  {
    id: 2,
    image: poolCompetition,
    title: "Competencias 2026",
    subtitle: "Consulta el calendario oficial de eventos",
    ctaText: "Ver Calendario",
    ctaLink: ROUTES.CALENDARIO,
    gradient: "from-adadet-dark/90 to-cyan-600/80"
  },
  {
    id: 3,
    image: podio,
    title: "Rankings Estadales",
    subtitle: "Las mejores marcas de nuestros atletas",
    ctaText: "Ver Rankings",
    ctaLink: ROUTES.RANKING,
    gradient: "from-slate-900/90 to-blue-600/80"
  }
];
---

<section class="relative w-full h-[500px] lg:h-[600px] overflow-hidden bg-slate-900 group" aria-label="Carrusel Principal">
  
  <div id="slides-container" class="relative w-full h-full">
    {slides.map((slide, index) => (
      <div 
        class={`slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
        data-index={index}
      >
        <div class="absolute inset-0 overflow-hidden">
             <Image 
                src={slide.image} 
                alt={slide.title}
                class="w-full h-full object-cover transform scale-100 transition-transform duration-[10s] ease-linear ken-burns-target"
                loading={index === 0 ? "eager" : "lazy"} 
             />
        </div>

        <div class={`absolute inset-0 bg-gradient-to-r ${slide.gradient} mix-blend-multiply`}></div>
        <div class="absolute inset-0 bg-black/20"></div> 

        <div class="relative z-20 flex flex-col items-center justify-center h-full text-center text-white px-4 max-w-5xl mx-auto pb-16"> 
            {slide.logo && (
                <Image 
                    src={slide.logo} 
                    alt="Logo Evento" 
                    class="w-40 h-auto mb-8 object-contain animate-fade-in-down drop-shadow-[0_4px_4px_rgba(0,0,0,0.5)]"
                />
            )}

            <h1 class="text-4xl md:text-7xl font-black font-display mb-4 tracking-tight drop-shadow-lg animate-slide-up opacity-0" style="animation-delay: 200ms;">
                {slide.title}
            </h1>
            
            <p class="text-xl md:text-3xl font-medium text-slate-100 mb-10 drop-shadow-md animate-slide-up opacity-0" style="animation-delay: 400ms;">
                {slide.subtitle}
            </p>
            
            <a 
                href={slide.ctaLink} 
                class="group/btn relative inline-flex items-center justify-center gap-2 px-8 py-4 bg-white text-adadet-dark font-bold rounded-full overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-[0_0_40px_-10px_rgba(255,255,255,0.5)] animate-slide-up opacity-0 shadow-xl"
                style="animation-delay: 600ms;"
            >
                <span class="absolute inset-0 w-full h-full bg-adadet-main transform scale-x-0 group-hover/btn:scale-x-100 transition-transform duration-300 origin-left"></span>
                <span class="relative group-hover/btn:text-white transition-colors duration-300 flex items-center gap-2">
                    {slide.ctaText}
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </span>
            </a>
        </div>
      </div>
    ))}
  </div>

  <button id="prevSlide" class="absolute left-4 top-1/2 -translate-y-1/2 z-30 p-3 rounded-full border border-white/30 text-white bg-black/20 backdrop-blur-md hover:bg-adadet-main hover:border-adadet-main transition-all duration-300 -translate-x-20 group-hover:translate-x-0 opacity-0 group-hover:opacity-100" aria-label="Anterior">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
  </button>
  
  <button id="nextSlide" class="absolute right-4 top-1/2 -translate-y-1/2 z-30 p-3 rounded-full border border-white/30 text-white bg-black/20 backdrop-blur-md hover:bg-adadet-main hover:border-adadet-main transition-all duration-300 translate-x-20 group-hover:translate-x-0 opacity-0 group-hover:opacity-100" aria-label="Siguiente">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
  </button>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-30 flex gap-3">
    {slides.map((_, i) => (
      <button 
        class="dot w-12 h-1.5 rounded-full bg-white/30 transition-all duration-300 hover:bg-white/60" 
        data-index={i}
        aria-label={`Ir a diapositiva ${i + 1}`}
      ></button>
    ))}
  </div>

  <WaveDivider fillColor="#F8FAFC" />

</section>

<script>
  function initCarousel() {
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    const imgs = document.querySelectorAll('.ken-burns-target');
    const prevBtn = document.getElementById('prevSlide');
    const nextBtn = document.getElementById('nextSlide');
    
    // SEGURIDAD: Si no hay slides, no ejecutamos nada (evita errores en otras páginas)
    if (slides.length === 0) return;

    let currentSlide = 0;
    let totalSlides = slides.length;
    let autoPlayInterval: ReturnType<typeof setInterval>;

    function resetAnimations(slideIndex: number) {
        const contentElements = slides[slideIndex].querySelectorAll('.animate-slide-up, .animate-fade-in-down');
        contentElements.forEach((el) => {
            const element = el as HTMLElement;
            element.style.animationName = 'none';
            void element.offsetWidth; 
            element.style.animationName = ''; 
        });

        const img = imgs[slideIndex] as HTMLElement;
        if (img) {
            img.classList.remove('scale-110');
            img.classList.add('scale-100');
            setTimeout(() => {
                img.classList.remove('scale-100');
                img.classList.add('scale-110');
            }, 50);
        }
    }

    function showSlide(index: number) {
      if (index >= totalSlides) index = 0;
      if (index < 0) index = totalSlides - 1;

      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.remove('opacity-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'z-10');
          resetAnimations(i);
        } else {
          slide.classList.add('opacity-0', 'pointer-events-none');
          slide.classList.remove('opacity-100', 'z-10');
        }
      });

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.remove('bg-white/30', 'w-12');
          dot.classList.add('bg-adadet-main', 'w-16');
        } else {
          dot.classList.add('bg-white/30', 'w-12');
          dot.classList.remove('bg-adadet-main', 'w-16');
        }
      });

      currentSlide = index;
    }

    const next = () => showSlide(currentSlide + 1);
    const prev = () => showSlide(currentSlide - 1);

    nextBtn?.addEventListener('click', () => { next(); resetTimer(); });
    prevBtn?.addEventListener('click', () => { prev(); resetTimer(); });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { showSlide(i); resetTimer(); });
    });

    function startTimer() {
        // Limpiamos cualquier intervalo previo por seguridad antes de empezar uno nuevo
        clearInterval(autoPlayInterval);
        autoPlayInterval = setInterval(next, 6000);
    }
    
    function resetTimer() {
        startTimer();
    }

    // Inicializar estado visual
    showSlide(0);
    startTimer();

    // LIMPIEZA: Cuando el usuario se va de la página, matamos el intervalo
    // para que no siga corriendo "en el limbo" durante la navegación
    document.addEventListener('astro:before-preparation', () => {
      clearInterval(autoPlayInterval);
    }, { once: true });
  }

  // EL ÚNICO DISPARADOR NECESARIO
  document.addEventListener('astro:page-load', initCarousel);
</script>

<style>
  @keyframes slide-up-fade {
    0% { opacity: 0; transform: translateY(40px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .animate-slide-up {
    animation: slide-up-fade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  .animate-fade-in-down {
     animation: slide-up-fade 0.8s cubic-bezier(0.16, 1, 0.3, 1) reverse forwards;
  }
</style>