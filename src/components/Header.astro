---
import { ROUTES } from '../data/routes';
import { DOCUMENTOS_SLUG } from '../data/documentos';
import { Image } from 'astro:assets';
import adadetLogo from '../../public/adadet-logo.svg';

// Datos de navegación (Sin cambios aquí)
const navLinks = [
  { label: "Ranking", href: ROUTES.RANKING },
  { label: "Resultados", href: ROUTES.RESULTADOS },
  { label: "Calendario", href: ROUTES.CALENDARIO },
  { label: "Colaboradores", href: ROUTES.COLABORADORES },
  { label: "Contacto", href: ROUTES.CONTACTO },
];
---

<header class="fixed top-0 left-0 right-0 z-101 transition-all duration-300 bg-white/90 backdrop-blur-md border-b border-slate-200/60 supports-[backdrop-filter]:bg-white/60 h-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-full">
    <div class="flex h-full items-center justify-between gap-4">
      
      <div class="flex-shrink-0">
        <a href="/" class="group flex items-center gap-3 focus:outline-none" aria-label="Ir al inicio">
          <div class="relative h-12 w-auto flex items-center justify-center transition-transform duration-300 group-hover:scale-105">
          <Image 
              src={adadetLogo} 
              alt="Logo ADADET" 
              class="h-full w-auto object-contain drop-shadow-sm transition-all duration-300 group-hover:drop-shadow-md" 
              loading="eager"
          />
      </div>
          <div class="hidden sm:block">
            <p class="text-lg font-black font-display text-slate-900 leading-none group-hover:text-adadet-main transition-colors">ADADET</p>
            <p class="text-[10px] font-bold uppercase tracking-widest text-slate-500">Táchira</p>
          </div>
        </a>
      </div>

      <nav class="hidden md:flex items-center gap-1">
        <div class="relative group px-1">
            <button class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full text-sm font-bold text-slate-600 transition-all duration-200 hover:text-adadet-main hover:bg-slate-50 group-hover:text-adadet-main group-hover:bg-slate-50 focus:outline-none">
                <span>ADADET</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:-rotate-180 text-slate-400 group-hover:text-adadet-main" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
            </button>

            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 invisible translate-y-2 transition-all duration-200 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 w-72">
                <div class="overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-slate-900/5 p-2">
                    <div class="px-3 py-2 border-b border-slate-50 mb-1">
                        <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Sobre Nosotros</p>
                    </div>
                    
                    <a href={ROUTES.documento(DOCUMENTOS_SLUG.NORMATIVA_FICHAJE_2026)} class="flex items-start gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors group/item">
                        <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center group-hover/item:bg-blue-600 group-hover/item:text-white transition-colors">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 011.414.586l4 4a1 1 0 01.586 1.414V19a2 2 0 01-2 2z" /></svg>
                        </div>
                        <div>
                            <p class="text-sm font-bold text-slate-900 group-hover/item:text-blue-600">Normativa 2026</p>
                            <p class="text-xs text-slate-500">Reglamento de fichaje</p>
                        </div>
                    </a>

                    <a href={ROUTES.documento(DOCUMENTOS_SLUG.RECONOCIMIENTO_IDT)} class="flex items-start gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors group/item">
                        <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover/item:bg-emerald-600 group-hover/item:text-white transition-colors">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        </div>
                        <div>
                            <p class="text-sm font-bold text-slate-900 group-hover/item:text-emerald-600">Reconocimiento IDT</p>
                            <p class="text-xs text-slate-500">Aval oficial del deporte</p>
                        </div>
                    </a>

                    <a href={ROUTES.QUIENES_SOMOS} class="flex items-start gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors group/item">
                        <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center group-hover/item:bg-amber-600 group-hover/item:text-white transition-colors">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                        </div>
                        <div>
                            <p class="text-sm font-bold text-slate-900 group-hover/item:text-amber-600">¿Quiénes Somos?</p>
                            <p class="text-xs text-slate-500">Nuestra historia y misión</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        {navLinks.map(link => (
             <a 
                href={link.href} 
                class="px-3 py-2 rounded-full text-sm font-bold text-slate-600 transition-all duration-200 hover:text-adadet-main hover:bg-slate-50"
             >
                {link.label}
             </a>
        ))}
      </nav>

      <div class="flex md:hidden items-center">
        <button
          id="mobile-menu-button" 
          type="button"
          class="inline-flex items-center justify-center rounded-xl p-2.5 text-slate-700 transition hover:bg-slate-100 hover:text-adadet-main focus:outline-none active:bg-slate-200"
          aria-controls="mobile-menu" 
          aria-expanded="false"
        >
          <span class="sr-only">Abrir menú principal</span>
          <svg class="h-6 w-6 block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
             <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white absolute top-20 left-0 right-0 h-[calc(100vh-5rem)] overflow-y-auto z-40">
    <div class="flex flex-col px-4 pb-6 pt-8 space-y-6 bg-slate-50/50 min-h-full">
      
      <div class="bg-white rounded-2xl p-2 shadow-sm ring-1 ring-slate-100">
        <p class="px-3 py-2 text-xs font-black uppercase tracking-widest text-adadet-main border-b border-slate-50 mb-1">
            Institucional
        </p>
        
        <a href={ROUTES.documento(DOCUMENTOS_SLUG.NORMATIVA_FICHAJE_2026)} class="flex items-center gap-3 rounded-xl px-3 py-3 text-slate-700 hover:bg-blue-50 transition-colors group">
            <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 011.414.586l4 4a1 1 0 01.586 1.414V19a2 2 0 01-2 2z" /></svg>
            </div>
            <span class="font-bold">Normativa 2026</span>
        </a>
        <a href={ROUTES.documento(DOCUMENTOS_SLUG.RECONOCIMIENTO_IDT)} class="flex items-center gap-3 rounded-xl px-3 py-3 text-slate-700 hover:bg-emerald-50 transition-colors group">
             <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                 <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
             </div>
            <span class="font-bold">Reconocimiento IDT</span>
        </a>
        <a href={ROUTES.QUIENES_SOMOS} class="flex items-center gap-3 rounded-xl px-3 py-3 text-slate-700 hover:bg-amber-50 transition-colors group">
             <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center group-hover:bg-amber-600 group-hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
             </div>
            <span class="font-bold">¿Quiénes Somos?</span>
        </a>
      </div>
      
      <div class="bg-white rounded-2xl p-2 shadow-sm ring-1 ring-slate-100">
        <p class="px-3 py-2 text-xs font-black uppercase tracking-widest text-adadet-main border-b border-slate-50 mb-1">
            Navegación Principal
        </p>
        
        <a href={ROUTES.RANKING} class="flex items-center gap-3 rounded-xl px-3 py-3 text-slate-700 hover:bg-slate-50 hover:text-adadet-main transition-colors group">
            <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center group-hover:bg-adadet-main group-hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
            </div>
            <span class="font-bold text-lg">Ranking</span>
        </a>
        
        <a href={ROUTES.RESULTADOS} class="flex items-center gap-3 rounded-xl px-3 py-3 text-slate-700 hover:bg-slate-50 hover:text-adadet-main transition-colors group">
            <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center group-hover:bg-adadet-main group-hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" /></svg>
            </div>
            <span class="font-bold text-lg">Resultados</span>
        </a>

        <a href={ROUTES.CALENDARIO} class="flex items-center gap-3 rounded-xl px-3 py-3 text-slate-700 hover:bg-slate-50 hover:text-adadet-main transition-colors group">
            <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center group-hover:bg-adadet-main group-hover:text-white transition-colors">
               <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </div>
            <span class="font-bold text-lg">Calendario</span>
        </a>
        
        <a href={ROUTES.COLABORADORES} class="flex items-center gap-3 rounded-xl px-3 py-3 text-slate-700 hover:bg-slate-50 hover:text-adadet-main transition-colors group">
             <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center group-hover:bg-adadet-main group-hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
             </div>
            <span class="font-bold text-lg">Colaboradores</span>
        </a>

        <a href={ROUTES.CONTACTO} class="flex items-center gap-3 rounded-xl px-3 py-3 text-slate-700 hover:bg-slate-50 hover:text-adadet-main transition-colors group">
             <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-slate-100 text-slate-500 flex items-center justify-center group-hover:bg-adadet-main group-hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
             </div>
            <span class="font-bold text-lg">Contacto</span>
        </a>
      </div>

    </div>
  </div>
</header>

<script>
document.addEventListener('astro:page-load', () => {
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const icons = btn?.querySelectorAll('svg');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    icons?.forEach(icon => icon.classList.toggle('hidden'));
    icons?.forEach(icon => icon.classList.toggle('block'));
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
    document.body.classList.toggle('overflow-hidden');
  });

  menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
        if(icons) {
            icons[0].classList.remove('hidden');
            icons[0].classList.add('block');
            icons[1].classList.add('hidden');
            icons[1].classList.remove('block');
        }
      });
  });
});
</script>