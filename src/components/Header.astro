---
import logoAdadet from '../assets/logoAdadet.svg';
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="container mx-auto px-4 py-4 flex items-center justify-between gap-4">
    <!-- Logo -->
    <div class="flex items-center">
      <a href="/" class="flex items-center">
        <img src={logoAdadet.src} alt="FEVEDA Logo" class="h-16 w-16 rounded-full object-cover" />
      </a>
    </div>

    <!-- Navigation Menu -->

    <nav class="hidden md:flex items-center space-x-8 flex-1 justify-center">
      <!-- ADADET Dropdown -->
      <div class="relative group">
        <button
          class="inline-flex items-center gap-2 py-2 text-lg font-semibold text-gray-900  transition-all duration-200 hover:bg-white hover:text-blue-600  hover:ring-blue-200"
        >
          <span> <a href="/">ADADET</a></span>
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </button>
        <!-- Dropdown menu -->
        <div
          class="invisible absolute left-1/2 z-50 mt-3 w-64 -translate-x-1/2 translate-y-1 opacity-0 rounded-2xl bg-white/95 p-2 shadow-xl ring-1 ring-slate-200/80 transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100"
        >
          <div class="px-3 py-2">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
              Sobre ADADET
            </p>
          </div>
          <div class="space-y-1 text-sm">
            <a
              href="/documentos/normativa-fichaje-2026"
              class="flex items-start gap-3 rounded-xl px-3 py-2 text-slate-700 transition-colors hover:bg-blue-50 hover:text-blue-700"
            >
              <span class="mt-1 h-2 w-2 rounded-full bg-blue-500"></span>
              <span>Normativa del fichaje 2026</span>
            </a>
            <a
              href="/documentos/organigrama-asociacion"
              class="flex items-start gap-3 rounded-xl px-3 py-2 text-slate-700 transition-colors hover:bg-blue-50 hover:text-blue-700"
            >
              <span class="mt-1 h-2 w-2 rounded-full bg-cyan-500"></span>
              <span>Organigrama de la asociación</span>
            </a>
            <a
              href="/documentos/reconocimiento-idt"
              class="flex items-start gap-3 rounded-xl px-3 py-2 text-slate-700 transition-colors hover:bg-blue-50 hover:text-blue-700"
            >
              <span class="mt-1 h-2 w-2 rounded-full bg-emerald-500"></span>
              <span>Reconocimiento del IDT</span>
            </a>
            <a
              href="/"
              class="flex items-start gap-3 rounded-xl px-3 py-2 text-slate-700 transition-colors hover:bg-blue-50 hover:text-blue-700"
            >
              <span class="mt-1 h-2 w-2 rounded-full bg-amber-500"></span>
              <span>Organigrama de la Asociación</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Ranking -->
      <a href="/ranking" class="text-gray-900 hover:text-blue-600 font-medium text-lg transition-colors">
        Ranking
      </a>

      <!-- Resultados -->
      <a href="/resultados" class="text-gray-900 hover:text-blue-600 font-medium text-lg transition-colors">
        Resultados
      </a>

      <!-- Calendario -->
      <a href="/calendario" class="text-gray-900 hover:text-blue-600 font-medium text-lg transition-colors">
        Calendario
      </a>
      
      <!-- Colaboradores -->
      <a href="/colaboradores" class="text-gray-900 hover:text-blue-600 font-medium text-lg transition-colors">
        Colaboradores
      </a>

      <!-- Contacto y Denuncia -->
      <a href="/contacto" class="text-gray-900 hover:text-blue-600 font-medium text-lg transition-colors">
        Contacto y Denuncia
      </a>
    </nav>

    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-button"
      class="md:hidden inline-flex items-center justify-center rounded-md p-2 text-gray-900 hover:text-blue-600 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-white"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      type="button"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile navigation -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-gray-200 bg-white shadow-sm">
    <nav class="px-4 pt-3 pb-4 space-y-2 text-sm">
      <a
        href="/"
        class="block rounded-lg px-3 py-2 font-medium text-gray-900 hover:bg-gray-100 hover:text-blue-700"
      >
        Inicio
      </a>

      <div class="space-y-1">
        <p class="px-3 text-xs font-semibold uppercase tracking-wide text-slate-500">
          ADADET
        </p>
        <a
          href="/"
          class="block rounded-lg px-3 py-2 font-medium text-gray-900 hover:bg-gray-100 hover:text-blue-700"
        >
          Página principal ADADET
        </a>
        <div class="space-y-1 pl-4">
          <a
            href="/documentos/normativa-fichaje-2026"
            class="block rounded-lg px-3 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-700"
          >
            Normativa del fichaje 2026
          </a>
          <a
            href="/documentos/organigrama-asociacion"
            class="block rounded-lg px-3 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-700"
          >
            Organigrama de la asociación
          </a>
          <a
            href="/documentos/reconocimiento-idt"
            class="block rounded-lg px-3 py-2 text-slate-700 hover:bg-blue-50 hover:text-blue-700"
          >
            Reconocimiento del IDT
          </a>
        </div>
      </div>

      <a
        href="/ranking"
        class="block rounded-lg px-3 py-2 font-medium text-gray-900 hover:bg-gray-100 hover:text-blue-700"
      >
        Ranking
      </a>
      <a
        href="/resultados"
        class="block rounded-lg px-3 py-2 font-medium text-gray-900 hover:bg-gray-100 hover:text-blue-700"
      >
        Resultados
      </a>
      <a
        href="/contacto"
        class="block rounded-lg px-3 py-2 font-medium text-gray-900 hover:bg-gray-100 hover:text-blue-700"
      >
        Contacto y denuncia
      </a>
      <a
        href="/colaboradores"
        class="block rounded-lg px-3 py-2 font-medium text-gray-900 hover:bg-gray-100 hover:text-blue-700"
      >
        Colaboradores
      </a>
    </nav>
  </div>
</header>

<script>
  const mobileButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileButton?.addEventListener('click', () => {
    if (!mobileMenu) return;
    const isHidden = mobileMenu.classList.contains('hidden');
    if (isHidden) {
      mobileMenu.classList.remove('hidden');
      mobileButton.setAttribute('aria-expanded', 'true');
    } else {
      mobileMenu.classList.add('hidden');
      mobileButton.setAttribute('aria-expanded', 'false');
    }
  });
</script>
