---
// src/components/Calendar.astro
interface Props {
  events?: { 
    date: string; 
    title: string; 
    type: string; 
    description?: string; 
    time?: string;        
  }[];
}

const { events = [] } = Astro.props;
---

<div class="calendar-component w-full mx-auto bg-white shadow-2xl shadow-slate-200/50 rounded-3xl overflow-hidden border border-slate-100 ring-1 ring-slate-900/5">
  
  <div class="px-6 py-6 flex flex-col sm:flex-row justify-between items-center gap-4 bg-white border-b border-slate-100">
    
    <div class="flex items-center gap-4 order-2 sm:order-1">
        <button id="prevMonth" class="group p-2 rounded-full hover:bg-slate-50 border border-slate-200 hover:border-adadet-main/30 transition-all active:scale-95">
          <svg class="w-5 h-5 text-slate-500 group-hover:text-adadet-main" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <button id="nextMonth" class="group p-2 rounded-full hover:bg-slate-50 border border-slate-200 hover:border-adadet-main/30 transition-all active:scale-95">
          <svg class="w-5 h-5 text-slate-500 group-hover:text-adadet-main" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
    </div>
    
    <h2 id="currentMonthYear" class="order-1 sm:order-2 text-2xl md:text-3xl font-black font-display text-slate-800 capitalize tracking-tight">
      </h2>

  </div>

  <div class="grid grid-cols-7 bg-slate-50/50 border-b border-slate-100">
    {['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'].map((day) => (
      <div class="py-3 text-center text-xs font-bold text-slate-400 uppercase tracking-widest">
        {day}
      </div>
    ))}
  </div>

  <div id="calendarGrid" class="grid grid-cols-7 auto-rows-fr bg-slate-100 gap-px border-b border-slate-100">
     </div>
</div>

<div id="eventModal" class="fixed inset-0 z-[60] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity opacity-0" id="modalBackdrop"></div>

  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
      
      <div id="modalPanel" class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg scale-95 opacity-0">
        
        <div class="bg-gradient-to-r from-blue-600 to-cyan-500 px-4 py-6 sm:px-6">
            <div class="flex items-center justify-between">
                <h3 class="text-xl font-bold leading-6 text-white" id="modalDate"></h3>
                <button type="button" id="closeModalBtnHeader" class="text-white/80 hover:text-white transition-colors">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
        </div>
        
        <div class="px-4 pb-4 pt-5 sm:p-6">
          <div class="space-y-4" id="modalEventsList">
             </div>
        </div>
        
        <div class="bg-slate-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 border-t border-slate-100">
          <button type="button" id="closeModalBtn" class="inline-flex w-full justify-center rounded-xl bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 sm:mt-0 sm:w-auto transition-all">
            Cerrar
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ events }}>

  document.addEventListener('astro:page-load', () => {

  const grid = document.getElementById('calendarGrid');
  if (!grid) return;
  // Variables globales
  let currDate = new Date();
  let currYear = currDate.getFullYear();
  let currMonth = currDate.getMonth();
  
  const monthNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];

  const monthTitle = document.getElementById('currentMonthYear');
  
  // Elementos del Modal
  const modal = document.getElementById('eventModal');
  const modalBackdrop = document.getElementById('modalBackdrop');
  const modalPanel = document.getElementById('modalPanel');
  const modalDate = document.getElementById('modalDate');
  const modalList = document.getElementById('modalEventsList');

  // --- RENDER FUNCTION ---
  function renderCalendar() {
    grid.innerHTML = "";
    monthTitle.innerText = `${monthNames[currMonth]} ${currYear}`;

    const firstDay = new Date(currYear, currMonth, 1).getDay();
    const lastDate = new Date(currYear, currMonth + 1, 0).getDate();
    const today = new Date();

    // 1. Días vacíos del mes anterior
    for (let i = 0; i < firstDay; i++) {
      const emptyDiv = document.createElement('div');
      emptyDiv.className = "min-h-[100px] bg-slate-50/30"; // Fondo sutil
      grid.appendChild(emptyDiv);
    }

    // 2. Días del mes actual
    for (let i = 1; i <= lastDate; i++) {
      const dateStr = `${currYear}-${String(currMonth + 1).padStart(2, '0')}-${String(i).padStart(2, '0')}`;
      const dayEvents = events.filter(e => e.date === dateStr);
      
      const isToday = i === today.getDate() && currMonth === today.getMonth() && currYear === today.getFullYear();

      const dayDiv = document.createElement('div');
      // Clases dinámicas para el día:
      // - hover:z-10 para que al pasar el mouse se superponga si hay sombras
      dayDiv.className = `min-h-[100px] sm:min-h-[120px] bg-white p-2 relative group hover:bg-blue-50/30 transition-colors cursor-pointer border-r border-b border-transparent hover:border-blue-100 ${isToday ? 'bg-blue-50/50' : ''}`;
      
      dayDiv.onclick = () => openModal(dateStr, dayEvents);

      // HTML Interno del Día
      dayDiv.innerHTML = `
        <div class="flex justify-between items-start">
            <span class="text-sm font-semibold w-7 h-7 flex items-center justify-center rounded-full ${isToday ? 'bg-adadet-main text-white shadow-md shadow-adadet-main/30' : 'text-slate-500 group-hover:text-adadet-main'}">
            ${i}
            </span>
            ${dayEvents.length > 0 ? `<span class="flex h-2 w-2 rounded-full bg-adadet-main sm:hidden"></span>` : ''} 
        </div>
        
        <div class="mt-2 space-y-1.5 overflow-hidden">
          ${dayEvents.slice(0, 3).map(e => `
            <div class="hidden sm:block text-[10px] font-medium px-2 py-1 rounded-md bg-white border border-slate-100 shadow-sm text-slate-600 truncate hover:text-adadet-main hover:border-adadet-main/30 transition-colors border-l-2 border-l-adadet-main">
              ${e.title}
            </div>
          `).join('')}
          ${dayEvents.length > 3 ? `<div class="hidden sm:block text-[10px] text-slate-400 pl-1">+${dayEvents.length - 3} más</div>` : ''}
        </div>
      `;

      grid.appendChild(dayDiv);
    }
  }

  // --- MODAL LOGIC (Con animaciones) ---
  function openModal(dateStr, dayEvents) {
    const dateObj = new Date(dateStr + "T00:00:00");
    modalDate.innerText = dateObj.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
    
    if (dayEvents.length === 0) {
      modalList.innerHTML = `
        <div class="text-center py-8">
            <div class="w-12 h-12 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <p class="text-slate-500 font-medium">No hay eventos programados.</p>
        </div>
      `;
    } else {
      modalList.innerHTML = dayEvents.map(e => `
        <div class="group flex gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100 hover:bg-white hover:shadow-md hover:border-adadet-main/20 transition-all duration-300">
          <div class="flex-shrink-0 mt-1">
             <div class="w-10 h-10 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-adadet-main shadow-sm group-hover:bg-adadet-main group-hover:text-white transition-colors">
                ${getIconByType(e.type)}
             </div>
          </div>
          <div>
            <h4 class="font-bold text-slate-900 text-lg leading-tight mb-1">${e.title}</h4>
            ${e.time ? `<div class="flex items-center gap-1 text-xs font-bold text-adadet-main uppercase tracking-wider mb-2">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                ${e.time}
            </div>` : ''}
            ${e.description ? `<p class="text-sm text-slate-600 leading-relaxed">${e.description}</p>` : ''}
          </div>
        </div>
      `).join('');
    }

    modal.classList.remove('hidden');
    // Animación de entrada
    setTimeout(() => {
        modalBackdrop.classList.remove('opacity-0');
        modalPanel.classList.remove('scale-95', 'opacity-0');
        modalPanel.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function closeModal() {
    // Animación de salida
    modalBackdrop.classList.add('opacity-0');
    modalPanel.classList.remove('scale-100', 'opacity-100');
    modalPanel.classList.add('scale-95', 'opacity-0');
    
    setTimeout(() => {
        modal.classList.add('hidden');
    }, 300); // Esperar a que termine la transición
  }

  function getIconByType(type) {
    // Iconos simples basados en el tipo (puedes expandir esto)
    if(type === 'swimming') return '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';
    return '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>';
  }

  // Event Listeners
  document.getElementById('prevMonth').addEventListener('click', () => {
    currMonth--;
    if (currMonth < 0) { currMonth = 11; currYear--; }
    renderCalendar();
  });

  document.getElementById('nextMonth').addEventListener('click', () => {
    currMonth++;
    if (currMonth > 11) { currMonth = 0; currYear++; }
    renderCalendar();
  });

  document.getElementById('closeModalBtn').addEventListener('click', closeModal);
  document.getElementById('closeModalBtnHeader').addEventListener('click', closeModal);
  modalBackdrop.addEventListener('click', closeModal);

  renderCalendar();
});
</script>