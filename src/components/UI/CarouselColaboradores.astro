---
import { Image } from "astro:assets";
import { COLABORADORES } from "../../data/colaboradores"; 
---

<section class="relative py-16 bg-white overflow-hidden border-y border-slate-100 shadow-[0_0_40px_-15px_rgba(0,0,0,0.05)]">

    {/* --- GRADIENTE DE DESVANECIMIENTO IZQUIERDO --- */}
    <div class="absolute left-0 top-0 bottom-0 w-64 bg-gradient-to-r from-slate-50 via-slate-100/80 to-transparent z-20 pointer-events-none"></div>

    {/* --- GRADIENTE DE DESVANECIMIENTO DERECHO --- */}
    <div class="absolute right-0 top-0 bottom-0 w-64 bg-gradient-to-l from-slate-50 via-slate-100/80 to-transparent z-20 pointer-events-none"></div>

    {/* --- DECORACIÓN BORDE IZQUIERDO (BARRA DE COLOR) --- */}
    <div class="absolute left-0 top-0 bottom-0 w-2 md:w-3 bg-gradient-to-b from-cyan-500 to-blue-600 opacity-90 z-10"></div>

    {/* --- DECORACIÓN BORDE DERECHO (BARRA DE COLOR) --- */}
    <div class="absolute right-0 top-0 bottom-0 w-2 md:w-3 bg-gradient-to-b from-blue-600 to-cyan-500 opacity-90 z-10"></div>

    <div class="w-full px-4 md:px-8 lg:px-24 relative z-30 flex flex-col items-center justify-center">

        {/* --- SUBTÍTULO DIVISOR --- */}
        <div class="flex items-center justify-center w-full gap-4 md:gap-8 mb-10">
            <div class="h-px bg-slate-200 flex-1"></div>
            <h3 class="text-xs md:text-sm font-bold text-slate-400 uppercase tracking-[0.2em] whitespace-nowrap">
                Con el apoyo institucional de
            </h3>
            <div class="h-px bg-slate-200 flex-1"></div>
        </div>
        
        {/* --- CONTENEDOR ESTÁTICO DEL LOGO --- */}
        <div class="flex flex-wrap justify-center items-center gap-16 lg:gap-24">
            {COLABORADORES.map((colaborador) => (
                <div class="group flex flex-col items-center justify-center grayscale hover:grayscale-0 transition-all duration-500 opacity-70 hover:opacity-100">
                    
                    <Image 
                        src={colaborador.logo} 
                        alt={`Logo de ${colaborador.nombre}`} 
                        class="h-16 md:h-24 w-auto object-contain mb-4 drop-shadow-sm group-hover:drop-shadow-md transition-all duration-500"
                    />
                    
                    <span class="text-sm md:text-base font-bold text-slate-700 text-center max-w-[280px] leading-snug">
                        {colaborador.nombre}
                    </span>
                    
                    <span class="text-[10px] font-bold text-slate-400 mt-1 uppercase tracking-widest">
                        {colaborador.rol}
                    </span>
                    
                </div>
            ))}
        </div>

    </div>

</section>