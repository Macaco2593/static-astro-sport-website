---
import { Image } from "astro:assets";
import { COLABORADORES } from "../../data/colaboradores"; 
---

<section class="relative py-16 bg-white overflow-hidden border-y border-slate-100 shadow-[0_0_40px_-15px_rgba(0,0,0,0.05)]">

    {/* --- DECORACIÓN BORDE IZQUIERDO --- */}
    {/* La barra de color */}
    <div class="absolute left-0 top-0 bottom-0 w-2 md:w-3 bg-gradient-to-b from-cyan-500 to-blue-600 opacity-90 z-20"></div>
    {/* El Patrón SVG corregido */}
    <div class="absolute left-2 md:left-3 top-0 bottom-0 w-32 bg-[url('/grid-pattern.svg')] opacity-15 pointer-events-none z-10">
        {/* Capa blanca difuminada para borrar el patrón hacia el centro */}
        <div class="absolute inset-0 bg-gradient-to-r from-transparent to-white"></div>
    </div>

    {/* --- DECORACIÓN BORDE DERECHO --- */}
    {/* La barra de color */}
    <div class="absolute right-0 top-0 bottom-0 w-2 md:w-3 bg-gradient-to-b from-blue-600 to-cyan-500 opacity-90 z-20"></div>
    {/* El Patrón SVG corregido */}
    <div class="absolute right-2 md:right-3 top-0 bottom-0 w-32 bg-[url('/grid-pattern.svg')] opacity-15 pointer-events-none z-10">
        {/* Capa blanca difuminada para borrar el patrón hacia el centro */}
        <div class="absolute inset-0 bg-gradient-to-l from-transparent to-white"></div>
    </div>

    <div class="max-w-5xl mx-auto px-12 md:px-20 relative z-30 flex flex-col items-center justify-center">

        {/* --- SUBTÍTULO DIVISOR --- */}
        <div class="flex items-center justify-center w-full gap-4 md:gap-8 mb-10">
            <div class="h-px bg-slate-200 flex-1"></div>
            <h3 class="text-xs md:text-sm font-bold text-slate-400 uppercase tracking-[0.2em] whitespace-nowrap">
                Con el apoyo institucional de
            </h3>
            <div class="h-px bg-slate-200 flex-1"></div>
        </div>
        
        {/* --- CONTENEDOR ESTÁTICO DEL LOGO --- */}
        <div class="flex flex-wrap justify-center items-center gap-12">
            {COLABORADORES.map((colaborador) => (
                <div class="group flex flex-col items-center justify-center grayscale hover:grayscale-0 transition-all duration-500 opacity-70 hover:opacity-100">
                    
                    <Image 
                        src={colaborador.logo} 
                        alt={`Logo de ${colaborador.nombre}`} 
                        class="h-16 md:h-24 w-auto object-contain mb-4 drop-shadow-sm group-hover:drop-shadow-md transition-all duration-500"
                    />
                    
                    <span class="text-sm md:text-base font-bold text-slate-700 text-center max-w-[280px] leading-snug">
                        {colaborador.nombre}
                    </span>
                    
                    <span class="text-[10px] font-bold text-slate-400 mt-1 uppercase tracking-widest">
                        {colaborador.rol}
                    </span>
                    
                </div>
            ))}
        </div>

    </div>

</section>