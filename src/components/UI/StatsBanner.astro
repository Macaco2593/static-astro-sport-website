---
// src/components/ui/StatsBanner.astro
---
<section class="relative z-30 -mt-12 md:-mt-20 mx-auto max-w-5xl px-4">
  <div class="bg-white rounded-3xl shadow-2xl shadow-slate-900/10 border border-slate-100 p-6 md:p-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 text-center divide-x-0 md:divide-x divide-slate-100">
      
      <div class="flex flex-col items-center justify-center space-y-2">
        <p class="text-4xl md:text-5xl font-black font-display text-slate-900">
          +500
        </p>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Atletas Activos</p>
      </div>

      <div class="flex flex-col items-center justify-center space-y-2">
        <p class="text-4xl md:text-5xl font-black font-display text-cyan-500">
          12
        </p>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Clubes Afiliados</p>
      </div>

      <div class="flex flex-col items-center justify-center space-y-2">
        <p class="text-4xl md:text-5xl font-black font-display text-blue-600">
          4
        </p>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Disciplinas</p>
      </div>

      <div class="flex flex-col items-center justify-center space-y-2">
        <p class="text-4xl md:text-5xl font-black font-display text-indigo-500">
          100%
        </p>
        <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Pasión</p>
      </div>

    </div>
  </div>
</section>