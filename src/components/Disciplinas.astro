---
export const prerender = false;
import { BASE_DISCIPLINAS as disciplinas } from "src/data/disciplinas";
import { ROUTES } from "src/data/routes";
import { Image } from 'astro:assets';
import SectionTag from "./UI/SectionTag.astro";

// Definimos los colores base para el gradiente si no carga la imagen
const fallbackGradient = "bg-gradient-to-br from-slate-100 to-slate-200";
---

<section class="relative px-4 py-16 md:py-24 bg-slate-50 overflow-hidden">


  <div class="max-w-7xl mx-auto relative z-10">
    
    <header class="text-center mb-12 md:mb-16 animate-fade-in-down">
      <div class="text-center mb-4"> <SectionTag text="Deportes Acuáticos">
        <svg slot="icon" class="w-4 h-4 text-cyan-600" fill="currentColor" viewBox="0 0 20 20">
             <path d="M2 17s1.5-2 3.5-2 3.5 2 5.5 2 3.5-2 5.5-2 3.5 2 3.5 2m-17 2s1.5-2 3.5-2 3.5 2 5.5 2 3.5-2 5.5-2 3.5 2 3.5 2"/>
        </svg>
    </SectionTag>
      </div>
      
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-black font-display text-slate-900 mb-4 uppercase tracking-tighter relative inline-block">
        Nuestras <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-adadet-main to-cyan-500 pb-2">Disciplinas</span>
        <span class="absolute -bottom-2 left-0 w-16 h-1.5 bg-cyan-500 mt-4"></span>
      </h2>
      <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto">
        Explora las diferentes modalidades deportivas que promueve ADADET en el estado Táchira.
      </p>
    </header>

    {disciplinas && disciplinas.length > 0 ? (
      <ul class="grid gap-8 md:gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {disciplinas.map((deporte, index) => (
          <li 
            class="animate-fade-in-up h-full"
            style={`animation-delay: ${index * 150}ms`}
          >
            <article class="group relative h-full flex flex-col bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl hover:shadow-adadet-main/10 transition-all duration-500 border border-slate-100 hover:border-adadet-main/30">
              
              <div class={`relative w-full h-64 overflow-hidden ${fallbackGradient}`}>
                {deporte.imagenUrl ? (
                  <Image
                    src={deporte.imagenUrl}
                    alt={deporte.titulo}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    loading="lazy"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center bg-slate-50">
                    <svg class="w-20 h-20 text-slate-300" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M2 17s1.5-2 3.5-2 3.5 2 5.5 2 3.5-2 5.5-2 3.5 2 3.5 2m-17 2s1.5-2 3.5-2 3.5 2 5.5 2 3.5-2 5.5-2 3.5 2 3.5 2M7 7a2 2 0 100-4 2 2 0 000 4zm13 3l-4-1 1-3-2.5.5L13 9l-1.5-2L9 7.5 10 10l-4 1 1 3h12l1-4z"/>
                    </svg>
                  </div>
                )}
                
                <div class="absolute inset-0 bg-gradient-to-t from-adadet-dark/80 via-transparent to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>
                
                <div class="absolute top-4 right-4 transform translate-x-20 group-hover:translate-x-0 transition-transform duration-500">
                  <div class="bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-full flex items-center gap-2 shadow-sm border border-white/50">
                    <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
                    <span class="text-xs font-bold text-slate-700 uppercase tracking-wide">Activo</span>
                  </div>
                </div>
              </div>

              <div class="flex-1 flex flex-col p-8">
                <h3 class="text-2xl font-bold font-display text-slate-900 mb-3 group-hover:text-adadet-main transition-colors duration-300">
                  {deporte.titulo}
                </h3>

                <p class="flex-1 text-slate-600 leading-relaxed mb-6 line-clamp-3">
                  {deporte.descripcion}
                </p>

                <a 
                  href={ROUTES.disciplina(deporte.slug)}
                  class="mt-auto block"
                >
                  <button class="cursor-pointer relative w-full inline-flex items-center justify-center gap-2 px-6 py-4 bg-slate-900 text-white font-bold rounded-xl overflow-hidden group/btn transition-all duration-300 hover:shadow-lg hover:bg-adadet-main">
                    
                    <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-adadet-main to-cyan-500 transform translate-x-full group-hover/btn:translate-x-0 transition-transform duration-500 ease-out"></span>
                    
                    <span class="relative flex items-center gap-2">
                      Ver Detalles
                      <svg class="w-5 h-5 transform group-hover/btn:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </span>
                  </button>
                </a>
              </div>

            </article>
          </li>
        ))}
      </ul>
    ) : (
      <div class="text-center py-20 animate-fade-in-up bg-white rounded-3xl border border-slate-100 shadow-sm max-w-2xl mx-auto">
        <div class="inline-flex items-center justify-center w-24 h-24 bg-slate-50 rounded-full mb-6">
          <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
          </svg>
        </div>
        <p class="text-xl text-slate-600 font-bold">No hay disciplinas disponibles</p>
        <p class="text-slate-400 mt-2">Estamos actualizando nuestro catálogo deportivo.</p>
      </div>
    )}
  </div>
</section>

<style>
  /* Mantenemos las animaciones personalizadas que te gustan */
  @keyframes fade-in-down {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes blob {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(20px, -20px) scale(1.1); }
    50% { transform: translate(-20px, 20px) scale(0.9); }
    75% { transform: translate(20px, 20px) scale(1.05); }
  }
  .animate-fade-in-down { animation: fade-in-down 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  .animate-fade-in-up { animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1); animation-fill-mode: both; }
  .animate-blob { animation: blob 10s infinite alternate; }
  .animation-delay-2000 { animation-delay: 2s; }
  .animation-delay-4000 { animation-delay: 4s; }
</style>