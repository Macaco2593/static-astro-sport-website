---
import logoAdadet from "../assets/logoAdadet.svg";
import { DOCUMENTOS, DOCUMENTOS_SLUG } from "../data/documentos";

// Selección de documentos clave
const SLUGS_CENTRO_RECURSOS = [
  DOCUMENTOS_SLUG.ACTA_ASAMBLEA_GENERAL,
  DOCUMENTOS_SLUG.ACTA_ASAMBLEA_EXTRAORDINARIA,
  DOCUMENTOS_SLUG.PROVIDENCIA_ADMINISTRATIVA,
  DOCUMENTOS_SLUG.ESTATUTOS_ADADET,
  DOCUMENTOS_SLUG.SENIAT,
  DOCUMENTOS_SLUG.ISLR,
];

const documentos = DOCUMENTOS.filter((doc) => SLUGS_CENTRO_RECURSOS.includes(doc.slug));
---

<section class="relative px-4 py-16 md:py-20 bg-slate-50 overflow-hidden">
  
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -left-24 top-10 h-96 w-96 rounded-full bg-adadet-main/5 blur-3xl"></div>
    <div class="absolute -right-24 top-1/2 h-96 w-96 -translate-y-1/2 rounded-full bg-cyan-400/10 blur-3xl"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    
    <div class="w-full flex justify-center items-center gap-4 mb-12">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-adadet-main opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-adadet-main"></span>
        </span>
        <span class="inline-flex items-center gap-2 bg-cyan-50 text-adadet-main border border-cyan-100 px-4 py-2 rounded-full text-sm font-bold uppercase tracking-wider shadow-sm">
          Transparencia Institucional
        </span>
    </div>

    <div class="flex flex-col lg:grid lg:grid-cols-12 gap-12 lg:items-start">
      
      <div class="lg:col-span-4 flex justify-center lg:justify-start">
        <div class="relative group">
          <div class="absolute inset-0 bg-gradient-to-tr from-adadet-main to-cyan-400 rounded-full blur-2xl opacity-20 group-hover:opacity-30 transition-opacity duration-500"></div>
          
          <div class="relative rounded-3xl bg-white/80 backdrop-blur-xl p-8 shadow-xl ring-1 ring-white/50 border border-slate-100 transition-transform duration-500 hover:scale-[1.02]">
            <img
              src={logoAdadet.src}
              alt="Escudo Oficial ADADET"
              class="h-auto w-64 max-w-full object-contain drop-shadow-sm"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <div class="lg:col-span-8 space-y-8">
        
        <header class="space-y-6 text-center lg:text-left">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-black font-display text-slate-900 drop-shadow-sm leading-tight">
            Centro de 
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-adadet-main to-cyan-500 pb-2">
              Recursos ADADET
            </span>
          </h2>
          
          <p class="max-w-2xl mx-auto lg:mx-0 text-base md:text-lg leading-relaxed text-slate-600">
            En este espacio podrás consultar de forma rápida y organizada la documentación clave de la Asociación de Deportes Acuáticos del Estado Táchira: actas de asamblea, providencias, estatutos, declaraciones y otros documentos oficiales que respaldan nuestra gestión y transparencia institucional: 
            <strong class="text-adadet-dark">actas, estatutos y providencias</strong> al alcance de todos los afiliados.
          </p>
        </header>

        <div class="bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-slate-100 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-slate-50 rounded-bl-full -z-0"></div>

            <p class="relative z-10 mb-6 text-xs font-bold uppercase tracking-widest text-slate-400">
              Documentación Disponible
            </p>
            
            <div class="relative z-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {documentos.map((doc) => (
                <a
                  href={`/documentos/${doc.slug}`}
                  class="group flex items-center gap-4 rounded-xl bg-slate-50 px-4 py-3.5 border border-slate-200/60 transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:border-adadet-main/30 hover:shadow-lg hover:shadow-adadet-main/10"
                >
                  <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-white text-red-500 ring-1 ring-slate-100 shadow-sm group-hover:bg-red-50 group-hover:text-red-600 transition-colors">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                      <polyline points="14 2 14 8 20 8"/>
                      <path d="M9 15l3 3 3-3"/> <line x1="12" y1="12" x2="12" y2="18"/>
                    </svg>
                  </div>

                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-bold text-slate-700 truncate group-hover:text-adadet-main transition-colors">
                      {doc.titulo}
                    </p>
                    <p class="text-[10px] uppercase font-bold text-slate-400 mt-0.5 group-hover:text-adadet-main/60">
                      PDF • Oficial
                    </p>
                  </div>
                </a>
              ))}
            </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  /* Animación para el gradiente del texto */
  .bg-300% { background-size: 300% auto; }
  @keyframes gradient { 
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .animate-gradient { animation: gradient 6s ease infinite; }
</style>