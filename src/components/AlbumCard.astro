---
import { Image } from "astro:assets";
import { ROUTES } from "src/data/routes";

const { album, index =0 } = Astro.props;
---

<article 
                    class="group relative bg-white rounded-[2rem] shadow-xl shadow-slate-900/10 border border-slate-100 overflow-hidden hover:-translate-y-2 transition-all duration-500 animate-fade-in-up flex flex-col h-full"
                    style={`animation-delay: ${index * 100}ms`}
                >
                    <div class="relative h-64 overflow-hidden">
                        <div class="absolute inset-0 bg-slate-900/20 group-hover:bg-slate-900/10 transition-colors z-10"></div>
                        
                        <Image 
                            src={album.cover} 
                            alt={album.titulo}
                            inferSize={true}
                            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                            loading="lazy"
                        />
                        
                        {album.cantidadFotos && (
                        <div class="absolute top-4 right-4 z-20">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-900/60 backdrop-blur-md text-white text-xs font-bold border border-white/20 shadow-sm">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                {album.cantidadFotos}
                            </span>
                        </div>
                        )}

                        <div class="absolute bottom-4 left-4 z-20 flex gap-2">
                             {album.etiquetas.map(tag => (
                                <span class="px-2 py-1 rounded-md bg-white/90 backdrop-blur text-[10px] font-bold text-slate-700 uppercase tracking-wide">
                                    {tag}
                                </span>
                             ))}
                        </div>
                    </div>

                    <div class="p-6 pt-8 flex-1 flex flex-col relative">
                        <div class="flex items-center justify-between mb-3">
                            <p class="text-xs font-bold uppercase tracking-widest text-adadet-main">
                                {album.fecha}
                            </p>
                            <span class="text-xs font-medium text-slate-400 flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                {album.ubicación}
                            </span>
                        </div>
                        
                        <h3 class="text-xl font-black font-display text-slate-900 mb-4 leading-tight group-hover:text-cyan-600 transition-colors">
                            {album.titulo}
                        </h3>

                        <a 
                            href={album.linkExterno ? album.linkExterno : ROUTES.galeria_album(album.id)}
                            target={album.linkExterno ? "_blank" : "_self"}
                            rel={album.linkExterno ? "noopener noreferrer" : ""}
                            class="mt-auto w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl bg-slate-50 text-slate-700 text-sm font-bold transition-all duration-300 group-hover:bg-slate-900 group-hover:text-white group-hover:shadow-lg"
                        >
                            {album.linkExterno ? "Ver Álbum Externo" : "Ver Álbum Completo"}
                            
                            {album.linkExterno ? (
                                /* Ícono de enlace externo */
                                <svg class="w-4 h-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                </svg>
                            ) : (
                                /* Ícono de flecha normal */
                                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                                </svg>
                            )}
                        </a>
                    </div>
                </article>