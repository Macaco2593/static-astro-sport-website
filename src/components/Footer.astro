---
import logoAdadet from "../assets/adadet-logo.jpg";
import { ROUTES } from "../data/routes";
import { Image } from "astro:assets";
import { ADADET_INFO } from "src/data/adadet";

interface Props {
  withDecoration?: boolean;
}

const { withDecoration = true } = Astro.props;

// Definimos los iconos SVG
const socialLinks = [
  {
    name: "Facebook",
    href: ADADET_INFO.facebook,
    hoverColor: "group-hover:text-[#1877F2]", 
    viewBox: "0 0 24 24",
    path: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
  },
  {
    name: "Instagram",
    href: ADADET_INFO.instagram,
    hoverColor: "group-hover:text-[#E4405F]",
    viewBox: "0 0 24 24",
    path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
  },
];

const quickLinks = [
  { label: "Inicio", href: ROUTES.HOME },
  { label: "Calendario de eventos", href: ROUTES.CALENDARIO },
  // { label: "Galería Multimedia", href: ROUTES.GALERIA }
  { label: "Resultados Oficiales", href: ROUTES.RESULTADOS },
  { label: "Ranking Estadal", href: ROUTES.RANKING },
  { label: "Contacto y Denuncia", href: ROUTES.CONTACTO },
  { label: "Colaboradores", href: ROUTES.COLABORADORES },
];

const currentYear = new Date().getFullYear();
---

<footer class="relative bg-slate-900 text-slate-300 pt-20 overflow-hidden font-sans">
  
  {withDecoration && (
    <div class="absolute top-0 left-0 w-full overflow-hidden leading-[0]">
        <svg class="relative block w-[calc(100%+1.3px)] h-[50px] text-slate-50" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" fill="currentColor"></path>
        </svg>
    </div>
  )}
  
  <div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-80 h-80 bg-cyan-500/10 rounded-full blur-[80px] pointer-events-none"></div>

  <div class="mx-auto max-w-7xl px-4 pb-12 pt-8 relative z-10">
    
    <div class="grid gap-12 lg:grid-cols-[2fr_1fr_1fr] mb-16">
      
      <div class="space-y-6">
        <a href={ROUTES.HOME} class="group inline-flex items-center gap-4">
          <div class="relative h-16 w-16 overflow-hidden rounded-2xl bg-white p-1 ring-2 ring-white/10 transition-transform duration-300 group-hover:scale-105 group-hover:ring-adadet-main">
            <Image
              src={logoAdadet}
              alt="Logo ADADET"
              class="h-full w-full object-cover rounded-xl"
            />
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-cyan-400 mb-0.5">
              Desde 19XX
            </p>
            <p class="text-xl font-black font-display text-white leading-tight">
              ADADET
            </p>
            <p class="text-xs text-slate-400">Asociación de Deportes Acuáticos</p>
          </div>
        </a>

        <p class="max-w-md text-base leading-relaxed text-slate-400">
          Promovemos y desarrollamos la natación en el estado Táchira. 
          Formamos atletas íntegros bajo valores de <span class="text-white font-medium">disciplina, respeto y pasión</span>.
          
        </p>

        <div class="pt-4">
          <div class="flex items-center gap-4">
            {socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative flex h-12 w-12 items-center justify-center rounded-full bg-slate-800 border border-slate-700 transition-all duration-300 hover:-translate-y-1 hover:bg-white hover:border-white hover:shadow-lg hover:shadow-cyan-500/40"
                aria-label={social.name}
              >
                <svg 
                    class={`h-5 w-5 fill-current text-white transition-colors duration-300 ${social.hoverColor}`} 
                    viewBox={social.viewBox} 
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path d={social.path} />
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-white mb-6 border-l-4 border-adadet-main pl-3">
          Explorar
        </h3>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="group flex items-center gap-2 text-slate-400 transition-all hover:text-cyan-400 hover:translate-x-1"
              >
                <svg class="h-3 w-3 text-slate-600 transition-colors group-hover:text-adadet-main" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" />
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-white mb-6 border-l-4 border-cyan-500 pl-3">
          Contacto
        </h3>
        <ul class="space-y-6">
          <li class="flex items-start gap-4">
            <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-800 text-cyan-400">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase text-slate-500 mb-1">Sede Principal</p>
              <p class="text-sm text-slate-300 leading-snug">San Cristóbal,<br/>Estado Táchira, Venezuela.</p>
            </div>
          </li>
          
          <li class="flex items-start gap-4">
            <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-800 text-cyan-400">
               <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase text-slate-500 mb-1">Correo Oficial</p>
              <a href="mailto:info@adadet.org" class="text-sm text-white hover:text-adadet-main transition-colors">{ADADET_INFO.correo}</a>
            </div>
          </li>

          <li class="flex items-start gap-4">
            <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-800 text-cyan-400">
               <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase text-slate-500 mb-1">Teléfono</p>
              <a href="tel:+584120000000" class="text-sm text-white hover:text-adadet-main transition-colors">{ADADET_INFO.numero}</a>
            </div>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <div class="border-t border-slate-800 bg-slate-950 relative z-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-6 text-center text-xs text-slate-500 md:flex-row md:items-center md:justify-between">
      <p>
        &copy; {currentYear} ADADET. Todos los derechos reservados.
      </p>
      <div class="flex items-center justify-center gap-6">
        <a href="#" class="hover:text-white transition-colors">Privacidad</a>
        <a href="#" class="hover:text-white transition-colors">Términos</a>
        <span class="text-slate-700">|</span>
        <p>
          Desarrollado con <span class="text-red-500">❤</span> por <span class="font-bold text-slate-300">Ing. Santiago Paredes</span>
        </p>
      </div>
    </div>
  </div>
</footer>