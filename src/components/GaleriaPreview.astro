---
import { ROUTES } from "../data/routes";

const previewImages = [
  {
    src: "/images/galeria-1.jpg", 
    alt: "Competencia de natación en ADADET",
    category: "Competencias"
  },
  {
    src: "/images/galeria-2.jpg",
    alt: "Entrenamiento en piscina de ADADET",
    category: "Entrenamientos"
  },
  {
    src: "/images/galeria-3.jpg",
    alt: "Equipo de atletas acuáticos",
    category: "Institucional"
  },
];
---

<section class="relative px-4 py-16 md:py-24 bg-slate-50 overflow-hidden">
  
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -bottom-24 left-1/3 h-96 w-96 rounded-full bg-adadet-main/10 blur-3xl"></div>
    <div class="absolute top-0 right-0 h-64 w-64 rounded-full bg-cyan-400/10 blur-3xl"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    
    <header class="mb-12 md:mb-16 text-center max-w-4xl mx-auto flex flex-col items-center">
      
      <div class="inline-flex items-center gap-2 bg-cyan-50 text-adadet-main border border-cyan-100 px-4 py-2 rounded-full text-sm font-bold uppercase tracking-wider mb-6 shadow-sm transform hover:scale-105 transition-transform duration-300">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Momentos Destacados
      </div>

      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black font-display text-slate-900 drop-shadow-sm leading-tight mb-4">
        Galería Fotográfica 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-cyan-400 to-adadet-main">
          ADADET
        </span>
      </h2>
      
      <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto">
        Sumérgete en la acción. Una mirada exclusiva a nuestras competencias estatales, 
        jornadas de entrenamiento y el espíritu deportivo de nuestros atletas.
      </p>

      </header>

    <div class="grid gap-6 md:gap-8 md:grid-cols-3">
      {previewImages.map((image, index) => (
        <article 
          class="group relative overflow-hidden rounded-3xl bg-white shadow-lg shadow-slate-200/50 ring-1 ring-slate-100 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-adadet-main/20"
          style={`transition-delay: ${index * 100}ms`}
        >
          
          <div class="relative h-64 md:h-72 w-full overflow-hidden">
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
            
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-adadet-dark/90 via-adadet-dark/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>
            
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 transform scale-50 group-hover:scale-100">
              <div class="bg-white/20 backdrop-blur-md border border-white/50 p-4 rounded-full text-white shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                </svg>
              </div>
            </div>

            <div class="absolute bottom-0 left-0 p-6 translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
              <span class="inline-block px-3 py-1 mb-2 text-xs font-bold uppercase tracking-wider text-white bg-adadet-main/80 backdrop-blur-sm rounded-full">
                {image.category}
              </span>
              <h3 class="text-white font-bold text-lg leading-tight opacity-90 group-hover:opacity-100">
                {image.alt}
              </h3>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 flex justify-center">
      <a 
        href={ROUTES.GALERIA}
        class="group relative inline-flex items-center justify-center gap-2 px-8 py-4 bg-slate-900 text-white font-bold rounded-xl overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/30 hover:-translate-y-1"
      >
        <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-adadet-main to-cyan-500 transform translate-x-full group-hover:translate-x-0 transition-transform duration-500 ease-out"></span>
        
        <span class="relative flex items-center gap-3">
          Explorar Galería Completa
          <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>