---
const previewImages = [
  {
    src: "/images/galeria-1.jpg", // TODO: reemplazar por fotos reales en public/images
    alt: "Competencia de natación en ADADET",
  },
  {
    src: "/images/galeria-2.jpg",
    alt: "Entrenamiento en piscina de ADADET",
  },
  {
    src: "/images/galeria-3.jpg",
    alt: "Equipo de atletas acuáticos",
  },
];
---

<section class="relative px-4 py-16 md:py-20 bg-[#f2f2f5] overflow-hidden">
  <!-- fondo suave -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -bottom-24 left-1/3 h-64 w-64 rounded-full bg-cyan-300/15 blur-3xl"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <!-- encabezado -->
    <header class="mb-8 md:mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-cyan-700">
          Momentos destacados
        </p>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900">
          Galería fotográfica ADADET
        </h2>
        <p class="mt-2 max-w-2xl text-sm md:text-base text-slate-600">
          Una mirada rápida a nuestras competencias, entrenamientos y actividades institucionales.
        </p>
      </div>
    </header>

    <!-- fila de 3 tarjetas -->
    <div class="grid gap-4 md:gap-6 md:grid-cols-3">
      {previewImages.map((image) => (
        <article class="group relative overflow-hidden rounded-2xl bg-slate-900/5 shadow-md ring-1 ring-slate-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:ring-cyan-300">
          <div class="relative h-48 md:h-56 lg:h-60 overflow-hidden">
            <img
              src={image.src}
              alt={image.alt}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent opacity-60"></div>
          </div>
        </article>
      ))}
    </div>

    <!-- botón CTA -->
    <div class="mt-8 flex justify-center">
      <a
        href="/galeria"
        class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-cyan-600 to-blue-700 px-8 py-3 text-sm md:text-base font-semibold text-white shadow-lg transition-all duration-300 hover:from-cyan-700 hover:to-blue-800 hover:-translate-y-0.5 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50"
      >
        Explorar galería completa
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" />
          <path d="M13 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
