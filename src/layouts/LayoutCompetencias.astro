---
import Header from "src/components/Header.astro";
import Footer from "src/components/Footer.astro";
import "../styles/global.css";

interface Props {
  titulo: string;
  footerDecoration?: boolean; 
}
const { titulo, footerDecoration = true } = Astro.props;

---
<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{titulo}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=Montserrat:wght@700;900&display=swap" rel="stylesheet">
    <script src="https://documentcloud.adobe.com/view-sdk/main.js" defer></script>
</head>
<body class="bg-[#f2f2f5] text-slate-900 pt-20">
    <Header />
    <main>
        <article>
            <div>
                <slot />
            </div>
        </article>
    </main>
    <Footer withDecoration={footerDecoration}/>
</body>
</html>
