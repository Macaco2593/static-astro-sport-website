---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&family=Montserrat:wght@700;900&display=swap" rel="stylesheet">
		<title>Adadet | Asociación de Deportes Acuáticos del estado Táchira</title>
	</head>
	<body class="bg-[#f2f2f5] text-slate-900">
		<Header/>
		<main class="grow">
			<slot />
		</main>
		
		<Footer/>
	</body>
</html>

 <style is:global>
	@reference "tailwindcss/utilities";
	/* :root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-gradent: linear-gradient()
		rgb(var(--accent)),
		rgb(var(--accent-light)) 30%,
		white 60%
		);
	} */
	html{
		font-family: system-ui, sans-serif;
		background: #13151a;
		color: #fff;
	},
	body {
		@apply grid place-content-center;
		padding: 5rem;
	}

	body > div {
		@apply container;
	}
</style>
