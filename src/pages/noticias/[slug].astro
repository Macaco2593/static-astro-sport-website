---
import { Image } from "astro:assets";
import LayoutCompetencias from "../../layouts/LayoutCompetencias.astro";
import { NOTICIAS } from "src/data/noticias";

export function getStaticPaths() {
  const noticiasLocales = NOTICIAS.filter((noticia) => !noticia.linkExterno)
  return noticiasLocales.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;

const fecha = new Date(noticia.fecha).toLocaleDateString("es-VE", {
    year: "numeric", month: "long", day: "numeric", timeZone: "UTC"
});

const currentUrl = Astro.url.href;
---

<LayoutCompetencias titulo={`${noticia.titulo} | Noticias ADADET`} descripcion={noticia.resumen} image={noticia.imagen}>
    
    <div class="bg-slate-50 min-h-screen pb-20 relative overflow-hidden">
        
        <div class="absolute top-0 left-0 w-full h-full pointer-events-none">
            <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-cyan-500/5 rounded-full blur-3xl mix-blend-multiply"></div>
            <div class="absolute top-40 -left-20 w-[400px] h-[400px] bg-blue-500/5 rounded-full blur-3xl mix-blend-multiply"></div>
        </div>

        <div class="max-w-4xl mx-auto px-4 pt-8 pb-4 relative z-20">
            <a href="/noticias" class="inline-flex items-center gap-2 text-sm font-bold text-slate-500 hover:text-cyan-600 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                Volver a Noticias
            </a>
        </div>

        <article class="relative z-10 max-w-4xl mx-auto px-4">
            
            <div class="bg-white rounded-[2.5rem] shadow-xl shadow-slate-200/60 overflow-hidden border border-slate-100">
                
                {noticia.imagen && (
                    <>
                        <button 
                            id="openModalBtn"
                            class="group relative w-full aspect-video md:h-[450px] overflow-hidden cursor-zoom-in block outline-none"
                            aria-label="Ver imagen completa"
                        >
                            <Image 
                                src={noticia.imagen} 
                                alt={noticia.titulo} 
                                inferSize={true}
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                            />
                            
                            <div class="absolute inset-0 bg-slate-900/0 group-hover:bg-slate-900/10 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
                                <div class="bg-white/90 backdrop-blur rounded-full p-3 shadow-lg transform scale-75 group-hover:scale-100 transition-transform">
                                     <svg class="w-6 h-6 text-slate-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                                     </svg>
                                </div>
                            </div>
                            <div class="absolute bottom-0 left-0 w-full h-24 bg-gradient-to-t from-white to-transparent pointer-events-none"></div>
                        </button>
                    </>
                    
                )}

                

                <div class="px-6 py-10 md:px-12 md:py-12 bg-white relative">
                    <div class="mb-10 text-center md:text-left border-b border-slate-100 pb-10">
                        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 mb-6">
                            <span class="bg-cyan-50 text-cyan-700 text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-wider border border-cyan-100">
                                {noticia.categoria}
                            </span>
                            <span class="flex items-center gap-2 text-slate-400 text-sm font-medium">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                {fecha}
                            </span>
                        </div>
                        <h1 class="text-3xl md:text-5xl font-black text-slate-900 leading-tight mb-4 font-display">
                            {noticia.titulo}
                        </h1>
                    </div>

                    <div 
                        class="prose prose-lg prose-slate prose-headings:font-bold prose-headings:text-slate-900 prose-a:text-cyan-600 prose-a:font-bold hover:prose-a:text-cyan-800 prose-img:rounded-2xl prose-img:shadow-lg max-w-none text-slate-600 leading-relaxed"
                        set:html={noticia.contenido} 
                    />
                </div>

                <div class="bg-slate-50 px-6 py-10 md:px-12 border-t border-slate-100 rounded-b-[2.5rem]">
    <h4 class="text-center text-sm font-bold text-slate-400 uppercase tracking-widest mb-6">
        ¿Te gustó? Compártelo
    </h4>
    
    <div class="flex flex-wrap justify-center gap-4">
        
        <a 
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent('¡Mira esta noticia!: ' + noticia.titulo + ' ' + currentUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-6 py-3 bg-[#25D366] text-white rounded-xl font-bold hover:shadow-lg hover:-translate-y-1 transition-all shadow-md shadow-green-200"
        >
             <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
             </svg>
             WhatsApp
        </a>

        <a 
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-6 py-3 bg-[#1877F2] text-white rounded-xl font-bold hover:shadow-lg hover:-translate-y-1 transition-all shadow-md shadow-blue-200"
        >
             <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.791-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
             </svg>
             Facebook
        </a>

    </div>
</div>

            </div>
        </article>
        {noticia.imagen && (
        <div id="imageModal" class="hidden fixed inset-0 z-100000 bg-slate-900/95 backdrop-blur-sm transition-opacity duration-300 opacity-0">
            <button 
                id="closeModalBtn"
                class="absolute top-6 right-6 z-50 p-2 bg-white/10 hover:bg-white/20 text-white rounded-full transition-colors cursor-pointer"
                aria-label="Cerrar imagen"
            >
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <div class="flex items-center justify-center w-full h-full p-4 md:p-10" id="modalContent">
                <Image 
                    src={noticia.imagen} 
                    alt={noticia.titulo} 
                    inferSize={true}
                    class="max-w-full max-h-full object-contain rounded-lg shadow-2xl scale-95 transition-transform duration-300"
                    id="modalImage"
                />
            </div>
        </div>
    )}
    </div>

    <script>
        const openBtn = document.getElementById('openModalBtn');
        const closeBtn = document.getElementById('closeModalBtn');
        const modal = document.getElementById('imageModal');
        const modalImage = document.getElementById('modalImage');

        if (openBtn && modal && closeBtn && modalImage) {
            
            // Función abrir
            openBtn.addEventListener('click', () => {
                modal.classList.remove('hidden');
                // Pequeño delay para permitir que la transición de opacidad funcione
                setTimeout(() => {
                    modal.classList.remove('opacity-0');
                    modalImage.classList.remove('scale-95');
                    modalImage.classList.add('scale-100');
                }, 10);
            });

            // Función cerrar
            const closeModal = () => {
                modal.classList.add('opacity-0');
                modalImage.classList.remove('scale-100');
                modalImage.classList.add('scale-95');
                
                // Esperar a que termine la animación para ocultar el div
                setTimeout(() => {
                    modal.classList.add('hidden');
                }, 300);
            };

            closeBtn.addEventListener('click', closeModal);

            // Cerrar al dar click fuera de la imagen (en el fondo oscuro)
            modal.addEventListener('click', (e) => {
                if (e.target === modal || e.target === document.getElementById('modalContent')) {
                    closeModal();
                }
            });

            // Cerrar con tecla ESC
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                    closeModal();
                }
            });
        }
    </script>

</LayoutCompetencias>