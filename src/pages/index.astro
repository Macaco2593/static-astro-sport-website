---
import '../styles/global.css';
import HeroCarousel from '../components/HeroCarousel.astro';
import Disciplinas from '../components/Disciplinas.astro';
import GaleriaPreview from '../components/GaleriaPreview.astro';
import NoticiasPreview from 'src/components/NoticiasPreview.astro';
import LayoutCompetencias from 'src/layouts/LayoutCompetencias.astro';
import CarouselColaboradores from 'src/components/UI/CarouselColaboradores.astro';

const pageTitle = "Adadet | Asociación de Deportes Acuáticos del estado Táchira";
const pageDescription = 'Sitio oficial de la Asociación de Deportes Acuáticos del Estado Táchira. Noticias, rankings, resultados y calendario de eventos de natación en la región.';
---

<LayoutCompetencias titulo={pageTitle} descripcion={pageDescription}>
    
    <HeroCarousel />
    
    <main class="bg-slate-50">
        
        <section id="disciplinas" class="disciplinas-section pb-16">
            <Disciplinas/>
        </section>

        <CarouselColaboradores/>

        <section class="mb-20">
            <NoticiasPreview/>
        </section>

        <section class="relative py-24 my-24 transform -skew-y-2 overflow-hidden shadow-2xl">
    {/* Imagen de fondo con efecto parallax */}
    <div class="absolute inset-0 bg-cover bg-center bg-fixed bg-[url('/src/assets/heroCarousel/pool.jpg')]"></div>
    
    {/* Overlay oscuro para que el texto sea legible */}
    <div class="absolute inset-0 bg-gradient-to-r from-slate-900/90 to-adadet-dark/80"></div>
            
            <div class="transform skew-y-2 max-w-4xl mx-auto px-4 text-center relative z-10">
                <h2 class="text-3xl md:text-4xl font-black font-display text-white mb-4 uppercase tracking-tight">
                    Impulsando el talento <span class="text-cyan-400">Tachirense</span>
                </h2>
                <p class="text-slate-400 text-lg md:text-xl">
                    Avalados por la FEVEDA y el Instituto del Deporte Tachirense.
                </p>
            </div>
        </section>

        <section id="galeria" class="galeria-preview-section">
            <GaleriaPreview/>
        </section>


    </main>
</LayoutCompetencias>

<style>
    @keyframes marquee {
        0% { transform: translateX(0%); }
        100% { transform: translateX(-100%); }
    }
    @keyframes marquee2 {
        0% { transform: translateX(100%); }
        100% { transform: translateX(0%); }
    }
    .animate-marquee {
        animation: marquee 30s linear infinite;
    }
    .animate-marquee2 {
        animation: marquee2 30s linear infinite;
    }
</style>