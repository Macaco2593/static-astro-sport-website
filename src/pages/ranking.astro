---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import PageHero from "../components/UI/PageHero.astro";
import WaveDivider from "../components/UI/WaveDivider.astro";
import RANKING_DATA from "../data/generated-ranking.json"; 

// Función auxiliar para contar registros totales (Se mantiene igual)
function contarAtletas(categoria: { pruebas: { masculino: any[]; femenino: any[] }[] }) {
  let total = 0;
  categoria.pruebas.forEach((prueba) => {
    total += prueba.masculino.length + prueba.femenino.length;
  });
  return total;
}

const fechaActualizacion = new Date(RANKING_DATA.ultimaActualizacion).toLocaleDateString("es-VE", {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const pageTitle = "Ranking Estadal Oficial | ADADET";
const pageDescription = "Descubre quiénes son los mejores nadadores del estado. Ranking actualizado por categorías y disciplinas de la Asociación de Deportes Acuáticos de Táchira."
---

<LayoutCompetencias titulo={pageTitle} descripcion={pageDescription} footerDecoration={false}>
  
  <div class="bg-slate-50 min-h-screen relative">
    
    <PageHero 
        title="Ranking de"
        gradientText="Mejores Marcas"
        subtitle="Base de datos oficial de tiempos y récords de la natación tachirense. Resultados procesados automáticamente desde <strong>Hy-Tek Meet Manager<strong/>."
        badge="Temporada 2026 • Oficial"
    />

    <div class="relative z-20 max-w-7xl mx-auto px-4 -mt-20 mb-20">
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        
            {RANKING_DATA.categorias.map((categoria, index) => (
                <article 
                    class="group relative bg-white rounded-2xl shadow-xl shadow-slate-900/10 border border-slate-100 overflow-hidden hover:-translate-y-2 transition-all duration-300 animate-fade-in-up"
                    style={`animation-delay: ${index * 100}ms`}
                >
                    <div class="h-1.5 w-full bg-gradient-to-r from-adadet-main to-cyan-400 transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>

                    <div class="p-8">
                        <div class="flex justify-between items-start mb-6">
                            <div>
                                <h2 class="text-2xl font-black font-display text-slate-800 group-hover:text-adadet-main transition-colors">
                                    {categoria.titulo}
                                </h2>
                                <p class="text-sm font-bold text-slate-400 mt-1 uppercase tracking-wide">
                                    {categoria.edades}
                                </p>
                            </div>
                            <div class="h-12 w-12 rounded-xl bg-slate-50 flex items-center justify-center text-slate-300 group-hover:bg-cyan-50 group-hover:text-adadet-main transition-colors duration-300">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4 py-5 border-y border-slate-50 mb-6">
                            <div class="flex flex-col items-center justify-center border-r border-slate-50">
                                <span class="text-3xl font-black text-slate-900">{categoria.pruebas.length}</span>
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">Pruebas</span>
                            </div>
                            <div class="flex flex-col items-center justify-center">
                                <span class="text-3xl font-black text-slate-900">{contarAtletas(categoria)}</span>
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">Registros</span>
                            </div>
                        </div>

                        <a 
                            href={`/ranking/${categoria.id}`} 
                            class="group/btn relative flex items-center justify-center w-full py-4 bg-slate-50 text-slate-700 font-bold rounded-xl overflow-hidden transition-all duration-300 hover:text-white hover:shadow-lg hover:shadow-adadet-main/30"
                        >
                            <span class="absolute inset-0 w-full h-full bg-adadet-main transform scale-x-0 group-hover/btn:scale-x-100 transition-transform duration-300 origin-left"></span>
                            <span class="relative flex items-center gap-2 z-10">
                                Ver Ranking Completo
                                <svg class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                </svg>
                            </span>
                        </a>
                    </div>
                </article>
            ))}

        </div>

        <div class="mt-12 text-center pt-8 animate-fade-in-up" style="animation-delay: 400ms">
            <p class="text-sm text-slate-400">
                Última sincronización con base de datos: <strong class="text-slate-600">{fechaActualizacion}</strong>
            </p>
        </div>

    </div>
    
    <div class="relative pt-10">
         <WaveDivider fillColor="#0f172a" />
    </div>

  </div>
</LayoutCompetencias>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }
</style>