---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
// Importamos el JSON nuevo
import RANKING_DATA from "../data/generated-ranking.json"; 

// Función auxiliar para contar atletas totales en una categoría
function contarAtletas(categoria) {
  let total = 0;
  // Recorremos todas las pruebas de la categoría
  categoria.pruebas.forEach(prueba => {
    total += prueba.masculino.length + prueba.femenino.length;
  });
  return total;
}
---

<LayoutCompetencias titulo="Ranking Estadal 2026 | ADADET">
  
  <header class="relative h-[40vh] min-h-[300px] flex items-center justify-center bg-slate-900 overflow-hidden">
     <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-transparent z-10"></div>
     <img src="/assets/fondos/piscina-ranking.jpg" alt="Ranking Background" class="absolute inset-0 w-full h-full object-cover opacity-40 mix-blend-overlay" />
     
     <div class="relative z-20 text-center px-4 max-w-4xl">
        <span class="inline-block py-1 px-3 rounded-full bg-cyan-500/20 text-cyan-300 text-xs font-bold tracking-widest border border-cyan-500/30 uppercase backdrop-blur-sm mb-4">
          Temporada Oficial 2026
        </span>
        <h1 class="text-4xl md:text-6xl font-black text-white mb-4 tracking-tight">
           Ranking de <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Mejores Marcas</span>
        </h1>
        <p class="text-slate-300 text-lg max-w-2xl mx-auto">
          Consulta los tiempos oficiales y récords de los atletas del estado Táchira, clasificados por categoría y prueba.
        </p>
     </div>
  </header>

  <main class="bg-slate-50 py-16 px-4">
    <div class="max-w-7xl mx-auto">
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        {RANKING_DATA.map((categoria) => (
          <article class="group bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            
            <div class="p-8">
              <div class="flex justify-between items-start mb-4">
                <div>
                  <h2 class="text-2xl font-bold text-slate-800 group-hover:text-cyan-600 transition-colors">
                    {categoria.titulo}
                  </h2>
                  <p class="text-sm font-medium text-slate-500 mt-1">{categoria.edades}</p>
                </div>
                <div class="bg-cyan-50 p-3 rounded-xl text-cyan-600">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                  </svg>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-4 my-6 border-y border-slate-100 py-4">
                <div class="text-center">
                  <span class="block text-2xl font-bold text-slate-900">{categoria.pruebas.length}</span>
                  <span class="text-xs text-slate-500 uppercase font-bold tracking-wide">Pruebas</span>
                </div>
                <div class="text-center border-l border-slate-100">
                  <span class="block text-2xl font-bold text-slate-900">{contarAtletas(categoria)}</span>
                  <span class="text-xs text-slate-500 uppercase font-bold tracking-wide">Marcas</span>
                </div>
              </div>

              <a 
                href={`/ranking/${categoria.id}`} 
                class="block w-full text-center bg-slate-900 text-white font-bold py-3 rounded-xl hover:bg-cyan-600 transition-colors"
              >
                Ver Tiempos y Resultados &rarr;
              </a>
            </div>
            
            <div class="h-1 w-full bg-gradient-to-r from-cyan-400 to-blue-500 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300"></div>
          </article>
        ))}

      </div>

      <div class="mt-16 text-center text-slate-400 text-sm">
        <p>Los tiempos son procesados automáticamente desde los resultados oficiales de Hy-Tek Meet Manager.</p>
        <p>Última actualización: {new Date().toLocaleDateString()}</p>
      </div>

    </div>
  </main>
</LayoutCompetencias>