---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import logoAdadet from "../../assets/logoAdadet.svg";
import { DOCUMENTOS, type Documento } from "../../data/documentos";

export function getStaticPaths() {
  return DOCUMENTOS.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

interface Props {
  doc: Documento;
}

const { doc } = Astro.props as Props;

const fecha = new Date(doc.fechaPublicacion);
const fechaFormateada = fecha.toLocaleDateString("es-VE", {
  year: "numeric",
  month: "long",
  day: "2-digit",
});
---

<LayoutCompetencias titulo={`${doc.titulo} | Documentación ADADET`}>
  <section class="min-h-screen bg-slate-50">
    
    <div class="pointer-events-none absolute inset-0 overflow-hidden h-96">
        <div class="absolute -top-24 right-0 h-96 w-96 rounded-full bg-adadet-main/5 blur-3xl"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 py-10 md:py-16 space-y-10">
      
      <header class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between border-b border-slate-200 pb-8">
        <div class="flex items-start gap-5">
          <div class="hidden sm:flex h-20 w-20 flex-shrink-0 items-center justify-center rounded-2xl bg-white shadow-lg shadow-slate-200/50 ring-1 ring-slate-100">
            <img
              src={logoAdadet.src}
              alt="Logo ADADET"
              class="h-14 w-14 object-contain"
              loading="lazy"
            />
          </div>
          
          <div class="space-y-2">
            <div class="inline-flex items-center">
                <span class="h-1.5 w-1.5 rounded-full bg-adadet-main"></span>
                <p class="text-xs font-bold uppercase tracking-widest text-adadet-light">
                Documento Oficial
                </p>
            </div>
            
            <h1 class="text-3xl md:text-4xl font-black font-display text-slate-900 leading-tight">
              {doc.titulo}
            </h1>
            
            {doc.descripcion && (
              <p class="max-w-3xl text-base md:text-lg text-slate-600 leading-relaxed">
                {doc.descripcion}
              </p>
            )}
          </div>
        </div>

        <div class="flex flex-col items-end gap-3 text-right">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold uppercase tracking-wide rounded-full border border-emerald-100">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
                Disponible
            </div>
            <p class="text-sm text-slate-500">
                Publicado el <time datetime={doc.fechaPublicacion} class="font-bold text-slate-800">{fechaFormateada}</time>
            </p>
        </div>
      </header>

      <div class="grid gap-8 lg:grid-cols-[1fr_320px] items-start">
        
        <div class="flex flex-col">
            <div class="flex items-center justify-between bg-white px-4 py-3 rounded-t-2xl border border-slate-200 border-b-0 shadow-sm">
                <span class="text-sm font-bold text-slate-600 flex items-center gap-2">
                    <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" /><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd" /></svg>
                    Vista Previa
                </span>
                
                <a
                  href={doc.archivo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group relative inline-flex items-center gap-2 rounded-lg bg-slate-900 px-4 py-2 text-xs font-bold text-white transition-all hover:bg-adadet-main hover:shadow-lg hover:shadow-adadet-main/30"
                >
                  <svg class="h-4 w-4 transition-transform group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  Descargar Archivo
                </a>
            </div>

            <div class="overflow-hidden rounded-b-2xl bg-slate-100 shadow-lg ring-1 ring-slate-200 h-[600px] md:h-[800px]">
                <iframe
                  src={`${doc.archivo}#toolbar=1&navpanes=0&scrollbar=1`}
                  title={doc.titulo}
                  class="h-full w-full"
                >
                </iframe>
            </div>
        </div>

        <aside class="space-y-6">
          
          <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-100 border-t-4 border-adadet-main">
            <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-slate-400">
              Ficha Técnica
            </h2>
            
            <dl class="space-y-4 text-sm">
              <div class="flex flex-col pb-4 border-b border-slate-50 last:border-0 last:pb-0">
                <dt class="text-slate-500 text-xs mb-1">Tipo de Archivo</dt>
                <dd class="font-bold text-slate-800 flex items-center gap-2">
                    <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    PDF (Portable Document Format)
                </dd>
              </div>
              
              <div class="flex flex-col pb-4 border-b border-slate-50 last:border-0 last:pb-0">
                <dt class="text-slate-500 text-xs mb-1">Categoría</dt>
                <dd class="font-bold text-slate-800">Institucional / Legal</dd>
              </div>

              <div class="flex flex-col">
                <dt class="text-slate-500 text-xs mb-1">Estado</dt>
                <dd class="inline-flex">
                    <span class="bg-green-100 text-green-700 px-2 py-0.5 rounded text-xs font-bold">Vigente</span>
                </dd>
              </div>
            </dl>
          </div>

          <div class="rounded-2xl bg-cyan-50 p-5 border border-cyan-100">
            <div class="flex gap-3">
                <div class="shrink-0 text-cyan-600 mt-0.5">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                    <h3 class="font-bold text-cyan-900 text-sm mb-1">¿Problemas para visualizar?</h3>
                    <p class="text-xs text-cyan-800 leading-relaxed">
                        Si el documento no carga correctamente en el navegador, te recomendamos descargarlo y abrirlo con Adobe Acrobat Reader.
                    </p>
                </div>
            </div>
          </div>

        </aside>
      </div>
    </div>
  </section>
</LayoutCompetencias>