---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import logoAdadet from "../../assets/logoAdadet.svg";
import { DOCUMENTOS, type Documento } from "../../data/documentos";

export function getStaticPaths() {
  return DOCUMENTOS.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

interface Props {
  doc: Documento;
}

const { doc } = Astro.props as Props;

const fecha = new Date(doc.fechaPublicacion);
const fechaFormateada = fecha.toLocaleDateString("es-VE", {
  year: "numeric",
  month: "long",
  day: "2-digit",
});
---

<LayoutCompetencias titulo={doc.titulo}>
  <section class="min-h-screen bg-[#f2f2f5]">
    <div class="mx-auto max-width-[1200px] max-w-6xl px-4 py-10 md:py-14 space-y-10">
      <!-- Encabezado del documento -->
      <header class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div class="flex items-start gap-4">
          <div class="hidden sm:flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-full bg-white shadow-sm ring-1 ring-slate-200">
            <img
              src={logoAdadet.src}
              alt="Logo ADADET"
              class="h-full w-full object-contain"
              loading="lazy"
            />
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-700 mb-1">
              Documento oficial ADADET
            </p>
            <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight text-slate-900">
              {doc.titulo}
            </h1>
            {doc.descripcion && (
              <p class="mt-2 max-w-2xl text-sm md:text-base text-slate-600">
                {doc.descripcion}
              </p>
            )}
          </div>
        </div>
        <div class="space-y-2 text-sm text-right text-slate-600">
          <p>
            <span class="font-semibold text-slate-800">Fecha de publicación:</span><br />
            <time datetime={doc.fechaPublicacion}>{fechaFormateada}</time>
          </p>
          <p class="inline-flex items-center justify-end gap-2 rounded-full bg-white px-3 py-1 text-xs font-medium text-slate-700 shadow-sm ring-1 ring-slate-200">
            <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            PDF disponible para descarga
          </p>
        </div>
      </header>

      <!-- Contenido principal: visor + detalles -->
      <div class="grid gap-8 lg:grid-cols-[minmax(0,2.3fr)_minmax(0,1.1fr)] items-start">
        <!-- Visor de PDF -->
        <div class="overflow-hidden rounded-2xl bg-white shadow-md ring-1 ring-slate-200">
          <div class="border-b border-slate-100 px-4 py-3 flex items-center justify-between">
            <p class="text-sm font-semibold text-slate-800 truncate pr-4">
              {doc.titulo}
            </p>
            <a
              href={doc.archivo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-cyan-600 to-blue-700 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition-all duration-200 hover:from-cyan-700 hover:to-blue-800 hover:-translate-y-0.5 hover:shadow-md"
            >
              <svg
                class="h-4 w-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 4h16v12H4z" />
                <path d="M8 18h8" />
                <path d="M10 22h4" />
              </svg>
              <span>Descargar PDF</span>
            </a>
          </div>
          <div class="aspect-[4/3] bg-slate-100">
            <!-- Visor nativo del navegador -->
            <iframe
              src={`${doc.archivo}#toolbar=1&navpanes=0&scrollbar=1`}
              title={doc.titulo}
              class="h-full w-full"
            >
            </iframe>
          </div>
        </div>

        <!-- Panel lateral con metadatos / acciones -->
        <aside class="space-y-6">
          <div class="rounded-2xl bg-white p-5 shadow-md ring-1 ring-slate-200">
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">
              Detalles del documento
            </h2>
            <dl class="space-y-3 text-sm text-slate-700">
              <div class="flex justify-between gap-4">
                <dt class="font-medium text-slate-800">Tipo</dt>
                <dd>PDF institucional</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="font-medium text-slate-800">Publicado</dt>
                <dd>
                  <time datetime={doc.fechaPublicacion}>{fechaFormateada}</time>
                </dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="font-medium text-slate-800">Tamaño</dt>
                <dd>— <!-- puedes completar este dato si lo conoces --></dd>
              </div>
            </dl>
          </div>

          <div class="rounded-2xl bg-white p-5 shadow-md ring-1 ring-slate-200">
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">
              Herramientas sugeridas
            </h2>
            <p class="mb-3 text-sm text-slate-600">
              Para una experiencia más interactiva (búsquedas, anotaciones, descargas, etc.) puedes
              habilitar el visor de <span class="font-semibold">Adobe PDF Embed</span> en lugar del
              visor nativo del navegador.
            </p>
            <ol class="list-decimal space-y-1 pl-5 text-sm text-slate-600">
              <li>
                Regístrate en Adobe PDF Embed API y obtén tu
                <code class="rounded bg-slate-100 px-1 py-0.5 text-[0.75rem]">clientId</code>.
              </li>
              <li>Incluye el script de Adobe en tu layout principal.</li>
              <li>
                Usa un contenedor con
                <code class="rounded bg-slate-100 px-1 py-0.5 text-[0.75rem]">id="adobe-dc-view"</code>
                y llama a
                <code class="rounded bg-slate-100 px-1 py-0.5 text-[0.75rem]">AdobeDC.View</code> en un
                pequeño script.
              </li>
            </ol>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!--
    Ejemplo (simplificado) de integración con Adobe PDF Embed API
    (añádelo en un script client:load o en un archivo JS separado)

    <script src="https://documentcloud.adobe.com/view-sdk/main.js"></script>
    <script is:raw>
      document.addEventListener("adobe_dc_view_sdk.ready", function () {
        const adobeDCView = new AdobeDC.View({
          clientId: "TU_CLIENT_ID_AQUI",
          divId: "adobe-dc-view",
        });
        adobeDCView.previewFile(
          {
            content: { location: { url: "REEMPLAZA_CON_URL_DEL_PDF" } },
            metadata: { title: "{doc.titulo}" },
          },
          {
            embedMode: "SIZED_CONTAINER",
            defaultViewMode: "FIT_WIDTH",
            showDownloadPDF: true,
            showPrintPDF: true,
          }
        );
      });
    <\/script>
  -->
</LayoutCompetencias>