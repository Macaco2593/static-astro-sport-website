---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import { DOCUMENTOS, type Documento } from "../../data/documentos";
import WaveDivider from "../../components/UI/WaveDivider.astro";

export function getStaticPaths() {
  return DOCUMENTOS.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

interface Props {
  doc: Documento;
}

const { doc } = Astro.props;

const urlCompleta = `${import.meta.env.BUCKET_CLOUDR2}${doc.archivo}`; 
const urlVisorGoogle = `https://docs.google.com/viewer?url=${encodeURIComponent(urlCompleta)}&embedded=true`;

const fecha = new Date(doc.fechaPublicacion);
const fechaFormateada = fecha.toLocaleDateString("es-VE", {
  year: "numeric",
  month: "long",
  day: "2-digit",
  timeZone: "UTC"
});
---

<LayoutCompetencias titulo={`${doc.titulo} | Documentación ADADET`} descripcion={doc.descripcion} footerDecoration={false}>
  
  <div class="min-h-screen bg-slate-50 flex flex-col relative -mt-20 overflow-x-hidden">
    
    <div class="bg-white pt-28 pb-16 border-b border-slate-200 relative">
        
        <div class="absolute top-0 right-0 w-96 h-96 bg-cyan-50 rounded-full blur-3xl -mr-20 -mt-20 opacity-50"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-50 rounded-full blur-3xl -ml-20 -mb-20 opacity-50"></div>

        <div class="relative z-10 mx-auto max-w-7xl px-4">
            
            <a href="javascript:history.back()" class="inline-flex items-center gap-2 text-slate-500 hover:text-adadet-main transition-colors mb-6 group text-sm font-bold">
                <div class="p-1.5 rounded-full border border-slate-200 bg-slate-50 group-hover:bg-white group-hover:shadow-sm transition-all">
                    <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </div>
                Volver
            </a>

            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div class="space-y-4 max-w-3xl">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-slate-100 text-slate-600 text-xs font-bold uppercase tracking-widest">
                        <svg class="w-4 h-4 text-adadet-main" fill="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                        Documento Oficial
                    </div>
                    
                    <h1 class="text-3xl md:text-4xl lg:text-5xl font-black font-display text-slate-900 leading-tight">
                        {doc.titulo}
                    </h1>
                    
                    <div class="flex items-center gap-4 text-sm text-slate-500">
                        <span class="flex items-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                            {fechaFormateada}
                        </span>
                        <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                        <span class="text-adadet-main font-bold">Público</span>
                    </div>
                </div>

                <a
                  href={urlCompleta}
                  download
                  class="hidden md:inline-flex items-center gap-2 rounded-xl bg-slate-900 px-6 py-3 text-sm font-bold text-white transition-all hover:bg-adadet-main hover:shadow-lg hover:-translate-y-1"
                >
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                  Descargar PDF
                </a>
            </div>
        </div>
    </div>

    <div class="relative z-100 mx-auto max-w-7xl px-4 w-full flex-grow py-12">
      
      <div class="grid lg:grid-cols-[1fr_360px] gap-8 items-start">
        
        <div class="flex flex-col h-full shadow-2xl shadow-slate-200/50 rounded-2xl overflow-hidden border border-slate-200 animate-fade-in-up">
            <div class="bg-slate-800 px-4 py-3 flex items-center justify-between border-b border-slate-700">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Vista Previa</span>
                <div class="flex gap-1.5">
                    <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                    <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                </div>
            </div>
            
            {/* --- VISTA PARA COMPUTADORAS (Iframe Nativo) --- */}
            {/* En celulares (hidden), en PC se muestra (md:block) */}
            <div class="hidden md:block bg-slate-300 h-[70vh] min-h-[600px]">
                <iframe
                  src={`${urlCompleta}#toolbar=1&navpanes=0&scrollbar=1`}
                  title={doc.titulo}
                  class="w-full h-full border-none"
                >
                </iframe>
            </div>

            {/* --- VISTA PARA CELULARES (Panel de Acción) --- */}
            {/* En celulares se muestra (flex), en PC se oculta (md:hidden) */}
            <div class="flex flex-col items-center justify-center p-10 bg-slate-50 md:hidden text-center h-64">
                <div class="w-16 h-16 bg-red-100 text-red-500 rounded-full flex items-center justify-center mb-4">
                    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                </div>
                <h3 class="text-slate-800 font-bold mb-2">Documento PDF</h3>
                <p class="text-slate-500 text-sm mb-6">Abre el archivo para una lectura optimizada en tu pantalla.</p>
                
                <a 
                    href={urlCompleta} 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-6 py-3 bg-slate-900 text-white text-sm font-bold rounded-xl shadow-lg active:scale-95 transition-transform"
                >
                    Abrir en el navegador
                </a>
            </div>
        </div>

        <aside class="space-y-6 lg:sticky lg:top-32 animate-fade-in-up" style="animation-delay: 200ms">
          
          <div class="rounded-2xl bg-white border border-slate-200 p-6 shadow-sm">
            <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-slate-400 border-b border-slate-100 pb-2">
              Resumen
            </h2>
            <p class="text-slate-600 text-sm leading-relaxed mb-6">
                {doc.descripcion || "Documento oficial de la asociación."}
            </p>

            <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-slate-400 border-b border-slate-100 pb-2">
                Detalles Técnicos
            </h2>
            <dl class="space-y-3 text-sm">
                <div class="flex justify-between">
                    <dt class="text-slate-500">Formato</dt>
                    <dd class="font-bold text-slate-800">PDF</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-slate-500">Estado</dt>
                    <dd class="font-bold text-emerald-600 bg-emerald-50 px-2 rounded">Vigente</dd>
                </div>
            </dl>
          </div>

          <a
            href={urlCompleta}
            download
            class="md:hidden flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-4 py-3 text-sm font-bold text-white shadow-lg"
          >
            Descargar PDF
          </a>

        </aside>
      </div>
    </div>
    
    <div class="mt-auto pt-10">
         <WaveDivider fillColor="#0f172a" />
    </div>

  </div>
</LayoutCompetencias>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }
</style>