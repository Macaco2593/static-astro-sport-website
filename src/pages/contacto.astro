---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import Button from "src/components/UI/Button.astro";
import { ADADET_INFO } from "src/data/adadet.ts";

// Título de la página
const pageTitle = "Contacto y Denuncias | ADADET";
---

<LayoutCompetencias titulo={pageTitle}>
  
  <header class="relative bg-slate-900 py-20 px-4 text-center overflow-hidden">
    <div class="absolute inset-0 opacity-20">
        <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
            <path d="M0 100 C 20 0 50 0 100 100 Z" fill="url(#gradiente)" />
            <defs>
                <linearGradient id="gradiente" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" style="stop-color:#22d3ee;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:1" />
                </linearGradient>
            </defs>
        </svg>
    </div>

    <div class="relative z-10 max-w-3xl mx-auto space-y-4">
      <span class="text-cyan-400 font-bold tracking-widest uppercase text-sm">Estamos para escucharte</span>
      <h1 class="text-4xl md:text-5xl font-black text-white">
        Canal de Atención <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Ciudadana y Deportiva</span>
      </h1>
      <p class="text-slate-300 text-lg">
        ¿Tienes dudas sobre las competencias? ¿O deseas reportar una irregularidad?
        Utiliza este canal oficial para comunicarte con la directiva.
      </p>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 py-16 sm:px-6 lg:px-8 -mt-10">
    
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
      
      <div class="space-y-8">
        
        <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-8">
          <h3 class="text-2xl font-bold text-slate-800 mb-6">Información Oficial</h3>
          
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <div class="bg-blue-50 p-3 rounded-lg text-blue-600 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-slate-900">Sede Administrativa</p>
                <p class="text-slate-600">Av 19 de abril, en la Universidad Nacional Experimental para la Seguridad (UNES). Al lado del Parque Metropolitano<br>San Cristóbal, Estado Táchira.</p>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <div class="bg-cyan-50 p-3 rounded-lg text-cyan-600 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-slate-900">Correo Electrónico</p>
                <a href="mailto:contacto@adadet.com" class="text-cyan-700 hover:underline">{ADADET_INFO.correo}</a>
                <p class="text-xs text-slate-400 mt-1">Tiempo de respuesta: 24-48 horas hábiles.</p>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <div class="bg-green-50 p-3 rounded-lg text-green-600 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-slate-900">Atención Telefónica</p>
                <p class="text-slate-600">{ADADET_INFO.numero}</p>
                <p class="text-xs text-slate-400 mt-1">Lunes a Viernes: 8:00 AM - 5:00 PM</p>
              </div>
            </li>

            <li class="flex items-start gap-4 pt-2 border-t border-slate-100">
                <div class="bg-indigo-50 p-3 rounded-lg text-indigo-600 shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                    </svg>
                </div>
                <div>
                  <p class="font-bold text-slate-900 mb-2">Síguenos en Redes</p>
                  
                  <div class="flex items-center gap-4">
                    <a href={ADADET_INFO.facebook || "#"} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-[#1877F2] transition-transform hover:scale-110 duration-300" title="Facebook">
                        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
                        </svg>
                    </a>

                    <a href={ADADET_INFO.instagram || "#"} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-[#E4405F] transition-transform hover:scale-110 duration-300" title="Instagram">
                        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.272 2.695.072 7.053.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.947.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.947-.072 4.358-.2 6.78-2.618 6.98-6.98.058-1.28.072-1.689.072-4.947 0-3.259-.014-3.668-.072-4.947-.2-4.358-2.618-6.78-6.98-6.98C15.668.014 15.259 0 12 0zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                        </svg>
                    </a>
                  </div>
                </div>
            </li>

          </ul>

          <div class="mt-8 rounded-xl overflow-hidden shadow-inner border border-slate-200 h-48 bg-slate-100 relative group">
            
            <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3039.605911601688!2d-72.21978597806432!3d7.7602552563847205!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e666cb0a9484f63%3A0x532fa05a41be9806!2sUniversidad%20Nacional%20Experimental%20de%20la%20Seguridad!5e0!3m2!1ses!2sve!4v1770513047917!5m2!1ses!2sve" 
                width="100%" 
                height="100%" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy"
                class="grayscale group-hover:grayscale-0 transition-all duration-500"
            ></iframe>
          </div>
        </div>

      </div>

      <div class="bg-white rounded-2xl shadow-xl border border-slate-100 p-8 lg:p-10 relative">
        
        <div class="absolute top-0 right-0 bg-orange-100 text-orange-700 text-xs font-bold px-3 py-1 rounded-bl-xl rounded-tr-xl border-l border-b border-orange-200">
            CONFIDENCIAL
        </div>

        <h2 class="text-2xl font-bold text-slate-800 mb-2">Envíanos un Mensaje</h2>
        <p class="text-slate-500 text-sm mb-8">
          Completa el formulario a continuación. Si tu solicitud es una denuncia, tus datos serán tratados con estricta confidencialidad.
        </p>

        <form id="contactForm" method="POST" class="space-y-6">
          
          <div class="grid md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="nombre" class="text-sm font-semibold text-slate-700">Nombre Completo</label>
              <input 
                type="text" 
                id="nombre" 
                name="nombre" 
                placeholder="Juan Pérez"
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 transition-all outline-none"
              />
            </div>
             <div class="space-y-2">
              <label for="telefono" class="text-sm font-semibold text-slate-700">Teléfono</label>
              <input 
                type="tel" 
                id="telefono" 
                name="telefono" 
                placeholder="0414-..."
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 transition-all outline-none"
              />
            </div>
          </div>

          <div class="space-y-2">
            <label for="email" class="text-sm font-semibold text-slate-700">Correo Electrónico <span class="text-red-500">*</span></label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required
              placeholder="juan@ejemplo.com"
              class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 transition-all outline-none"
            />
          </div>

          <div class="space-y-2">
            <label for="asunto" class="text-sm font-semibold text-slate-700">Tipo de Solicitud</label>
            <div class="relative">
              <select 
                id="asunto" 
                name="asunto" 
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 transition-all outline-none appearance-none bg-white"
              >
                <option value="info">Información General</option>
                <option value="inscripcion">Dudas sobre Inscripciones</option>
                <option value="tecnico">Soporte Técnico / Web</option>
                <hr disabled>
                <option value="denuncia_admin" class="font-bold text-red-600">⚠ Denuncia Administrativa</option>
                <option value="denuncia_etica" class="font-bold text-red-600">⚠ Denuncia Ética / Disciplinaria</option>
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-500">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <label for="mensaje" class="text-sm font-semibold text-slate-700">Mensaje o Detalle de la Denuncia <span class="text-red-500">*</span></label>
            <textarea 
              id="mensaje" 
              name="mensaje" 
              rows="5" 
              required
              placeholder="Describe tu situación con el mayor detalle posible..."
              class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 transition-all outline-none resize-none"
            ></textarea>
          </div>

          <div class="flex items-start gap-3">
             <input type="checkbox" id="legal" required class="mt-1 w-4 h-4 text-cyan-600 rounded border-slate-300 focus:ring-cyan-500">
             <label for="legal" class="text-sm text-slate-500">
               Certifico que la información suministrada es veraz y acepto ser contactado por la asociación para el seguimiento del caso.
             </label>
          </div>
          
          <div id="formStatus" class="mb-4"></div>

          <button 
            type="submit"
            class="group w-full py-4 flex items-center justify-center gap-2 bg-slate-900 text-white font-bold rounded-xl hover:bg-slate-800 transition-all duration-300 hover:shadow-lg disabled:opacity-70 disabled:cursor-not-allowed"
            >
            <span>Enviar Solicitud</span>
            <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </button>
          

        </form>
      </div>

    </div>
  </main>

  <section class="bg-slate-100 py-16 mt-20 border-t border-slate-200">
     <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-2xl font-bold text-slate-800 mb-8">Preguntas Frecuentes</h2>
        <div class="grid md:grid-cols-2 gap-6 text-left">
           <div class="bg-white p-6 rounded-xl shadow-sm">
              <h4 class="font-bold text-slate-900 mb-2">¿Las denuncias pueden ser anónimas?</h4>
              <p class="text-sm text-slate-600">Sí, puedes dejar el campo de nombre en blanco, aunque recomendamos dejar un correo para poder informarte de la resolución.</p>
           </div>
           <div class="bg-white p-6 rounded-xl shadow-sm">
              <h4 class="font-bold text-slate-900 mb-2">¿Dónde están ubicados?</h4>
              <p class="text-sm text-slate-600">Nuestras oficinas se encuentran dentro del Complejo de Piscinas del Parque Metropolitano.</p>
           </div>
        </div>
     </div>
  </section>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement;
  const statusDiv = document.getElementById("formStatus"); 

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const submitBtn = form.querySelector("button[type='submit']") as HTMLButtonElement;
      const originalText = submitBtn.innerHTML;

      // Estado de "Enviando..."
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="animate-spin h-5 w-5 mr-3" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg> Enviando...`;

      try {
        const response = await fetch("/api/sendEmails", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();

        if (response.ok) {
          form.reset();
          if(statusDiv) statusDiv.innerHTML = `<p class="text-green-600 font-bold bg-green-100 p-3 rounded mb-4 border border-green-200">✅ ¡Mensaje enviado con éxito! Gracias por contactarnos.</p>`;
          // Remover alerta invasiva del navegador si prefieres solo el mensaje en el div
          // alert("¡Mensaje enviado con éxito! Gracias por contactarnos."); 
        } else {
          if(statusDiv) statusDiv.innerHTML = `<p class="text-red-600 font-bold bg-red-100 p-3 rounded mb-4 border border-red-200">❌ Error: ${data.message}</p>`;
        }
      } catch (error) {
        console.error(error);
        if(statusDiv) statusDiv.innerHTML = `<p class="text-red-600 font-bold bg-red-100 p-3 rounded mb-4 border border-red-200">❌ Hubo un error de conexión.</p>`;
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  }
</script>

</LayoutCompetencias>