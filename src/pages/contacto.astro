---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";

// Título de la página
const pageTitle = "Contacto y Denuncias | ADADET";
---

<LayoutCompetencias titulo={pageTitle}>
  
  <header class="relative bg-slate-900 py-20 px-4 text-center overflow-hidden">
    <div class="absolute inset-0 opacity-20">
        <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
            <path d="M0 100 C 20 0 50 0 100 100 Z" fill="url(#gradiente)" />
            <defs>
                <linearGradient id="gradiente" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" style="stop-color:#22d3ee;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:1" />
                </linearGradient>
            </defs>
        </svg>
    </div>

    <div class="relative z-10 max-w-3xl mx-auto space-y-4">
      <span class="text-cyan-400 font-bold tracking-widest uppercase text-sm">Estamos para escucharte</span>
      <h1 class="text-4xl md:text-5xl font-black text-white">
        Canal de Atención <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Ciudadana y Deportiva</span>
      </h1>
      <p class="text-slate-300 text-lg">
        ¿Tienes dudas sobre las competencias? ¿O deseas reportar una irregularidad?
        Utiliza este canal oficial para comunicarte con la directiva.
      </p>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 py-16 sm:px-6 lg:px-8 -mt-10">
    
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
      
      <div class="space-y-8">
        
        <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-8">
          <h3 class="text-2xl font-bold text-slate-800 mb-6">Información Oficial</h3>
          
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <div class="bg-blue-50 p-3 rounded-lg text-blue-600 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-slate-900">Sede Administrativa</p>
                <p class="text-slate-600">Av 19 de abril, en la Universidad Nacional Experimental para la Seguridad (UNES). Al lado del Parque Metropolitano<br>San Cristóbal, Estado Táchira.</p>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <div class="bg-cyan-50 p-3 rounded-lg text-cyan-600 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-slate-900">Correo Electrónico</p>
                <a href="mailto:contacto@adadet.com" class="text-cyan-700 hover:underline">contacto@adadet.com</a>
                <p class="text-xs text-slate-400 mt-1">Tiempo de respuesta: 24-48 horas hábiles.</p>
              </div>
            </li>

            <li class="flex items-start gap-4">
              <div class="bg-green-50 p-3 rounded-lg text-green-600 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-slate-900">Atención Telefónica</p>
                <p class="text-slate-600">+58 (424) 123-4567</p>
                <p class="text-xs text-slate-400 mt-1">Lunes a Viernes: 8:00 AM - 5:00 PM</p>
              </div>
            </li>
          </ul>

          <div class="mt-8 rounded-xl overflow-hidden shadow-inner border border-slate-200 h-48 bg-slate-100 relative group">
            
            <iframe 
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3039.605911601688!2d-72.21978597806432!3d7.7602552563847205!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e666cb0a9484f63%3A0x532fa05a41be9806!2sUniversidad%20Nacional%20Experimental%20de%20la%20Seguridad!5e0!3m2!1ses!2sve!4v1770513047917!5m2!1ses!2sve" 
                width="100%" 
                height="100%" 
                style="border:0;" 
                allowfullscreen="" 
                loading="lazy"
                class="grayscale group-hover:grayscale-0 transition-all duration-500"
            ></iframe>
          </div>
        </div>

      </div>

      <div class="bg-white rounded-2xl shadow-xl border border-slate-100 p-8 lg:p-10 relative">
        
        <div class="absolute top-0 right-0 bg-orange-100 text-orange-700 text-xs font-bold px-3 py-1 rounded-bl-xl rounded-tr-xl border-l border-b border-orange-200">
           CONFIDENCIAL
        </div>

        <h2 class="text-2xl font-bold text-slate-800 mb-2">Envíanos un Mensaje</h2>
        <p class="text-slate-500 text-sm mb-8">
          Completa el formulario a continuación. Si tu solicitud es una denuncia, tus datos serán tratados con estricta confidencialidad.
        </p>

        <form id="contactForm" method="POST" class="space-y-6">
          
          <div class="grid md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="nombre" class="text-sm font-semibold text-slate-700">Nombre Completo</label>
              <input 
                type="text" 
                id="nombre" 
                name="nombre" 
                placeholder="Juan Pérez"
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 transition-all outline-none"
              />
            </div>
             <div class="space-y-2">
              <label for="telefono" class="text-sm font-semibold text-slate-700">Teléfono</label>
              <input 
                type="tel" 
                id="telefono" 
                name="telefono" 
                placeholder="0414-..."
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 transition-all outline-none"
              />
            </div>
          </div>

          <div class="space-y-2">
            <label for="email" class="text-sm font-semibold text-slate-700">Correo Electrónico <span class="text-red-500">*</span></label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required
              placeholder="juan@ejemplo.com"
              class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 transition-all outline-none"
            />
          </div>

          <div class="space-y-2">
            <label for="asunto" class="text-sm font-semibold text-slate-700">Tipo de Solicitud</label>
            <div class="relative">
              <select 
                id="asunto" 
                name="asunto" 
                class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 transition-all outline-none appearance-none bg-white"
              >
                <option value="info">Información General</option>
                <option value="inscripcion">Dudas sobre Inscripciones</option>
                <option value="tecnico">Soporte Técnico / Web</option>
                <hr disabled>
                <option value="denuncia_admin" class="font-bold text-red-600">⚠ Denuncia Administrativa</option>
                <option value="denuncia_etica" class="font-bold text-red-600">⚠ Denuncia Ética / Disciplinaria</option>
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-500">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <label for="mensaje" class="text-sm font-semibold text-slate-700">Mensaje o Detalle de la Denuncia <span class="text-red-500">*</span></label>
            <textarea 
              id="mensaje" 
              name="mensaje" 
              rows="5" 
              required
              placeholder="Describe tu situación con el mayor detalle posible..."
              class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-200 transition-all outline-none resize-none"
            ></textarea>
          </div>

          <div class="flex items-start gap-3">
             <input type="checkbox" id="legal" required class="mt-1 w-4 h-4 text-cyan-600 rounded border-slate-300 focus:ring-cyan-500">
             <label for="legal" class="text-sm text-slate-500">
               Certifico que la información suministrada es veraz y acepto ser contactado por la asociación para el seguimiento del caso.
             </label>
          </div>

          <button 
            type="submit" 
            class="w-full bg-slate-900 text-white font-bold py-4 rounded-xl shadow-lg hover:bg-cyan-600 hover:shadow-cyan-500/30 transform hover:-translate-y-1 transition-all duration-300 flex justify-center items-center gap-2"
          >
            <span>Enviar Solicitud</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

        </form>
      </div>

    </div>
  </main>

  <section class="bg-slate-100 py-16 mt-20 border-t border-slate-200">
     <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-2xl font-bold text-slate-800 mb-8">Preguntas Frecuentes</h2>
        <div class="grid md:grid-cols-2 gap-6 text-left">
           <div class="bg-white p-6 rounded-xl shadow-sm">
              <h4 class="font-bold text-slate-900 mb-2">¿Las denuncias pueden ser anónimas?</h4>
              <p class="text-sm text-slate-600">Sí, puedes dejar el campo de nombre en blanco, aunque recomendamos dejar un correo para poder informarte de la resolución.</p>
           </div>
           <div class="bg-white p-6 rounded-xl shadow-sm">
              <h4 class="font-bold text-slate-900 mb-2">¿Dónde están ubicados?</h4>
              <p class="text-sm text-slate-600">Nuestras oficinas se encuentran dentro del Complejo de Piscinas del Parque Metropolitano.</p>
           </div>
        </div>
     </div>
  </section>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement;
  // Asegúrate de agregar este ID a tu div de mensajes: <div id="formStatus"></div>
  const statusDiv = document.getElementById("formStatus"); 

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const submitBtn = form.querySelector("button[type='submit']") as HTMLButtonElement;
      const originalText = submitBtn.innerHTML;

      // Estado de "Enviando..."
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="animate-spin h-5 w-5 mr-3" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg> Enviando...`;

      try {
        const response = await fetch("/api/sendEmails", {
          method: "POST",
          body: formData,
        });

        const data = await response.json();

        if (response.ok) {
          form.reset();
          alert("¡Mensaje enviado con éxito! Gracias por contactarnos.");
          if(statusDiv) statusDiv.innerHTML = `<p class="text-green-600 font-bold bg-green-100 p-3 rounded">✅ Enviado correctamente</p>`;
        } else {
          alert("Error: " + data.message);
          if(statusDiv) statusDiv.innerHTML = `<p class="text-red-600 font-bold bg-red-100 p-3 rounded">❌ Error: ${data.message}</p>`;
        }
      } catch (error) {
        console.error(error);
        alert("Hubo un error de conexión.");
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  }
</script>

</LayoutCompetencias>