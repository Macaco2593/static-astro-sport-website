---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import PageHero from "../components/UI/PageHero.astro";
import WaveDivider from "../components/UI/WaveDivider.astro";
import { ADADET_INFO } from "src/data/adadet";
import { ORGANIGRAMA_NIVELES } from "src/data/organigrama";
import { ROUTES } from "src/data/routes";
import { DOCUMENTOS_SLUG } from "src/data/documentos";

const pageTitle = "¿Quiénes Somos? | ADADET";
const pageDescription = "Conoce la historia, misión y directiva de ADADET. Trabajamos para promover y desarrollar los deportes acuáticos en todo el estado Táchira."


---

<LayoutCompetencias titulo={pageTitle} descripcion={pageDescription} footerDecoration={false}>
  
  <div class="bg-slate-50 min-h-screen relative overflow-x-hidden">

    <PageHero 
        title="Sobre"
        gradientText="ADADET"
        subtitle="Trabajamos por el crecimiento, la organización y la proyección de las disciplinas acuáticas en el Táchira, articulando esfuerzos con clubes, entrenadores y atletas."
        badge="Nuestra Institución"
    />

    <div class="relative z-20 mx-auto max-w-7xl px-4 -mt-20 pb-20 space-y-24">
        
        <section class="grid md:grid-cols-2 gap-8 animate-fade-in-up">
            
            <article class="group relative bg-white rounded-3xl p-8 shadow-xl shadow-slate-900/10 overflow-hidden hover:-translate-y-2 transition-all duration-300">
                <div class="absolute top-0 right-0 w-32 h-32 bg-cyan-50 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
                <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-cyan-400 to-blue-500"></div>

                <div class="relative z-10">
                    <div class="w-14 h-14 bg-cyan-100 rounded-2xl flex items-center justify-center text-cyan-600 mb-6 group-hover:bg-cyan-600 group-hover:text-white transition-colors duration-300">
                        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    </div>
                    
                    <h2 class="text-2xl font-black font-display text-slate-900 mb-4">Misión</h2>
                    <p class="text-slate-600 leading-relaxed">
                        {ADADET_INFO.mision}
                    </p>
                </div>
            </article>

            <article class="group relative bg-white rounded-3xl p-8 shadow-xl shadow-slate-900/10 overflow-hidden hover:-translate-y-2 transition-all duration-300">
                <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-50 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
                <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-blue-500 to-indigo-600"></div>

                <div class="relative z-10">
                    <div class="w-14 h-14 bg-indigo-100 rounded-2xl flex items-center justify-center text-indigo-600 mb-6 group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-300">
                        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                    </div>
                    
                    <h2 class="text-2xl font-black font-display text-slate-900 mb-4">Visión</h2>
                    <p class="text-slate-600 leading-relaxed">
                        {ADADET_INFO.vision}
                    </p>
                </div>
            </article>

        </section>

        <section class="animate-fade-in-up" style="animation-delay: 200ms">
            
            {/*<div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 border-b border-slate-200 pb-8">
                <div>
                    <div class="inline-flex items-center gap-2 mb-2">
                        <span class="w-8 h-1 bg-adadet-main rounded-full"></span>
                        <span class="text-xs font-bold uppercase tracking-widest text-slate-400">Estructura</span>
                    </div>
                    <h2 class="text-3xl md:text-4xl font-black font-display text-slate-900">
                        Organigrama Oficial
                    </h2>
                </div>

                <div class="flex flex-wrap gap-3">
                    <!-- <a
                        href={ROUTES.documento(DOCUMENTOS_SLUG.ORGANIGRAMA_ASOCIACION)}
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-100 text-slate-700 font-bold text-sm hover:bg-slate-200 transition-colors"
                    >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                        Ver Documento
                    </a>
                    <a
                        href={ADADET_INFO.organigramaPdfUrl}
                        target="_blank"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 text-white font-bold text-sm shadow-lg shadow-slate-900/20 hover:bg-adadet-main transition-all hover:-translate-y-1"
                    >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                        Descargar PDF
                    </a> -->
                    <a
                        href={"#"}
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-100 text-slate-700 font-bold text-sm hover:bg-slate-200 transition-colors"
                    >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                        Ver Documento
                    </a>
                    <a
                        href={"#"}
                        target="_blank"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 text-white font-bold text-sm shadow-lg shadow-slate-900/20 hover:bg-adadet-main transition-all hover:-translate-y-1"
                    >
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                        Descargar PDF
                    </a>
                </div>
            </div>

            <div class="space-y-12">
                {ORGANIGRAMA_NIVELES.map((nivel) => (
                    <div class="bg-white rounded-[2rem] p-8 border border-slate-100 shadow-sm">
                        <h3 class="flex items-center gap-3 text-lg font-bold text-slate-400 uppercase tracking-widest mb-8">
                            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                            {nivel.titulo}
                        </h3>

                        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                            {nivel.cargos.map((cargo) => (
                                <article class="group p-5 rounded-2xl bg-slate-50 border border-slate-100 hover:bg-white hover:shadow-lg hover:shadow-cyan-900/5 hover:border-cyan-100 transition-all duration-300">
                                    
                                    <div class="flex items-start justify-between mb-2">
                                        <div class="p-2 bg-white rounded-lg shadow-sm text-slate-400 group-hover:text-cyan-500 transition-colors">
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                        </div>
                                    </div>

                                    <h4 class="text-sm font-bold text-slate-500 uppercase tracking-wide mb-1">
                                        {cargo.rol}
                                    </h4>
                                    
                                    {cargo.persona ? (
                                        <p class="text-lg font-black text-slate-900 group-hover:text-adadet-main transition-colors">
                                            {cargo.persona}
                                        </p>
                                    ) : (
                                        <p class="text-sm italic text-slate-400">Por designar</p>
                                    )}

                                    {cargo.descripcion && (
                                        <p class="mt-3 text-sm text-slate-500 border-t border-slate-200 pt-3 leading-relaxed">
                                            {cargo.descripcion}
                                        </p>
                                    )}
                                </article>
                            ))}
                        </div>
                    </div>
                ))}
            </div>  */}

        </section>

    </div>

    <div class="relative pt-10">
         <WaveDivider fillColor="#0f172a" />
    </div>

  </div>
</LayoutCompetencias>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }
</style>