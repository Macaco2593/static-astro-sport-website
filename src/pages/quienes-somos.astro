---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import { ADADET_INFO } from "src/data/adadet";
import { ORGANIGRAMA_NIVELES } from "src/data/organigrama";

const ORGANIGRAMA_PAGE_URL = "/documentos/organigrama-asociacion";
---

<LayoutCompetencias titulo="¿Quiénes somos? | ADADET">
  <div class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-cyan-50">
    <div class="mx-auto max-w-6xl px-4 py-10 md:py-16 space-y-12">
      <!-- Hero -->
      <header class="relative overflow-hidden rounded-3xl bg-white/70 p-8 shadow-md ring-1 ring-slate-200 md:p-12">
        <div class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-gradient-to-br from-cyan-300/40 to-blue-400/40 blur-2xl"></div>
        <div class="pointer-events-none absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-gradient-to-br from-blue-300/30 to-indigo-400/30 blur-2xl"></div>

        <div class="relative space-y-4">
          <div class="inline-flex items-center gap-2 rounded-full bg-blue-100 px-4 py-1.5 text-xs font-semibold tracking-wide text-blue-700">
            <span class="inline-flex h-2 w-2 rounded-full bg-cyan-500"></span>
            Sobre ADADET
          </div>

          <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 md:text-5xl">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-cyan-500 to-blue-700">
              ¿Quiénes somos?
            </span>
          </h1>

          <p class="max-w-3xl text-sm leading-relaxed text-slate-600 md:text-base">
            La <span class="font-semibold text-slate-800">Asociación de Deportes Acuáticos del Estado Táchira (ADADET)</span>
            trabaja por el crecimiento, la organización y la proyección de las disciplinas acuáticas, articulando esfuerzos con
            clubes, entrenadores, atletas y aliados institucionales.
          </p>
        </div>
      </header>

      <!-- Misión y Visión -->
      <section aria-labelledby="mision-vision" class="space-y-6">
        <div class="flex items-end justify-between gap-6">
          <h2 id="mision-vision" class="text-xl font-extrabold tracking-tight text-slate-900 md:text-2xl">
            Misión y visión
          </h2>
          <p class="hidden text-sm text-slate-500 md:block">
            Puedes editar estos textos en <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">src/data/adadet.ts</code>.
          </p>
        </div>

        <div class="grid gap-5 lg:grid-cols-2">
          <article class="group relative overflow-hidden rounded-3xl bg-white p-6 shadow-md ring-1 ring-slate-200 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:ring-cyan-300">
            <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-cyan-500 via-blue-500 to-indigo-500 opacity-70"></div>
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl bg-cyan-50 ring-1 ring-cyan-200">
                <svg class="h-6 w-6 text-cyan-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2l3 7 7 3-7 3-3 7-3-7-7-3 7-3 3-7z" />
                </svg>
              </div>
              <div class="space-y-2">
                <h3 class="text-lg font-bold text-slate-900">Misión</h3>
                <p class="text-sm leading-relaxed text-slate-600 md:text-base">
                  {ADADET_INFO.mision}
                </p>
              </div>
            </div>
          </article>

          <article class="group relative overflow-hidden rounded-3xl bg-white p-6 shadow-md ring-1 ring-slate-200 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:ring-blue-300">
            <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-blue-600 via-cyan-500 to-blue-700 opacity-70"></div>
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl bg-blue-50 ring-1 ring-blue-200">
                <svg class="h-6 w-6 text-blue-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 20l9-5-9-5-9 5 9 5z" />
                  <path d="M12 12l9-5-9-5-9 5 9 5z" />
                </svg>
              </div>
              <div class="space-y-2">
                <h3 class="text-lg font-bold text-slate-900">Visión</h3>
                <p class="text-sm leading-relaxed text-slate-600 md:text-base">
                  {ADADET_INFO.vision}
                </p>
              </div>
            </div>
          </article>
        </div>
      </section>

      <!-- Organigrama -->
      <section aria-labelledby="organigrama" class="space-y-6">
        <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
          <div class="space-y-2">
            <h2 id="organigrama" class="text-xl font-extrabold tracking-tight text-slate-900 md:text-2xl">
              Organigrama de la asociación
            </h2>
            <p class="max-w-3xl text-sm text-slate-600 md:text-base">
              Estructura organizativa presentada en formato accesible. Puedes editar cargos y nombres en
              <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">src/data/organigrama.ts</code>.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <a
              href={ORGANIGRAMA_PAGE_URL}
              class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-800 shadow-sm ring-1 ring-slate-200 transition-all hover:-translate-y-0.5 hover:shadow-md"
            >
              Ver documento (visor PDF)
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16v12H4z" />
                <path d="M8 18h8" />
                <path d="M10 22h4" />
              </svg>
            </a>

            <a
              href={ADADET_INFO.organigramaPdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-cyan-600 to-blue-700 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:from-cyan-700 hover:to-blue-800 hover:-translate-y-0.5 hover:shadow-md"
            >
              Descargar PDF
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3v12" />
                <path d="M7 10l5 5 5-5" />
                <path d="M5 21h14" />
              </svg>
            </a>
          </div>
        </div>

        <div class="space-y-5">
          {ORGANIGRAMA_NIVELES.map((nivel) => (
            <section class="rounded-3xl bg-white p-6 shadow-md ring-1 ring-slate-200">
              <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">
                {nivel.titulo}
              </h3>

              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {nivel.cargos.map((cargo) => (
                  <article class="group rounded-2xl bg-slate-50 p-4 ring-1 ring-slate-200 transition-all hover:-translate-y-0.5 hover:bg-white hover:shadow-sm hover:ring-cyan-300">
                    <p class="text-sm font-bold text-slate-900">
                      {cargo.rol}
                    </p>

                    {cargo.persona && (
                      <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-cyan-700">
                        {cargo.persona}
                      </p>
                    )}

                    {cargo.descripcion && (
                      <p class="mt-2 text-sm text-slate-600">
                        {cargo.descripcion}
                      </p>
                    )}
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>
    </div>
  </div>
</LayoutCompetencias>
