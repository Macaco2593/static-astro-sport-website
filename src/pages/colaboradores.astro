---
import LayoutCompetencias from "../layouts/LayoutCompetencias.astro";
import { COLABORADORES as listaColaboradores } from "src/data/colaboradores"; 
import PageHero from "../components/UI/PageHero.astro";
import WaveDivider from "../components/UI/WaveDivider.astro";
import { Image } from "astro:assets";
import { ROUTES } from "src/data/routes";

const pageTitle = "Colaboradores y Aliados | ADADET";
const pageDescription = "Conoce a las empresas e instituciones que apoyan el deporte acuático en Táchira. Gracias a nuestros aliados por impulsar el talento regional."
---

<LayoutCompetencias titulo={pageTitle} descripcion={pageDescription} footerDecoration={false}>
  
  <div class="bg-slate-50 min-h-screen relative overflow-x-hidden">

    <PageHero 
        title="Nuestros"
        gradientText="Aliados"
        subtitle="Este espacio reconoce a las instituciones, empresas y organizaciones que hacen posible el crecimiento de los deportes acuáticos en el Táchira."
        badge="Red de Patrocinadores"
    />

    <div class="relative z-20 mx-auto max-w-7xl px-4 -mt-20 pb-20">
        
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {listaColaboradores.map((colab, index) => (
            <article
              class="group relative flex flex-col bg-white rounded-2xl shadow-xl shadow-slate-900/10 border border-slate-100 overflow-hidden hover:-translate-y-2 transition-all duration-300 animate-fade-in-up"
              style={`animation-delay: ${index * 100}ms`}
            >
              <div class="h-1 w-full bg-gradient-to-r from-cyan-400 to-blue-600 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></div>

              <div class="relative bg-slate-50/50 p-8 flex items-center justify-center border-b border-slate-100 h-48 group-hover:bg-slate-50 transition-colors">
                 
                 <div class="relative h-40 flex justify-center items-center transition-transform duration-500 group-hover:scale-110 filter grayscale group-hover:grayscale-0 opacity-80 group-hover:opacity-100">
                    {colab.logo ? (
                        <Image
                          src={colab.logo}
                          alt={colab.nombre}
                          class="h-full w-auto object-contain drop-shadow-sm" 
                          loading="lazy"
                        />
                      ) : (
                        <div class="flex items-center justify-center h-24 w-full text-slate-400 font-bold text-center border-2 border-dashed border-slate-300 rounded-lg p-4">
                            {colab.nombre}
                        </div>
                      )}
                 </div>

                 <div class="absolute top-4 right-4">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wide bg-white border border-slate-200 text-slate-500 shadow-sm">
                        {colab.rol}
                    </span>
                 </div>
              </div>

              <div class="flex flex-1 flex-col p-6">
                
                <h2 class="text-xl font-bold text-slate-800 mb-3 group-hover:text-adadet-main transition-colors">
                  {colab.nombre}
                </h2>
                
                <p class="text-sm text-slate-600 leading-relaxed mb-6 line-clamp-3 flex-grow">
                  {colab.descripcion}
                </p>

                {colab.url && colab.url !== "#" ? (
                  <a
                    href={colab.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-auto inline-flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-slate-50 text-slate-600 text-sm font-bold transition-all duration-200 hover:bg-adadet-main hover:text-white group-hover:shadow-md"
                  >
                    Visitar Sitio Web
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                ) : (
                   <div class="mt-auto pt-4 border-t border-slate-50 text-xs text-slate-400 font-medium text-center">
                       Aliado Oficial ADADET
                   </div>
                )}
              </div>
            </article>
          ))}
        </div>
        
        <div class="mt-20 text-center animate-fade-in-up" style="animation-delay: 400ms">
            <div class="inline-block p-8 rounded-3xl bg-white border border-slate-100 shadow-xl shadow-slate-200/50 max-w-2xl mx-auto">
                <h3 class="text-2xl font-bold text-slate-900 mb-2">¿Quieres ser parte de nuestro equipo?</h3>
                <p class="text-slate-600 mb-6">Únete a la red de aliados que impulsan el deporte en el estado Táchira.</p>
                <a href={ROUTES.CONTACTO} class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-bold rounded-full text-white bg-slate-900 hover:bg-slate-800 transition-colors shadow-lg shadow-slate-900/20 hover:shadow-xl">
                    Contáctanos
                </a>
            </div>
        </div>

    </div>

    <div class="relative pt-10">
         <WaveDivider fillColor="#0f172a" />
    </div>

  </div>
</LayoutCompetencias>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }
</style>