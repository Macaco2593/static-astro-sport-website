---
import LayoutCompetencias from 'src/layouts/LayoutCompetencias.astro';
import { ListaCompetencias } from '../../data/listaCompetencias';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  return ListaCompetencias.map((competencia) => {
    const slug = competencia.linkDeLaCompetencia.replace('/competencias_pdf/', '').replace('.html', '');
    return {
      params: { slug },
      props: { competencia }
    };
  });
}

const { competencia } = Astro.props;

if (!competencia) {
  return Astro.redirect('/');
}

const getDateParts = (fecha: string) => {
    const [day, month, year] = fecha.split('/');
    const monthNames = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'];
    return { day, month: monthNames[parseInt(month) - 1], year };
};

const fechaInicio = getDateParts(competencia.fechaInicio);
const fechaFin = getDateParts(competencia.fechaFinalizacion);
const { slug } = Astro.params;
console.log("Resultados de esta competencia:", competencia.resultados);
---

<LayoutCompetencias titulo={`${competencia.titulo} | Resultados Oficiales`} footerDecoration={false}>
  
  <div class="relative pt-32 pb-48 overflow-hidden bg-slate-900">
        
        <div class="absolute inset-0 z-0">
             <Image 
                src={competencia.img} 
                inferSize={true}
                alt="Fondo Ambiental" 
                class="w-full h-full object-cover opacity-100 blur-xl scale-110"
             />
             <div class="absolute inset-0 bg-gradient-to-b from-slate-900/90 via-slate-900/60 to-slate-900"></div>
             <div class="absolute inset-0 bg-blue-900/20 mix-blend-overlay"></div>
        </div>

        <div class="relative z-10 container mx-auto px-4 text-center max-w-5xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/20 bg-white/5 backdrop-blur-md mb-6 animate-fade-in-down">
                <span class="w-2 h-2 rounded-full bg-adadet-main animate-pulse"></span>
                <span class="text-xs font-bold text-cyan-200 uppercase tracking-widest">
                    Evento Oficial
                </span>
            </div>

            <h1 class="text-4xl md:text-5xl lg:text-7xl font-black font-display text-white mb-8 leading-tight drop-shadow-2xl animate-fade-in-up">
                {competencia.titulo}
            </h1>
            
             <div class="inline-flex flex-wrap justify-center gap-4 md:gap-8 animate-fade-in-up" style="animation-delay: 200ms;">
                
                {/* Fecha Inicio */}
                <div class="flex items-center gap-3 bg-white/10 border border-white/10 backdrop-blur-md px-5 py-3 rounded-2xl shadow-lg">
                    <div class="flex flex-col items-center justify-center w-12 h-12 bg-green-500/20 text-green-400 rounded-xl border border-green-500/30">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    </div>
                    <div class="text-left">
                        <p class="text-xs text-slate-300 font-bold uppercase tracking-wider">Inicia</p>
                        <p class="text-xl font-bold text-white leading-none">
                            {fechaInicio.day} <span class="text-base font-normal text-slate-300">{fechaInicio.month}</span>
                        </p>
                    </div>
                </div>

                {/* Flecha */}
                <div class="hidden md:flex items-center text-white/50">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </div>

                {/* Fecha Fin */}
                <div class="flex items-center gap-3 bg-white/10 border border-white/10 backdrop-blur-md px-5 py-3 rounded-2xl shadow-lg">
                    <div class="flex flex-col items-center justify-center w-12 h-12 bg-red-500/20 text-red-400 rounded-xl border border-red-500/30">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <div class="text-left">
                        <p class="text-xs text-slate-300 font-bold uppercase tracking-wider">Finaliza</p>
                        <p class="text-xl font-bold text-white leading-none">
                            {fechaFin.day} <span class="text-base font-normal text-slate-300">{fechaFin.month}</span>
                        </p>
                    </div>
                </div>

            </div>
        </div>
  </div>

  <div class="container mx-auto px-4 -mt-24 relative z-20 max-w-7xl pb-24">
        
        <div class="grid lg:grid-cols-[350px_1fr] gap-8 items-start">
            
            <div class="relative group animate-fade-in-up">
                <div class="absolute -inset-1 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-2xl blur opacity-30 group-hover:opacity-50 transition-opacity"></div>
                
                {/* ID AGREGADO AQUÍ PARA EL SCRIPT */}
                <div id="btn-abrir-poster" class="relative bg-white rounded-xl overflow-hidden shadow-2xl shadow-black/50 cursor-zoom-in border-4 border-white">
                    <Image 
                        src={competencia.img} 
                        inferSize={true}
                        alt={`Poster ${competencia.titulo}`}
                        class="w-full h-auto object-cover transform transition-transform duration-500 group-hover:scale-105"
                    />
                    
                    <div class="absolute inset-0 bg-slate-900/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <span class="bg-white/20 backdrop-blur-md border border-white/30 text-white px-4 py-2 rounded-full text-sm font-bold flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>
                            Ver Poster Completo
                        </span>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/50 border border-slate-100 overflow-hidden animate-fade-in-up" style="animation-delay: 200ms;">
                
                {/* Header de Documentos */}
                <div class="bg-slate-50/80 border-b border-slate-100 px-6 py-8 md:px-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div>
                        <h2 class="text-2xl md:text-3xl font-black font-display text-slate-900 flex items-center gap-3">
                            <span class="w-2 h-8 bg-adadet-main rounded-full"></span>
                            Documentación Oficial
                        </h2>
                        <p class="text-slate-500 mt-2 ml-5">
                            Descarga los resultados y planillas oficiales de este evento.
                        </p>
                    </div>
                    
                    <div class="px-4 py-2 bg-blue-50 text-adadet-main font-bold rounded-lg text-sm border border-blue-100">
                        {competencia.resultados.length} Archivos Disponibles
                    </div>
                </div>

                {/* Grid de Archivos */}
                <div class="p-6 md:p-10 bg-white">
                    
                    {competencia.resultados.length > 0 ? (
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            
                            {/* MAPA CORREGIDO: Usando if/return para evitar errores de compilación */}
                            {competencia.resultados.map((resultado) => {
                                if (resultado.pendiente) {
                                    return (
                                        <div class="group relative flex items-start gap-4 p-5 rounded-2xl border border-slate-200 bg-slate-100 opacity-70 cursor-not-allowed">
                                            <div class="w-12 h-12 flex-shrink-0 bg-slate-200/50 rounded-xl border border-slate-200 flex items-center justify-center text-slate-400 shadow-inner">
                                                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <h3 class="font-bold text-slate-500 text-sm leading-snug mb-1 line-clamp-2">
                                                    {resultado.titulo}
                                                </h3>
                                                <p class="text-xs text-orange-500 font-bold uppercase tracking-wide flex items-center gap-1.5">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span>
                                                    Próximamente
                                                </p>
                                            </div>
                                        </div>
                                    );
                                }
                                
                                return (
                                    <a 
                                        href={`/contenido/competencias_pdf/${slug}/${resultado.nombreArchivo}`}
                                        class="group relative flex items-start gap-4 p-5 rounded-2xl border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-adadet-main/30 hover:shadow-lg hover:shadow-adadet-main/5 transition-all duration-300"
                                        target="_blank"
                                    >
                                        <div class="w-12 h-12 flex-shrink-0 bg-white rounded-xl border border-slate-100 flex items-center justify-center text-red-500 shadow-sm group-hover:scale-110 group-hover:border-red-100 group-hover:bg-red-50 transition-all duration-300">
                                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h3 class="font-bold text-slate-800 text-sm leading-snug group-hover:text-adadet-main transition-colors mb-1 line-clamp-2">
                                                {resultado.titulo}
                                            </h3>
                                            <p class="text-xs text-slate-400 font-medium uppercase tracking-wide">
                                                PDF • Descarga Directa
                                            </p>
                                        </div>
                                        <div class="absolute top-5 right-5 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                                            <svg class="w-5 h-5 text-adadet-main" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                                        </div>
                                    </a>
                                );
                            })}
                            
{/* Botón de Resultados en Vivo */}
{/* 
  Estado pendiente: Apagado y sin enlace
  Estado activo: Botón original intacto
*/}
{competencia.linkEnVivo && (
    competencia.enVivoPendiente === true ? (
        // Estado pendiente (Apagado y sin enlace)
        <div class="group relative flex items-center justify-center sm:justify-start gap-3 p-4 sm:p-5 w-full rounded-2xl border border-slate-200 bg-slate-100 opacity-70 cursor-not-allowed">
            <div class="relative flex h-3 w-3 sm:h-4 sm:w-4 flex-shrink-0">
                <span class="relative inline-flex rounded-full h-full w-full bg-slate-400"></span>
            </div>
            <span class="font-semibold text-slate-500 text-sm sm:text-base">
                Transmisión Próximamente
            </span>
        </div>
    ) : (
        // Estado activo (Botón original intacto)
        <a 
            href={competencia.linkEnVivo}
            class="group relative flex items-center justify-center sm:justify-start gap-3 p-4 sm:p-5 w-full rounded-2xl border border-emerald-500/30 bg-emerald-50 hover:bg-emerald-100 hover:-translate-y-1 hover:shadow-lg hover:shadow-emerald-500/20 transition-all duration-300"
            target="_blank"
            rel="noopener noreferrer"
        >
            <div class="relative flex h-3 w-3 sm:h-4 sm:w-4 flex-shrink-0">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-full w-full bg-red-500"></span>
            </div>
            <span class="font-semibold text-emerald-800 text-sm sm:text-base">
                Resultados en Tiempo Real
            </span>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-emerald-600 sm:ml-auto opacity-70 group-hover:opacity-100 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-300 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
        </a>
    )
)}
                        </div>
                    ) : (
                        <div class="text-center py-20">
                            <div class="inline-block p-4 rounded-full bg-slate-50 mb-4">
                                <svg class="w-8 h-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 011.414.586l4 4a1 1 0 01.586 1.414V19a2 2 0 01-2 2z" /></svg>
                            </div>
                            <h3 class="text-lg font-bold text-slate-600">Aún no hay resultados cargados</h3>
                            <p class="text-slate-400">Vuelve a consultar más tarde.</p>
                        </div>
                    )}
                    
                </div>
                
                {/* Footer de la tarjeta */}
                <div class="bg-slate-50 px-6 py-4 border-t border-slate-100 text-center">
                    <a href="/resultados" class="text-sm font-bold text-slate-500 hover:text-adadet-main transition-colors inline-flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                        Volver al Calendario de Competencias
                    </a>
                </div>

            </div>

        </div>
  </div>
    
  <div id="poster-lightbox" class="fixed inset-0 z-[9999] hidden opacity-0 transition-opacity duration-300">
        <div id="fondo-lightbox" class="absolute inset-0 bg-black/95 backdrop-blur-sm cursor-pointer"></div>
        
        {/* 🌟 Añadí flex-col aquí para apilar la imagen y el botón */}
        <div class="relative z-10 inset-0 fixed flex flex-col items-center justify-center p-4 pointer-events-none">
            <Image 
                src={competencia.img} 
                inferSize={true}
                alt="Poster Full"
                class="w-auto h-auto max-h-[85vh] max-w-[95vw] object-contain rounded-lg shadow-2xl pointer-events-auto transform scale-95 transition-transform duration-300"
                id="lightbox-img"
            />

            <a 
                href={`${competencia.img}?download=Folleto-Oficial-${competencia.titulo.replace(/\s+/g, '-')}.jpg`}
                class="mt-6 pointer-events-auto flex items-center gap-2 px-6 py-3 bg-white text-slate-900 hover:bg-cyan-50 hover:text-cyan-700 font-bold uppercase tracking-wide text-sm rounded-full transition-all duration-300 shadow-[0_0_20px_rgba(255,255,255,0.2)] hover:shadow-[0_0_25px_rgba(6,182,212,0.4)] hover:scale-105"
            >
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                Descargar Folleto Original
            </a>

            <button id="btn-cerrar-poster" class="absolute top-6 right-6 text-white pointer-events-auto p-2 bg-white/10 rounded-full hover:bg-white/20 transition-colors z-[10000]">
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
  </div>
</LayoutCompetencias>

<script>
    const lightbox = document.getElementById('poster-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const btnAbrir = document.getElementById('btn-abrir-poster');
    const btnCerrar = document.getElementById('btn-cerrar-poster');
    const fondoLightbox = document.getElementById('fondo-lightbox');

    const openLightbox = () => {
        if (!lightbox || !lightboxImg) return;
        lightbox.classList.remove('hidden');
        setTimeout(() => {
            lightbox.classList.remove('opacity-0');
            lightboxImg.classList.remove('scale-95');
            lightboxImg.classList.add('scale-100');
        }, 10);
        document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
        if (!lightbox || !lightboxImg) return;
        lightbox.classList.add('opacity-0');
        lightboxImg.classList.remove('scale-100');
        lightboxImg.classList.add('scale-95');
        setTimeout(() => {
            lightbox.classList.add('hidden');
        }, 300);
        document.body.style.overflow = '';
    };

    // Event Listeners
    if (btnAbrir) btnAbrir.addEventListener('click', openLightbox);
    if (btnCerrar) btnCerrar.addEventListener('click', closeLightbox);
    if (fondoLightbox) fondoLightbox.addEventListener('click', closeLightbox);

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
    });
</script>

<style>
  @keyframes fade-in-down { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fade-in-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  
  .animate-fade-in-down { animation: fade-in-down 0.8s ease-out; }
  .animate-fade-in-up { animation: fade-in-up 0.8s ease-out both; }
</style>