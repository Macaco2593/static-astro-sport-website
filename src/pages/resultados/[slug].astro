---
import LayoutCompetencias from 'src/layouts/LayoutCompetencias.astro';
import { ListaCompetencias } from '../../data/listaCompetencias'

export async function getStaticPaths() {
  return ListaCompetencias.map((competencia) => {
    const slug = competencia.linkDeLaCompetencia.replace('/competencias_pdf/', '').replace('.html', '');
    return {
      params: { slug },
      props: { competencia }
    };
  });
}

const { competencia } = Astro.props;
const { slug } = Astro.params
if (!competencia) {
  return Astro.redirect('/');
}


---
<LayoutCompetencias titulo={competencia.titulo}>
<div class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-cyan-50">
  <!-- Hero Section -->
  <div class="relative overflow-hidden bg-gradient-to-r from-blue-600 via-cyan-600 to-blue-700">
    <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
    <div class="container mx-auto px-4 py-16 md:py-24 relative">
      <div class="text-center text-white space-y-6">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
          {competencia.titulo}
        </h1>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 text-lg md:text-xl mt-8">
          <div class="bg-white/10 backdrop-blur-sm px-6 py-3 rounded-full border border-white/20">
            <span class="font-semibold">Inicio:</span> {competencia.fechaInicio}
          </div>
          <div class="bg-white/10 backdrop-blur-sm px-6 py-3 rounded-full border border-white/20">
            <span class="font-semibold">Finaliza:</span> {competencia.fechaFinalizacion}
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-white/20 to-transparent"></div>
  </div>

  <!-- Main Content -->
  <div class="container mx-auto px-4 py-12 md:py-20">
    <!-- Documentos Section -->
    <!-- Resultados Section -->
    <section>
      <div class="flex items-center gap-3 mb-8">
        <div class="h-1 w-12 bg-gradient-to-r from-cyan-600 to-blue-600 rounded-full"></div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800">Resultados</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        {competencia.resultados.map((resultado) => (
          <a 
            href={`/contenido/competencias_pdf/${slug}/${resultado.nombreArchivo}`}
            class="group relative bg-gradient-to-br from-cyan-50 to-blue-50 p-6 rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 border border-cyan-100 hover:border-cyan-300 hover:-translate-y-1"
            target="_blank"
          >
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-gradient-to-br from-cyan-500 to-blue-500 rounded-lg flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-gray-800 group-hover:text-cyan-700 transition-colors mb-2">
                  {resultado.titulo}
                </h3>
                <div class="flex items-center gap-2 text-cyan-600 font-medium text-sm">
                  Ver resultados
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</div>

<style>
  .bg-grid-pattern {
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 40px 40px;
  }
</style>
</LayoutCompetencias>