---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import Calendar from "src/components/Calendar.astro";
import WaveDivider from "src/components/UI/WaveDivider.astro";
import PageHero from "src/components/UI/PageHero.astro";
import ROUTES from "src/data/routes";
import { DOCUMENTOS_SLUG } from "src/data/documentos";

// 1. Importamos tu base de datos centralizada
import { ListaCompetencias } from "src/data/listaCompetencias";

// 2. Transformamos los datos automáticamente al formato del Calendario
const competitions = ListaCompetencias.map((competencia) => {
  // Convertimos la fecha de "DD/MM/YYYY" a "YYYY-MM-DD"
  const [dia, mes, anio] = competencia.fechaInicio.split('/');
  const fechaFormateada = `${anio}-${mes}-${dia}`;

  // Ponemos la primera letra del tipo en mayúscula (ej: "estadal" -> "Estadal")
  const tipoCapitalizado = competencia.tipo.charAt(0).toUpperCase() + competencia.tipo.slice(1);

  return { 
    date: fechaFormateada, 
    title: competencia.titulo, 
    type: tipoCapitalizado,
    time: '08:00 AM', 
    description: `Evento oficial de la asociación. Haz clic en la sección de Resultados para ver la convocatoria y planillas de esta competencia.`,
  };
});

const pageTitle = "Calendario Oficial | ADADET";
const pageDescription = "Consulta el calendario oficial de eventos y competencias de natación en Táchira. Fechas, sedes y horarios de la temporada actual. ¡No te lo pierdas!"
---

<LayoutCompetencias titulo={pageTitle} descripcion={pageDescription} footerDecoration={false}>
  
  <div class="relative min-h-screen bg-slate-50 overflow-x-hidden">

    <PageHero 
        title="Calendario de"
        gradientText="Competencias"
        subtitle="Planifica tu temporada. Consulta las fechas oficiales de torneos, clasificatorios y eventos de la Asociación."
        badge="Agenda 2026"
    />

    <div class="relative z-20 mx-auto max-w-5xl px-4 -mt-20 pb-20"> 
        
        <div class="animate-fade-in-up" style="animation-delay: 200ms;">
             {/* Le pasamos nuestro arreglo dinámico al calendario */}
             <Calendar events={competitions} />
        </div>

        {/* --- CONTENEDOR INFERIOR: BOTÓN FEVEDA --- */}
        {/* Lo alineamos al centro en móviles y a la derecha en PC para mejor lectura visual */}
        <div class="mt-10 flex justify-center md:justify-end animate-fade-in-up" style="animation-delay: 300ms;">

            <a 
                href={ROUTES.documento(DOCUMENTOS_SLUG.CALENDARIO_NATACION_FEVEDA_2026)}
                target="_blank"
                class="group w-full sm:w-auto flex items-center justify-center gap-3 px-6 py-3.5 md:px-8 md:py-4 bg-white border-2 border-slate-200 hover:border-cyan-500 text-slate-700 hover:text-cyan-600 font-bold text-base md:text-lg rounded-xl shadow-sm hover:shadow-cyan-500/20 transition-all active:scale-95 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2"
                aria-label="Descargar calendario nacional de FEVEDA en PDF"
            >
                {/* Icono de Documento/Descarga (También crece en PC con md:w-7 md:h-7) */}
                <svg class="w-6 h-6 md:w-7 md:h-7 text-slate-400 group-hover:text-cyan-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Ver Calendario Nacional
            </a>

        </div>

    </div>

    <div class="relative pt-10">
         <WaveDivider fillColor="#0f172a" />
    </div>

  </div>

</LayoutCompetencias>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up { 
    animation: fade-in-up 0.8s ease-out forwards; 
  }
</style>