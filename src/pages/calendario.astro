---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import Calendar from "src/components/Calendar.astro";
import WaveDivider from "src/components/UI/WaveDivider.astro";
import PageHero from "src/components/UI/PageHero.astro"; // 1. Importamos el componente

const competitions = [
  { 
    date: '2026-03-05', 
    title: 'I Estadal de Natación 2026', 
    type: 'Natación',
    time: '03:00 PM',
    description: 'Competencia estadal de apertura de temporada. Colegio de Contadores, San Cristóbal.',
  },
  { 
    date: '2026-04-14', 
    title: 'I Regional de natacion ADAEFALCON 2026', 
    type: 'Natación',
    time: '03:00 PM',
    description: 'Campeonato Regional Occidental de Natacion Falcón 2026. Complejo de piscinas libertador. Ciudad Deportiva Universitaria. Coro Estado Falcón.',
  }
];

const pageTitle = "Calendario Oficial | ADADET";
const pageDescription = "Consulta el calendario oficial de eventos y competencias de natación en Táchira. Fechas, sedes y horarios de la temporada actual. ¡No te lo pierdas!"
---

<LayoutCompetencias titulo={pageTitle} descripcion={pageDescription} footerDecoration={false}>
  
  <div class="relative min-h-screen bg-slate-50">

    <PageHero 
        title="Calendario de"
        gradientText="Competencias"
        subtitle="Planifica tu temporada. Consulta las fechas oficiales de torneos, clasificatorios y eventos de la Asociación."
        badge="Agenda 2026"
    />

    <div class="relative z-20 mx-auto max-w-7xl px-4 -mt-20 pb-20"> 
        
        <div class="animate-fade-in-up" style="animation-delay: 200ms;">
             <Calendar events={competitions} />
        </div>

        <div class="mt-8 flex flex-wrap justify-center gap-6 md:gap-8 animate-fade-in-up" style="animation-delay: 300ms;">
            <div class="flex items-center gap-2 text-sm text-slate-600 font-medium">
               <span class="w-3 h-3 rounded-full bg-adadet-main shadow-sm shadow-adadet-main/40"></span>
               Día con Evento
            </div>
            <div class="flex items-center gap-2 text-sm text-slate-600 font-medium">
               <span class="w-3 h-3 rounded-full bg-blue-50 border border-blue-200"></span>
               Hoy
            </div>
        </div>

    </div>

    <div class="relative pt-10">
         <WaveDivider fillColor="#0f172a" />
    </div>

  </div>
</LayoutCompetencias>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up { 
    animation: fade-in-up 0.8s ease-out forwards; 
  }
</style>