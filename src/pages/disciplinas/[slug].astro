---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import { BASE_DISCIPLINAS, type DisciplinaBase } from "../../data/disciplinas";
import { Image } from "astro:assets";
import WaveDivider from "../../components/UI/WaveDivider.astro";

export function getStaticPaths() {
  return BASE_DISCIPLINAS.map((disciplina) => ({
    params: { slug: disciplina.slug },
    props: { disciplina },
  }));
}

interface Props {
  disciplina: DisciplinaBase;
  image?: ImageMetadata;
}

const { disciplina } = Astro.props;
const documentos = disciplina.documentos ?? [];
---

<LayoutCompetencias titulo={`${disciplina.titulo} | ADADET`} footerDecoration={false} image={disciplina.imagenUrl.src}>
  
  <div class="relative min-h-screen bg-slate-50 flex flex-col">
    
    <section class="relative bg-slate-900 pt-24 pb-32 lg:pt-32 lg:pb-48 overflow-hidden">
        
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[120%] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-900/40 via-slate-900/0 to-slate-900/0"></div>
            <div class="absolute top-1/3 right-0 w-[600px] h-[600px] bg-cyan-500/10 rounded-full blur-[100px] translate-x-1/3"></div>
            <div class="absolute inset-0 opacity-[0.1]" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 40px 40px;"></div>
        </div>

        <div class="relative z-10 mx-auto max-w-7xl px-4">
            
            <a href="/#disciplinas" class="inline-flex items-center gap-2 text-sm font-bold text-slate-400 hover:text-cyan-400 transition-colors mb-12 group">
                <div class="p-1.5 rounded-full border border-slate-700 bg-slate-800/50 group-hover:border-cyan-500/50 transition-colors">
                    <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </div>
                <span>Volver a Disciplinas</span>
            </a>

            <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
                
                <div class="space-y-8 animate-fade-in-up">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-xs font-bold uppercase tracking-widest shadow-[0_0_15px_rgba(6,182,212,0.1)]">
                        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                        Disciplina Oficial
                    </div>
                    
                    <h1 class="text-5xl md:text-6xl lg:text-7xl font-black font-display text-white leading-tight tracking-tight drop-shadow-lg">
                        {disciplina.titulo}
                    </h1>
                    
                    <div class="relative">
                        <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-cyan-500 to-transparent"></div>
                        <p class="pl-6 text-lg md:text-xl leading-relaxed text-slate-300">
                            {disciplina.descripcion}
                        </p>
                    </div>
                </div>

                <div class="relative group perspective-1000 animate-fade-in-up" style="animation-delay: 200ms;">
                    <div class="absolute -inset-2 bg-gradient-to-tr from-cyan-500 to-blue-600 rounded-[2.5rem] blur-xl opacity-30 group-hover:opacity-50 transition-opacity duration-500"></div>
                    
                    <div class="relative aspect-[4/3] rounded-[2rem] overflow-hidden shadow-2xl shadow-black/50 border-4 border-slate-800/50 bg-slate-800 transform transition-transform duration-500 group-hover:rotate-1 group-hover:scale-[1.02]">
                        <Image
                            src={disciplina.imagenUrl} 
                            alt={disciplina.titulo}
                            class="h-full w-full object-cover opacity-90 group-hover:opacity-100 transition-opacity duration-700"
                            width={800}
                            loading="eager"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent"></div>
                        
                        <div class="absolute bottom-6 left-6 right-6">
                            <p class="text-white/80 text-xs font-bold uppercase tracking-widest mb-1">Temporada 2026</p>
                            <div class="h-1 w-16 bg-cyan-500 rounded-full shadow-[0_0_10px_rgba(6,182,212,0.8)]"></div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-[0] z-20">
            <svg class="relative block w-[calc(100%+1.3px)] h-[60px] md:h-[100px] text-slate-50" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
                <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" fill="currentColor"></path>
            </svg>
        </div>

    </section>

    <section class="relative bg-slate-50 pb-32 pt-20 flex-grow">
        
        <div class="relative z-10 mx-auto max-w-7xl px-4 animate-fade-in-up" style="animation-delay: 400ms;">
            
            <div class="bg-white rounded-3xl border border-slate-100 shadow-xl shadow-slate-200/50 p-8 md:p-12 -mt-20 relative z-30"> <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 border-b border-slate-100 pb-6">
                    <div>
                        <h2 class="text-3xl font-black font-display text-slate-900 mb-2 flex items-center gap-3">
                            <span class="p-2 bg-slate-100 rounded-lg text-slate-600">
                                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 011.414.586l4 4a1 1 0 01.586 1.414V19a2 2 0 01-2 2z" /></svg>
                            </span>
                            Documentación Técnica
                        </h2>
                        <p class="text-slate-500">
                            Reglamentos, normativas y rankings oficiales para {disciplina.titulo}.
                        </p>
                    </div>
                    {documentos.length > 0 && (
                        <span class="px-4 py-2 bg-slate-900 text-white text-sm font-bold rounded-lg shadow-md shadow-slate-900/20">
                            {documentos.length} Archivos Disponibles
                        </span>
                    )}
                </div>

                {documentos.length > 0 ? (
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {documentos.map((doc) => (
                    <a
                        href={`/documentos/${doc.slugDocumento}`}
                        class="group relative flex items-start gap-4 p-5 bg-slate-50 rounded-2xl border border-slate-200/60 transition-all duration-300 hover:bg-white hover:shadow-xl hover:shadow-cyan-500/10 hover:-translate-y-1 hover:border-cyan-200"
                    >
                        <div class="flex-shrink-0 w-12 h-12 bg-white text-cyan-600 rounded-xl border border-slate-200 flex items-center justify-center group-hover:bg-cyan-500 group-hover:text-white group-hover:border-cyan-500 transition-colors duration-300 shadow-sm">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 011.414.586l4 4a1 1 0 01.586 1.414V19a2 2 0 01-2 2z" /></svg>
                        </div>

                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-slate-700 text-sm group-hover:text-cyan-700 transition-colors mb-1 truncate pr-2">
                                {doc.etiqueta}
                            </h3>
                            <div class="flex items-center gap-2 text-[10px] font-bold text-slate-400 uppercase tracking-wide">
                                <span class="bg-slate-200/50 px-1.5 py-0.5 rounded text-slate-500">PDF</span>
                                <span>Descargar</span>
                            </div>
                        </div>
                        
                        <div class="opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 text-cyan-500 self-center">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                        </div>
                    </a>
                    ))}
                </div>
                ) : (
                <div class="flex flex-col items-center justify-center py-16 text-center border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50/50">
                        <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mb-4 text-slate-300">
                            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 011.414.586l4 4a1 1 0 01.586 1.414V19a2 2 0 01-2 2z" /></svg>
                        </div>
                        <p class="text-slate-500 font-medium">No hay documentos técnicos disponibles por el momento.</p>
                </div>
                )}

            </div>
        </div>

    </section>

    <div class="bg-slate-50 relative">
         <WaveDivider fillColor="#0f172a" />
    </div>

  </div>
</LayoutCompetencias>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }
</style>