---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import { BASE_DISCIPLINAS, type DisciplinaBase } from "../../data/disciplinas";

export function getStaticPaths() {
  return BASE_DISCIPLINAS.map((disciplina) => ({
    params: { slug: disciplina.slug },
    props: { disciplina },
  }));
}

interface Props {
  disciplina: DisciplinaBase;
}

const { disciplina } = Astro.props as Props;
const documentos = disciplina.documentos ?? [];
---

<LayoutCompetencias titulo={disciplina.titulo}>
  <section class="min-h-screen bg-[#f2f2f5]">
    <div class="mx-auto max-w-6xl px-4 py-10 md:py-14 space-y-10">
      <!-- Encabezado de la disciplina -->
      <header class="grid gap-8 md:grid-cols-[minmax(0,1.7fr)_minmax(0,1.3fr)] items-center">
        <div class="space-y-4">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-700">
            Disciplina ADADET
          </p>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900">
            {disciplina.titulo}
          </h1>
          <p class="text-sm md:text-base leading-relaxed text-slate-600">
            {disciplina.descripcion}
          </p>
        </div>
        <div class="relative h-56 md:h-64 overflow-hidden rounded-3xl bg-gradient-to-br from-blue-600 via-cyan-500 to-blue-700 shadow-md">
          <img
            src={disciplina.imagenUrl}
            alt={disciplina.titulo}
            loading="lazy"
            class="h-full w-full object-cover opacity-80 mix-blend-overlay"
          />
          <div class="absolute inset-0 bg-gradient-to-tr from-slate-900/40 via-transparent to-cyan-400/20"></div>
          <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-white">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-cyan-100">
                Asociación de Deportes Acuáticos del Estado Táchira
              </p>
              <p class="text-sm font-semibold">ADADET – {disciplina.titulo}</p>
            </div>
          </div>
        </div>
      </header>

      <!-- Documentos de la disciplina -->
      {documentos.length > 0 && (
        <section class="space-y-4">
          <div class="flex items-center gap-3">
            <div class="h-1 w-10 rounded-full bg-gradient-to-r from-cyan-600 to-blue-600"></div>
            <h2 class="text-xl md:text-2xl font-bold text-slate-900">
              Documentación específica de la disciplina
            </h2>
          </div>
          <p class="text-sm md:text-base text-slate-600 max-w-2xl">
            Accede rápidamente a la normativa vigente, marcas mínimas, condiciones técnicas y rankings
            oficiales asociados a esta disciplina.
          </p>

          <div class="mt-4 flex flex-wrap gap-3">
            {documentos.map((doc) => (
              <a
                href={`/documentos/${doc.slugDocumento}`}
                class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-800 shadow-sm ring-1 ring-slate-200 transition-all duration-200 hover:-translate-y-0.5 hover:bg-gradient-to-r hover:from-cyan-600 hover:to-blue-700 hover:text-white hover:shadow-md hover:ring-cyan-400"
              >
                <span class="inline-flex h-2 w-2 rounded-full bg-cyan-500"></span>
                <span>{doc.etiqueta}</span>
                <svg
                  class="h-4 w-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ))}
          </div>
        </section>
      )}

      {documentos.length === 0 && (
        <p class="mt-6 text-sm text-slate-500">
          Próximamente se publicará la documentación específica de esta disciplina.
        </p>
      )}
    </div>
  </section>
</LayoutCompetencias>
