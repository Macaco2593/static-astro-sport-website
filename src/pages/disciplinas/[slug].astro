---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import { BASE_DISCIPLINAS, type DisciplinaBase } from "../../data/disciplinas";
import { Image } from "astro:assets";
// 1. Importamos tu nuevo componente reutilizable
import WaveDivider from "../../components/UI/WaveDivider.astro";

export function getStaticPaths() {
  return BASE_DISCIPLINAS.map((disciplina) => ({
    params: { slug: disciplina.slug },
    props: { disciplina },
  }));
}

interface Props {
  disciplina: DisciplinaBase;
}

const { disciplina } = Astro.props;
const documentos = disciplina.documentos ?? [];
---

<LayoutCompetencias titulo={`${disciplina.titulo} | ADADET`} footerDecoration={false}>
  
  <section class="relative min-h-screen bg-slate-50 overflow-hidden">
    
    <div class="absolute inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0 opacity-[0.4]" 
             style="background-image: radial-gradient(#94a3b8 1px, transparent 1px); background-size: 32px 32px;">
        </div>
        
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-cyan-400/20 rounded-full blur-[120px] -translate-y-1/2 translate-x-1/3"></div>
        <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[100px] translate-y-1/3 -translate-x-1/3"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 py-12 md:py-20 space-y-16 pb-32"> <a href="/#disciplinas" class="group inline-flex items-center gap-2 text-sm font-bold text-slate-500 hover:text-adadet-main transition-colors">
        <div class="p-2 bg-white/80 backdrop-blur-sm rounded-full shadow-sm border border-slate-200 group-hover:border-adadet-main/30 transition-colors">
            <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </div>
        Volver a Disciplinas
      </a>

      <header class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        
        <div class="space-y-8 animate-fade-in-up">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/60 backdrop-blur-md border border-slate-200 text-adadet-main text-xs font-bold uppercase tracking-widest shadow-sm">
            <span class="w-2 h-2 rounded-full bg-adadet-main animate-pulse"></span>
            Disciplina Oficial
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black font-display text-slate-900 leading-tight drop-shadow-sm">
            {disciplina.titulo}
          </h1>
          
          <p class="text-lg leading-relaxed text-slate-600 border-l-4 border-adadet-main/50 pl-6 bg-gradient-to-r from-white/50 to-transparent py-2">
            {disciplina.descripcion}
          </p>
        </div>

        <div class="relative group perspective-1000 animate-fade-in-up" style="animation-delay: 200ms;">
             <div class="absolute -inset-1 bg-gradient-to-tr from-adadet-main to-cyan-300 rounded-[2.5rem] blur opacity-30 group-hover:opacity-50 transition-opacity duration-500"></div>
             
             <div class="relative aspect-[4/3] rounded-[2rem] overflow-hidden shadow-2xl border-4 border-white transform transition-transform duration-500 group-hover:rotate-1 bg-white">
                <Image
                    src={disciplina.imagenUrl} 
                    alt={disciplina.titulo}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                    width={800}
                    loading="eager"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 via-transparent to-transparent"></div>
                <div class="absolute bottom-6 left-6 right-6">
                     <p class="text-white/90 text-xs font-bold uppercase tracking-widest mb-1 shadow-black/20 drop-shadow-md">ADADET 2026</p>
                     <div class="h-1 w-12 bg-white rounded-full shadow-[0_0_10px_rgba(255,255,255,0.5)]"></div>
                </div>
             </div>
        </div>

      </header>

      <div class="relative bg-white/60 backdrop-blur-md rounded-3xl border border-white/60 shadow-xl shadow-slate-200/50 p-8 md:p-12 animate-fade-in-up" style="animation-delay: 400ms;">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
            <div>
                <h2 class="text-3xl font-black font-display text-slate-900 mb-2">
                    Documentación Técnica
                </h2>
                <p class="text-slate-500 max-w-2xl">
                    Descarga los reglamentos y rankings vigentes.
                </p>
            </div>
            {documentos.length > 0 && (
                <span class="px-4 py-2 bg-white text-slate-600 text-sm font-bold rounded-lg border border-slate-200 shadow-sm">
                    {documentos.length} Archivos
                </span>
            )}
        </div>

        {documentos.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {documentos.map((doc) => (
              <a
                href={`/documentos/${doc.slugDocumento}`}
                class="group relative flex items-start gap-4 p-5 bg-white rounded-2xl border border-slate-100 shadow-sm transition-all duration-300 hover:shadow-xl hover:shadow-adadet-main/10 hover:-translate-y-1 hover:border-adadet-main/30"
              >
                 <div class="flex-shrink-0 w-12 h-12 bg-slate-50 text-adadet-main rounded-xl flex items-center justify-center group-hover:bg-adadet-main group-hover:text-white transition-colors duration-300">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 011.414.586l4 4a1 1 0 01.586 1.414V19a2 2 0 01-2 2z" /></svg>
                 </div>

                 <div class="flex-1">
                    <h3 class="font-bold text-slate-800 group-hover:text-adadet-main transition-colors mb-1">
                        {doc.etiqueta}
                    </h3>
                    <div class="flex items-center gap-2 text-[10px] font-bold text-slate-400 uppercase tracking-wide">
                        <span class="bg-slate-100 px-1.5 py-0.5 rounded">PDF</span>
                        <span>Oficial</span>
                    </div>
                 </div>
              </a>
            ))}
          </div>
        ) : (
           <div class="flex flex-col items-center justify-center py-12 text-center">
                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mb-4 text-slate-300">
                    <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
                </div>
                <p class="text-slate-500 font-medium">No hay documentos cargados aún.</p>
           </div>
        )}

      </div>
    </div>

    <WaveDivider fillColor="#0f172a" />

  </section>
</LayoutCompetencias>

<style>
  /* Solo necesitamos las animaciones de entrada, las olas ya están en el componente */
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }
</style>