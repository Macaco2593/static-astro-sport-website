---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import { ALBUMES } from "src/data/albums";
import WaveDivider from "src/components/UI/WaveDivider.astro";
import { Image, getImage } from "astro:assets";


export function getStaticPaths() {
  const albumesInternos = ALBUMES.filter(album => !album.linkExterno);
  return albumesInternos.map((album) => ({
    params: { id: album.id },
    props: { album },
  }));
}

const { album } = Astro.props;

---

<LayoutCompetencias titulo={`${album.titulo} | Galería`} footerDecoration={false} image={album.cover}>
  
  <div class="bg-slate-50 min-h-screen relative">

    <div class="bg-slate-900 pt-32 pb-20 relative overflow-hidden">
        <div class="absolute inset-0 opacity-20 bg-[url('/grid-pattern.svg')]"></div>
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-600/20 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="relative z-10 mx-auto max-w-7xl px-4">
            
            <a href="/galeria" class="inline-flex items-center gap-2 text-sm font-bold text-slate-400 hover:text-cyan-400 transition-colors mb-8 group">
                <div class="p-1.5 rounded-full border border-slate-700 bg-slate-800/50 group-hover:border-cyan-500/50 transition-colors">
                    <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </div>
                Volver a la Galería
            </a>

            <div class="max-w-4xl">
                <div class="flex flex-wrap gap-2 mb-4">
                    {album.etiquetas.map(tag => (
                        <span class="px-2.5 py-1 rounded-md bg-white/10 backdrop-blur-sm border border-white/10 text-xs font-bold text-cyan-300 uppercase tracking-wide">
                            {tag}
                        </span>
                    ))}
                </div>
                
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-black font-display text-white mb-4 leading-tight">
                    {album.titulo}
                </h1>
                
                <p class="text-lg text-slate-400 max-w-2xl leading-relaxed flex items-center gap-4">
                    <span class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-adadet-main" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        {album.fecha}
                    </span>
                    <span class="w-1 h-1 rounded-full bg-slate-600"></span>
                    <span>{album.ubicación}</span>
                </p>
            </div>
        </div>
    </div>

    <div class="relative z-20 mx-auto max-w-7xl px-4 -mt-10 pb-20">
        
        <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
            
            {/* 2. CORRECCIÓN: Volvemos a usar album.fotos normal */}
            {album.fotos.map((foto, index) => (
                <div 
                    class="break-inside-avoid relative group rounded-2xl overflow-hidden shadow-md border border-slate-200 bg-white hover:shadow-xl transition-all duration-300 animate-fade-in-up flex flex-col"
                    style={`animation-delay: ${index * 50}ms`}
                >
                    <div 
                        class="relative cursor-zoom-in overflow-hidden"
                        onclick={`openLightbox('${foto.src}', '${foto.alt || ''}')`}
                    >
                        <Image 
                            src={foto.src} 
                            alt={foto.alt || album.titulo}
                            inferSize={true}
                            class="w-full h-auto object-cover transform transition-transform duration-700 group-hover:scale-105"
                            loading="lazy"
                        />
                        <div class="absolute inset-0 bg-slate-900/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    </div>

                    <div class="p-4 flex items-center justify-between bg-white relative z-10 border-t border-slate-50">
                        <p class="text-slate-500 text-sm font-medium truncate pr-4">
                            {foto.alt || "Foto de la galería"}
                        </p>
                        
                        <a 
                            href={`${foto.src}?download=ADADET-${album.titulo.replace(/\s+/g, '-')}-${index + 1}.jpg`}
                            class="shrink-0 flex items-center gap-1.5 px-4 py-2 bg-slate-100 hover:bg-cyan-50 text-slate-700 hover:text-cyan-700 text-xs font-bold uppercase tracking-wide rounded-lg transition-colors border border-slate-200 hover:border-cyan-200"
                            title="Descargar en formato JPG"
                        >
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                            Descargar
                        </a>
                    </div>
                </div>
            ))}

        </div>

    </div>
    {/* 🌟 Ajustamos el z-index a 9999 para que pase por encima del Navbar */}
    <div id="lightbox" class="fixed inset-0 z-[9999] hidden">
    
        <div class="absolute inset-0 bg-black/90 backdrop-blur-sm cursor-pointer" onclick="closeLightbox()"></div>

        <div class="relative z-[10000] flex flex-col items-center justify-center w-full h-full p-4 pointer-events-none">
            
            <button onclick="closeLightbox()" class="absolute top-4 right-4 text-white/70 hover:text-white p-2 pointer-events-auto transition-colors">
                <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>

            <img 
                id="lightbox-img" 
                src="" 
                alt="" 
                class="max-h-[85vh] max-w-[95vw] rounded-lg shadow-2xl object-contain pointer-events-auto transition-transform duration-300 scale-95 opacity-0" 
            />
            
            <p id="lightbox-caption" class="mt-4 text-center text-white/90 text-sm font-medium tracking-wide pointer-events-auto"></p>
        </div>
    </div>

    <div class="relative pt-10">
         <WaveDivider fillColor="#0f172a" />
    </div>

  </div>
</LayoutCompetencias>

<script is:inline>
document.addEventListener('astro:page-load', () => {    
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxCaption = document.getElementById('lightbox-caption');

    window.openLightbox = (src, alt) => {
        lightboxImg.src = src;
        lightboxCaption.innerText = alt;
        
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        setTimeout(() => {
            lightboxImg.classList.remove('scale-95', 'opacity-0');
            lightboxImg.classList.add('scale-100', 'opacity-100');
        }, 10);
    };

    window.closeLightbox = () => {
        lightboxImg.classList.remove('scale-100', 'opacity-100');
        lightboxImg.classList.add('scale-95', 'opacity-0');
        
        setTimeout(() => {
            lightbox.classList.add('hidden');
            lightboxImg.src = ''; 
            document.body.style.overflow = ''; 
        }, 300);
    };

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
    });

})
</script>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.6s ease-out forwards;
  }
</style>