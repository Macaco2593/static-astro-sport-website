---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import RANKING_DATA from "../../data/generated-ranking.json"; 

export function getStaticPaths() {
  return RANKING_DATA.categorias.map((cat) => ({
    params: { categoria: cat.id }, 
    props: { categoriaData: cat },
  }));
}

const { categoriaData } = Astro.props;
const pageDescription = `Consulta el ranking oficial de la categoría ${categoriaData.titulo} para la temporada 2026. Descubre a los mejores atletas y clubes en cada prueba de los deportes acuáticos en Táchira.`;

// Función para renderizar medallas
const getRankIcon = (index: number) => {
    if (index === 0) return `<span class="text-xl drop-shadow-sm" title="Oro">🥇</span>`;
    if (index === 1) return `<span class="text-xl drop-shadow-sm" title="Plata">🥈</span>`;
    if (index === 2) return `<span class="text-xl drop-shadow-sm" title="Bronce">🥉</span>`;
    return `<span class="font-bold text-slate-400 font-mono w-6 text-center inline-block">${index + 1}</span>`;
};
---

<LayoutCompetencias titulo={`Ranking ${categoriaData.titulo} | ADADET`} descripcion={pageDescription}>
  
  <div class="bg-slate-50 min-h-screen">
    
    <header class="relative bg-slate-900 py-16 px-4 overflow-hidden mb-12 shadow-xl">
        <div class="absolute inset-0 opacity-20 pointer-events-none">
            <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-500 rounded-full blur-3xl opacity-30"></div>
            <div class="absolute bottom-0 left-0 w-full h-full bg-gradient-to-t from-slate-900 via-transparent to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-6xl mx-auto">
            <a href="/ranking" class="inline-flex items-center gap-2 text-cyan-400 hover:text-white mb-6 text-sm font-bold uppercase tracking-wider transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                Volver a Categorías
            </a>

            <h1 class="text-4xl md:text-6xl font-black font-display text-white tracking-tight mb-2">
                {categoriaData.titulo}
            </h1>
            <p class="text-xl text-slate-400 font-medium">
                {categoriaData.edades} • Temporada Oficial 2026
            </p>
        </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 pb-20 space-y-12">

      {/* RECORREMOS CADA PRUEBA */}
      {categoriaData.pruebas.map((prueba, index) => (
        <article class="bg-white rounded-2xl shadow-lg shadow-slate-200/50 border border-slate-100 overflow-hidden">
          
          {/* Título de la Prueba */}
          <div class="bg-slate-50 px-6 py-5 border-b border-slate-200">
            <div class="flex items-center gap-3">
                <div class="bg-adadet-main text-white font-bold px-3 py-1 rounded text-sm shadow-sm">
                    {index + 1}
                </div>
                <h2 class="text-xl md:text-2xl font-black font-display text-slate-800 uppercase tracking-wide">
                  {prueba.nombre}
                </h2>
            </div>
          </div>

          <div class="grid lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-100 items-start">
            
            {/* --- RAMA FEMENINA --- */}
            <div class="relative flex flex-col">
               <div class="bg-pink-50/50 border-b border-pink-100 py-2 text-center">
                   <span class="text-pink-600 font-black uppercase text-sm tracking-widest">Femenino</span>
               </div>
               
               <div class="overflow-x-auto">
                   <table class="w-full text-sm text-left">
                     <thead class="bg-white text-slate-400 text-xs uppercase tracking-wider border-b border-slate-100">
                       <tr>
                         <th class="px-4 py-3 w-14 text-center">#</th>
                         <th class="px-4 py-3">Atleta / Club</th>
                         <th class="px-4 py-3 text-right">Marca</th>
                         <th class="px-4 py-3 text-right hidden sm:table-cell w-1/3">Evento</th>
                       </tr>
                     </thead>
                     <tbody class="divide-y divide-slate-50">
                       {prueba.femenino.length > 0 ? (
                           prueba.femenino.map((atleta, idx) => (
                             <tr class="hover:bg-slate-50 transition-colors group">
                               <td class="px-2 py-3 text-center align-middle" set:html={getRankIcon(idx)}></td>
                               
                               <td class="px-4 py-3 align-middle">
                                 <div class="font-bold text-slate-800 group-hover:text-pink-600 transition-colors">
                                     {atleta.nombre} 
                                     {/* AQUÍ SE AÑADE LA EDAD DE LA ATLETA */}
                                     {atleta.edad && <span class="font-normal text-slate-500 ml-1 text-xs">({atleta.edad} años)</span>}
                                 </div>
                                 <div class="text-xs font-semibold text-slate-500 bg-slate-100 inline-block px-1.5 rounded mt-0.5">{atleta.club}</div>
                               </td>
                               
                               <td class="px-4 py-3 text-right align-middle">
                                 <span class="font-mono font-bold text-base md:text-lg text-slate-800 bg-slate-50 px-2 py-0.5 rounded border border-slate-100 group-hover:border-pink-200 group-hover:bg-pink-50 transition-colors whitespace-nowrap">
                                    {atleta.marca.tiempoTexto}
                                 </span>
                               </td>
                               
                               <td class="px-4 py-3 text-right align-middle text-xs text-slate-500 hidden sm:table-cell">
                                 <div class="leading-tight font-medium text-slate-600 mb-1">{atleta.marca.competencia}</div>
                                 <div class="font-mono text-[10px] text-slate-400">{atleta.marca.fecha}</div>
                               </td>
                             </tr>
                           ))
                       ) : (
                           <tr>
                               <td colspan="4" class="px-6 py-6 text-center">
                                   <p class="text-slate-400 italic text-sm">Sin registros</p>
                               </td>
                           </tr>
                       )}
                     </tbody>
                   </table>
               </div>
            </div>

            {/* --- RAMA MASCULINA --- */}
            <div class="relative flex flex-col">
                <div class="bg-blue-50/50 border-b border-blue-100 py-2 text-center">
                    <span class="text-blue-600 font-black uppercase text-sm tracking-widest">Masculino</span>
                </div>
               
               <div class="overflow-x-auto">
                   <table class="w-full text-sm text-left">
                     <thead class="bg-white text-slate-400 text-xs uppercase tracking-wider border-b border-slate-100">
                       <tr>
                         <th class="px-4 py-3 w-14 text-center">#</th>
                         <th class="px-4 py-3">Atleta / Club</th>
                         <th class="px-4 py-3 text-right">Marca</th>
                         <th class="px-4 py-3 text-right hidden sm:table-cell w-1/3">Evento</th>
                       </tr>
                     </thead>
                     <tbody class="divide-y divide-slate-50">
                       {prueba.masculino.length > 0 ? (
                           prueba.masculino.map((atleta, idx) => (
                             <tr class="hover:bg-slate-50 transition-colors group">
                               <td class="px-2 py-3 text-center align-middle" set:html={getRankIcon(idx)}></td>
                               
                               <td class="px-4 py-3 align-middle">
                                 <div class="font-bold text-slate-800 group-hover:text-blue-600 transition-colors">
                                     {atleta.nombre}
                                     {/* AQUÍ SE AÑADE LA EDAD DEL ATLETA */}
                                     {atleta.edad && <span class="font-normal text-slate-500 ml-1 text-xs">({atleta.edad} años)</span>}
                                 </div>
                                 <div class="text-xs font-semibold text-slate-500 bg-slate-100 inline-block px-1.5 rounded mt-0.5">{atleta.club}</div>
                               </td>
                               
                               <td class="px-4 py-3 text-right align-middle">
                                 <span class="font-mono font-bold text-base md:text-lg text-slate-800 bg-slate-50 px-2 py-0.5 rounded border border-slate-100 group-hover:border-blue-200 group-hover:bg-blue-50 transition-colors whitespace-nowrap">
                                    {atleta.marca.tiempoTexto}
                                 </span>
                               </td>
                               
                               <td class="px-4 py-3 text-right align-middle text-xs text-slate-500 hidden sm:table-cell">
                                 <div class="leading-tight font-medium text-slate-600 mb-1">{atleta.marca.competencia}</div>
                                 <div class="font-mono text-[10px] text-slate-400">{atleta.marca.fecha}</div>
                               </td>
                             </tr>
                           ))
                       ) : (
                           <tr>
                               <td colspan="4" class="px-6 py-6 text-center">
                                   <p class="text-slate-400 italic text-sm">Sin registros</p>
                               </td>
                           </tr>
                       )}
                     </tbody>
                   </table>
               </div>
            </div>

          </div>
        </article>
      ))}
    </div>
  </div>
</LayoutCompetencias>