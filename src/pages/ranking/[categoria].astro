---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import RANKING_DATA from "../../data/generated-ranking.json"; 

export function getStaticPaths() {
  return RANKING_DATA.categorias.map((cat) => ({
    params: { categoria: cat.id }, 
    props: { categoriaData: cat },
  }));
}

const { categoriaData } = Astro.props;
const pageDescription = `Consulta el ranking oficial de la categoría ${categoriaData.titulo} para la temporada 2026. Descubre a los mejores atletas y clubes en cada prueba de los deportes acuáticos en Táchira.`;

// Función para renderizar medallas
const getRankIcon = (index: number) => {
    if (index === 0) return `<span class="text-xl drop-shadow-sm" title="Oro">🥇</span>`;
    if (index === 1) return `<span class="text-xl drop-shadow-sm" title="Plata">🥈</span>`;
    if (index === 2) return `<span class="text-xl drop-shadow-sm" title="Bronce">🥉</span>`;
    return `<span class="font-bold text-slate-400 font-mono w-6 text-center inline-block">${index + 1}</span>`;
};
---

<LayoutCompetencias titulo={`Ranking ${categoriaData.titulo} | ADADET`} descripcion={pageDescription}>
  
  <div class="bg-slate-50 min-h-screen relative overflow-x-hidden">
    
    <header class="relative bg-slate-900 py-16 px-4 shadow-xl">
        <div class="absolute inset-0 opacity-20 pointer-events-none">
            <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-500 rounded-full blur-3xl opacity-30"></div>
            <div class="absolute bottom-0 left-0 w-full h-full bg-gradient-to-t from-slate-900 via-transparent to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-6xl mx-auto">
            <a href="/ranking" class="inline-flex items-center gap-2 text-cyan-400 hover:text-white mb-6 text-sm font-bold uppercase tracking-wider transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                Volver a Categorías
            </a>

            <h1 class="text-4xl md:text-6xl font-black font-display text-white tracking-tight mb-2">
                {categoriaData.titulo}
            </h1>
            <p class="text-xl text-slate-400 font-medium">
                {categoriaData.edades} • Temporada Oficial 2026
            </p>
        </div>
    </header>

    {/* NAVEGACIÓN STICKY DE EVENTOS (Selector mejorado) */}
    <nav class="sticky top-0 z-40 bg-slate-50/90 backdrop-blur-md border-b border-slate-200 py-3 mb-8 shadow-sm">
        <div class="relative max-w-7xl mx-auto px-4">
            
            {/* Indicador Izquierdo */}
            <div id="scroll-left-hint" class="absolute left-0 top-0 bottom-0 w-12 bg-gradient-to-r from-slate-50 via-slate-50/90 to-transparent flex items-center justify-start pl-2 z-10 opacity-0 transition-opacity duration-300 pointer-events-none">
                <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
            </div>

            {/* Contenedor scrolleable (Agregamos cursor-grab y select-none) */}
            <div id="pruebas-scroll-container" class="flex gap-2 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden items-center snap-x relative z-0 px-2 cursor-grab active:cursor-grabbing select-none">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-widest mr-2 flex-shrink-0">Pruebas:</span>
                {categoriaData.pruebas.map((prueba, index) => (
                    <a 
                        href={`#prueba-${index}`} 
                        draggable="false" 
                        class="snap-start flex-shrink-0 px-4 py-2 bg-white border border-slate-200 hover:border-cyan-400 hover:bg-cyan-50 text-slate-600 hover:text-cyan-700 text-sm font-bold rounded-full whitespace-nowrap transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2"
                    >
                        {prueba.nombre}
                    </a>
                ))}
            </div>

            {/* Indicador Derecho */}
            <div id="scroll-right-hint" class="absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-slate-50 via-slate-50/90 to-transparent flex items-center justify-end pr-2 z-10 transition-opacity duration-300 pointer-events-none">
                <svg class="w-5 h-5 text-slate-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
            </div>

        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 pb-20 space-y-12">

      {/* RECORREMOS CADA PRUEBA */}
      {categoriaData.pruebas.map((prueba, index) => (

        <article id={`prueba-${index}`} class="bg-white rounded-2xl shadow-lg shadow-slate-200/50 border border-slate-100 overflow-hidden">
          
          {/* Título de la Prueba */}
          <div class="bg-slate-50 px-6 py-5 border-b border-slate-200">
            <div class="flex items-center gap-3">
                <div class="bg-adadet-main text-white font-bold px-3 py-1 rounded text-sm shadow-sm">
                    {index + 1}
                </div>
                <h2 class="text-xl md:text-2xl font-black font-display text-slate-800 uppercase tracking-wide">
                  {prueba.nombre}
                </h2>
            </div>
          </div>

          <div class="grid lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-slate-100 items-start">
            
            {/* --- RAMA FEMENINA --- */}
            <div class="relative flex flex-col">
               <div class="bg-pink-50/50 border-b border-pink-100 py-2 text-center">
                   <span class="text-pink-600 font-black uppercase text-sm tracking-widest">Femenino</span>
               </div>
               
               <div class="overflow-x-auto">
                   <table class="w-full text-sm text-left">
                     <thead class="bg-white text-slate-400 text-xs uppercase tracking-wider border-b border-slate-100">
                       <tr>
                         <th class="px-4 py-3 w-14 text-center">#</th>
                         <th class="px-4 py-3">Atleta / Club</th>
                         <th class="px-4 py-3 text-right">Marca</th>
                         <th class="px-4 py-3 text-right hidden sm:table-cell w-1/3">Evento</th>
                       </tr>
                     </thead>
                     <tbody class="divide-y divide-slate-50">
                       {prueba.femenino.length > 0 ? (
                           prueba.femenino.map((atleta, idx) => (
                             <tr class="hover:bg-slate-50 transition-colors group">
                               <td class="px-2 py-3 text-center align-middle" set:html={getRankIcon(idx)}></td>
                               
                               <td class="px-4 py-3 align-middle">
                                 <div class="font-bold text-slate-800 group-hover:text-pink-600 transition-colors">
                                     {atleta.nombre} 
                                     {atleta.edad && <span class="font-normal text-slate-500 ml-1 text-xs">({atleta.edad} años)</span>}
                                 </div>
                                 <div class="text-xs font-semibold text-slate-500 bg-slate-100 inline-block px-1.5 rounded mt-0.5">{atleta.club}</div>
                                 
                                 <div class="sm:hidden mt-2 pt-1.5 border-t border-slate-100/60">
                                     <div class="leading-tight font-medium text-slate-600 text-xs mb-0.5">{atleta.marca.competencia}</div>
                                     <div class="font-mono text-[10px] text-slate-400">{atleta.marca.fecha}</div>
                                 </div>
                               </td>
                               
                               <td class="px-4 py-3 text-right align-middle">
                                 <span class="font-mono font-bold text-base md:text-lg text-slate-800 bg-slate-50 px-2 py-0.5 rounded border border-slate-100 group-hover:border-pink-200 group-hover:bg-pink-50 transition-colors whitespace-nowrap">
                                    {atleta.marca.tiempoTexto}
                                 </span>
                               </td>
                               
                               <td class="px-4 py-3 text-right align-middle text-xs text-slate-500 hidden sm:table-cell">
                                 <div class="leading-tight font-medium text-slate-600 mb-1">{atleta.marca.competencia}</div>
                                 <div class="font-mono text-[10px] text-slate-400">{atleta.marca.fecha}</div>
                               </td>
                             </tr>
                           ))
                       ) : (
                           <tr>
                               <td colspan="4" class="px-6 py-6 text-center">
                                   <p class="text-slate-400 italic text-sm">Sin registros</p>
                               </td>
                           </tr>
                       )}
                     </tbody>
                   </table>
               </div>
            </div>

            {/* --- RAMA MASCULINA --- */}
            <div class="relative flex flex-col">
                <div class="bg-blue-50/50 border-b border-blue-100 py-2 text-center">
                    <span class="text-blue-600 font-black uppercase text-sm tracking-widest">Masculino</span>
                </div>
               
               <div class="overflow-x-auto">
                   <table class="w-full text-sm text-left">
                     <thead class="bg-white text-slate-400 text-xs uppercase tracking-wider border-b border-slate-100">
                       <tr>
                         <th class="px-4 py-3 w-14 text-center">#</th>
                         <th class="px-4 py-3">Atleta / Club</th>
                         <th class="px-4 py-3 text-right">Marca</th>
                         <th class="px-4 py-3 text-right hidden sm:table-cell w-1/3">Evento</th>
                       </tr>
                     </thead>
                     <tbody class="divide-y divide-slate-50">
                       {prueba.masculino.length > 0 ? (
                           prueba.masculino.map((atleta, idx) => (
                             <tr class="hover:bg-slate-50 transition-colors group">
                               <td class="px-2 py-3 text-center align-middle" set:html={getRankIcon(idx)}></td>
                               
                               <td class="px-4 py-3 align-middle">
                                 <div class="font-bold text-slate-800 group-hover:text-blue-600 transition-colors">
                                     {atleta.nombre}
                                     {atleta.edad && <span class="font-normal text-slate-500 ml-1 text-xs">({atleta.edad} años)</span>}
                                 </div>
                                 <div class="text-xs font-semibold text-slate-500 bg-slate-100 inline-block px-1.5 rounded mt-0.5">{atleta.club}</div>

                                 <div class="sm:hidden mt-2 pt-1.5 border-t border-slate-100/60">
                                     <div class="leading-tight font-medium text-slate-600 text-xs mb-0.5">{atleta.marca.competencia}</div>
                                     <div class="font-mono text-[10px] text-slate-400">{atleta.marca.fecha}</div>
                                 </div>
                               </td>
                               
                               <td class="px-4 py-3 text-right align-middle">
                                 <span class="font-mono font-bold text-base md:text-lg text-slate-800 bg-slate-50 px-2 py-0.5 rounded border border-slate-100 group-hover:border-blue-200 group-hover:bg-blue-50 transition-colors whitespace-nowrap">
                                    {atleta.marca.tiempoTexto}
                                 </span>
                               </td>
                               
                               <td class="px-4 py-3 text-right align-middle text-xs text-slate-500 hidden sm:table-cell">
                                 <div class="leading-tight font-medium text-slate-600 mb-1">{atleta.marca.competencia}</div>
                                 <div class="font-mono text-[10px] text-slate-400">{atleta.marca.fecha}</div>
                               </td>
                             </tr>
                           ))
                       ) : (
                           <tr>
                               <td colspan="4" class="px-6 py-6 text-center">
                                   <p class="text-slate-400 italic text-sm">Sin registros</p>
                               </td>
                           </tr>
                       )}
                     </tbody>
                   </table>
               </div>
            </div>

          </div>
        </article>
      ))}
    </div>
    

  </div>
</LayoutCompetencias>

{/* SCRIPT CLIENT-SIDE PARA INTERACCIONES */}
<script>
  // Envolvemos todo directamente en astro:page-load sin usar DOMContentLoaded
  document.addEventListener('astro:page-load', () => {
        
        // 1. SCROLL EXACTO CALCULADO
        document.querySelectorAll('nav a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                if (targetId) {
                    const targetElement = document.querySelector(targetId);
                    if (targetElement) {
                        const topOffset = 90; 
                        
                        const elementPosition = targetElement.getBoundingClientRect().top;
                        const offsetPosition = elementPosition + window.scrollY - topOffset;

                        window.scrollTo({
                            top: offsetPosition,
                            behavior: "smooth"
                        });
                    }
                }
            });
        });

        // 2. INDICADORES DE DESLIZAMIENTO EN EL MENÚ (Flechas laterales)
        const scrollContainer = document.getElementById('pruebas-scroll-container');
        const leftHint = document.getElementById('scroll-left-hint');
        const rightHint = document.getElementById('scroll-right-hint');

        if (scrollContainer) {
            let isDown = false;
            let startX;
            let scrollLeft;
            let isDragging = false; 

            scrollContainer.addEventListener('mousedown', (e) => {
                isDown = true;
                isDragging = false; 
                startX = e.pageX - scrollContainer.offsetLeft;
                scrollLeft = scrollContainer.scrollLeft;
                
                scrollContainer.classList.remove('snap-x');
            });

            scrollContainer.addEventListener('mouseleave', () => {
                isDown = false;
                // Devolvemos el imán si el mouse sale del área
                scrollContainer.classList.add('snap-x');
            });

            scrollContainer.addEventListener('mouseup', () => {
                isDown = false;
                // Devolvemos el imán cuando suelta el clic
                scrollContainer.classList.add('snap-x');
            });

            scrollContainer.addEventListener('mousemove', (e) => {
                if (!isDown) return; 
                e.preventDefault();
                isDragging = true; 
                const x = e.pageX - scrollContainer.offsetLeft;
                
                // Puedes ajustar este multiplicador (1.5). 
                // Si lo subes a 2, se deslizará más rápido. Si lo bajas a 1, más lento.
                const walk = (x - startX) * 1.5; 
                scrollContainer.scrollLeft = scrollLeft - walk;
            });

            // Prevenir que el clic navegue si el usuario solo estaba arrastrando
            scrollContainer.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', (e) => {
                    if (isDragging) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                });
            });
        }

        if (scrollContainer && leftHint && rightHint) {
            const handleScroll = () => {
                if (scrollContainer.scrollLeft > 15) {
                    leftHint.classList.remove('opacity-0');
                } else {
                    leftHint.classList.add('opacity-0');
                }

                const maxScroll = scrollContainer.scrollWidth - scrollContainer.clientWidth;
                if (scrollContainer.scrollLeft >= maxScroll - 5) {
                    rightHint.classList.add('opacity-0');
                } else {
                    rightHint.classList.remove('opacity-0');
                }
            };

            // Removemos el listener si ya existía para evitar duplicados en Astro ViewTransitions
            scrollContainer.removeEventListener('scroll', handleScroll);
            scrollContainer.addEventListener('scroll', handleScroll);
            
            handleScroll();
            window.removeEventListener('resize', handleScroll);
            window.addEventListener('resize', handleScroll);
        }


  });
</script>