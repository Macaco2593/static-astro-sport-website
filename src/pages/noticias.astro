---
import LayoutCompetencias from "src/layouts/LayoutCompetencias.astro";
import NoticiaCard from "src/components/NoticiaCard.astro";
import { getCollection } from "astro:content";

const todasLasNoticias = await getCollection("noticias");
const noticiasOrdenadas = todasLasNoticias.sort(
  (a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf()
);

const pageTitle = "Sala de Prensa y Noticias | ADADET";
const pageDescription = "Mantente al día con las últimas novedades de la natación en Táchira. Resultados de competencias, logros de nuestros atletas y comunicados oficiales."
---

<LayoutCompetencias titulo={pageTitle} descripcion={pageDescription}>
  
  <div class="bg-slate-50 min-h-screen relative">

    <header class="relative bg-slate-900 pt-24 pb-32 px-4 text-center">
        <div class="absolute inset-0 opacity-20">
            <svg class="h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                <path d="M0 100 C 20 0 50 0 100 100 Z" fill="url(#gradiente)" />
                <defs>
                    <linearGradient id="gradiente" x1="0%" y1="0%" x2="100%" y2="0%">
                        <stop offset="0%" style="stop-color:#22d3ee;stop-opacity:1" />
                        <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:1" />
                    </linearGradient>
                </defs>
            </svg>
        </div>
        
        <div class="relative z-10 max-w-4xl mx-auto space-y-4">
            <span class="text-cyan-400 font-bold tracking-widest uppercase text-sm animate-fade-in">
                Comunicación Oficial
            </span>
            <h1 class="text-4xl md:text-6xl font-black text-white tracking-tight animate-fade-in delay-100">
                Sala de <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Prensa</span>
            </h1>
            <p class="text-slate-300 text-lg md:text-xl max-w-2xl mx-auto animate-fade-in delay-200">
                Entérate de los últimos resultados, comunicados oficiales, convocatorias y eventos de la natación tachirense.
            </p>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 -mt-20 pb-24 relative z-20">
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {noticiasOrdenadas.map((news, index) => {
                return (<NoticiaCard news={news} key={index} />)
            })}
        </div>
    </main>

  </div>
</LayoutCompetencias>

<style>
  /* Animaciones Simples */
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
    opacity: 0; /* Empieza invisible */
  }
  
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
    opacity: 0; /* Empieza invisible */
  }

  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
</style>