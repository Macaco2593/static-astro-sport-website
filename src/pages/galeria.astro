---
import LayoutCompetencias from "../layouts/LayoutCompetencias.astro";

const galleryImages = [
  {
    src: "/images/galeria-1.jpg",
    alt: "Competencia de natación ADADET",
  },
  {
    src: "/images/galeria-2.jpg",
    alt: "Entrenamiento en piscina",
  },
  {
    src: "/images/galeria-3.jpg",
    alt: "Equipo de atletas acuáticos",
  },
  {
    src: "/images/galeria-4.jpg",
    alt: "Ceremonia de premiación",
  },
  {
    src: "/images/galeria-5.jpg",
    alt: "Salida de competencia",
  },
  {
    src: "/images/galeria-6.jpg",
    alt: "Vista general de la piscina",
  },
  {
    src: "/images/galeria-7.jpg",
    alt: "Entrenamiento de relevo",
  },
  {
    src: "/images/galeria-8.jpg",
    alt: "Fotografía institucional",
  },
];
---

<LayoutCompetencias titulo="Galería ADADET">
  <section class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-cyan-50">
    <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
      <!-- encabezado -->
      <header class="mb-10 text-center">
        <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-cyan-700">
          Galería fotográfica
        </p>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900">
          Momentos de la familia ADADET
        </h1>
        <p class="mt-3 max-w-2xl mx-auto text-sm md:text-base text-slate-600">
          Recopilamos imágenes de competencias, entrenamientos y actividades institucionales para
          celebrar el esfuerzo, la disciplina y la pasión por los deportes acuáticos en el estado Táchira.
        </p>
      </header>

      <!-- cuadrícula de 4 columnas -->
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 md:gap-6">
        {galleryImages.map((image) => (
          <figure class="group relative overflow-hidden rounded-2xl bg-slate-900/5 shadow-md ring-1 ring-slate-100 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:ring-cyan-300">
            <div class="relative h-44 sm:h-48 lg:h-52 xl:h-56 overflow-hidden">
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent opacity-60"></div>
            </div>
            <figcaption class="px-3 pb-3 pt-2 text-xs font-medium text-slate-700">
              {image.alt}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</LayoutCompetencias>
