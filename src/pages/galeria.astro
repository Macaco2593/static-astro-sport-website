---
import LayoutCompetencias from "../layouts/LayoutCompetencias.astro";
import PageHero from "../components/UI/PageHero.astro";
import WaveDivider from "../components/UI/WaveDivider.astro";
import { ALBUMES } from "src/data/albums.ts";
import { ROUTES } from "src/data/routes.ts";
import { ADADET_INFO } from "src/data/adadet";
import { Image } from "astro:assets";

const pageTitle = "Galería Multimedia | ADADET";
const pageDescription = "Revive los mejores momentos de nuestras competencias. Fotos y videos de los eventos de natación, clavados y polo acuático en el estado Táchira."
---

<LayoutCompetencias titulo={pageTitle} descripcion={pageDescription} footerDecoration={false}>
  
  <div class="bg-slate-50 min-h-screen relative">

    <PageHero 
        title="Galería"
        gradientText="Multimedia"
        subtitle="Revive la emoción, el esfuerzo y la gloria de nuestros atletas. Una colección visual de la historia acuática tachirense."
        badge="Memoria Fotográfica"
    />

    <div class="relative z-20 mx-auto max-w-7xl px-4 -mt-20 pb-20">
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-24">
            {ALBUMES.map((album, index) => (
                <article 
                    class="group relative bg-white rounded-[2rem] shadow-xl shadow-slate-900/10 border border-slate-100 overflow-hidden hover:-translate-y-2 transition-all duration-500 animate-fade-in-up flex flex-col h-full"
                    style={`animation-delay: ${index * 100}ms`}
                >
                    <div class="relative h-64 overflow-hidden">
                        <div class="absolute inset-0 bg-slate-900/20 group-hover:bg-slate-900/10 transition-colors z-10"></div>
                        
                        <Image 
                            src={album.cover} 
                            alt={album.titulo}
                            inferSize={true}
                            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                            loading="lazy"
                        />
                        
                        <div class="absolute top-4 right-4 z-20">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-900/60 backdrop-blur-md text-white text-xs font-bold border border-white/20 shadow-sm">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                {album.cantidadFotos}
                            </span>
                        </div>

                        <div class="absolute bottom-4 left-4 z-20 flex gap-2">
                             {album.etiquetas.map(tag => (
                                <span class="px-2 py-1 rounded-md bg-white/90 backdrop-blur text-[10px] font-bold text-slate-700 uppercase tracking-wide">
                                    {tag}
                                </span>
                             ))}
                        </div>
                    </div>

                    <div class="p-6 pt-8 flex-1 flex flex-col relative">
                        <div class="flex items-center justify-between mb-3">
                            <p class="text-xs font-bold uppercase tracking-widest text-adadet-main">
                                {album.fecha}
                            </p>
                            <span class="text-xs font-medium text-slate-400 flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                {album.ubicación}
                            </span>
                        </div>
                        
                        <h3 class="text-xl font-black font-display text-slate-900 mb-4 leading-tight group-hover:text-cyan-600 transition-colors">
                            {album.titulo}
                        </h3>

                        <a 
                            href={ROUTES.galeria_album(album.id)}
                            target="_blank"
                            class="mt-auto w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl bg-slate-50 text-slate-700 text-sm font-bold transition-all duration-300 group-hover:bg-slate-900 group-hover:text-white group-hover:shadow-lg"
                        >
                            Ver Álbum Completo
                            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                            </svg>
                        </a>
                    </div>
                </article>
            ))}
        </div>

        <div class="animate-fade-in-up" style="animation-delay: 300ms">
            <div class="relative overflow-hidden rounded-[2.5rem] bg-slate-900 px-6 py-12 md:px-12 md:py-16 text-center shadow-2xl shadow-cyan-900/20">
                
                <div class="absolute top-0 right-0 -mr-20 -mt-20 w-80 h-80 bg-cyan-500/20 rounded-full blur-[80px]"></div>
                <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 bg-blue-600/20 rounded-full blur-[80px]"></div>
                <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"></div>

                <div class="relative z-10 max-w-3xl mx-auto space-y-8">
                    <div class="inline-flex items-center justify-center p-3 bg-white/10 rounded-2xl backdrop-blur-sm mb-2">
                        <svg class="w-8 h-8 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    </div>

                    <h2 class="text-3xl md:text-4xl lg:text-5xl font-black font-display text-white tracking-tight">
                        ¿Tienes fotos del evento?
                    </h2>
                    
                    <p class="text-lg text-slate-300 leading-relaxed max-w-2xl mx-auto">
                        Ayúdanos a preservar la historia. Si capturaste momentos increíbles, compártelos con nosotros para que formen parte de la galería oficial de ADADET.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
                        <button 
                            id="btn-copy-email"
                            data-email={ADADET_INFO.correo}
                            class="group relative inline-flex items-center gap-3 px-8 py-4 bg-white text-slate-900 rounded-xl font-bold transition-all hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(255,255,255,0.3)] w-full sm:w-auto justify-center cursor-pointer active:scale-95"
                        >
                            <svg id="icon-mail" class="w-5 h-5 text-adadet-main transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                            <svg id="icon-check" class="hidden w-5 h-5 text-green-500 transition-all scale-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                            
                            <span id="text-email">Copiar Correo</span>
                        </button>
                        
                        <a 
                            href={`https://wa.me/${ADADET_INFO.numero.replace(/[^0-9]/g, '')}`} 
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group relative inline-flex items-center gap-3 px-8 py-4 bg-[#25D366] text-white rounded-xl font-bold transition-transform hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(37,211,102,0.4)] w-full sm:w-auto justify-center"
                        >
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                            Enviar a WhatsApp
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

<script is:inline>
    const btnCopy = document.getElementById('btn-copy-email');
    const textEmail = document.getElementById('text-email');
    const iconMail = document.getElementById('icon-mail');
    const iconCheck = document.getElementById('icon-check');

    btnCopy.addEventListener('click', () => {
        const email = btnCopy.getAttribute('data-email');
        
        // Copiar al portapapeles
        navigator.clipboard.writeText(email).then(() => {
            // Feedback Visual
            const originalText = textEmail.innerText;
            textEmail.innerText = "¡Copiado!";
            textEmail.classList.add('text-green-600');
            
            // Cambiar icono
            iconMail.classList.add('hidden');
            iconCheck.classList.remove('hidden', 'scale-0');
            iconCheck.classList.add('scale-100');

            // Restaurar después de 2 segundos
            setTimeout(() => {
                textEmail.innerText = originalText;
                textEmail.classList.remove('text-green-600');
                
                iconMail.classList.remove('hidden');
                iconCheck.classList.add('hidden', 'scale-0');
                iconCheck.classList.remove('scale-100');
            }, 2000);
        });
    });
</script>

    <div class="relative pt-10">
         <WaveDivider fillColor="#0f172a" />
    </div>

  </div>
</LayoutCompetencias>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }
</style>